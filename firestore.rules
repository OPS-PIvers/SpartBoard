rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the caller's email has an /admins/{email} doc.
    // token.get('email','') (not direct .email) avoids a CEL "undefined" throw on
    // tokens with no email claim (anon PIN) - load-bearing because isAdmin() runs
    // before the anon-student branch in the quiz-response update OR chain.
    // email_verified is REQUIRED: email/password sign-in is also enabled, so an
    // unverified self-reported email could otherwise be forged to an admin's address
    // to claim the /admins doc. Matches aiGeneration.ts / resolveOrgForUser.ts.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.get('email', '') != '' &&
             request.auth.token.get('email_verified', false) == true &&
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // A signed-in district address, verified. email_verified is required because
    // email/password sign-in is enabled, so an unverified self-reported address
    // could otherwise claim an @orono one. Written once for the substitute and
    // shared-board read rules that all gate on it.
    function isVerifiedDistrictEmail() {
      return request.auth.token.get('email_verified', false) == true &&
             request.auth.token.get('email', '').lower().matches('^[^@]+@orono[.]k12[.]mn[.]us$');
    }

    // ---- Optional-field type guards ----
    // optX(d, 'k') is exactly `!('k' in d) || d.k is X`, written once instead of
    // inline at every callsite. Firestore caps the COMPILED ruleset at 250 KB,
    // separately from the 256 KB source cap, and this file crossed it on
    // 2026-09-21; every release was then refused with a bare INVALID_ARGUMENT.
    function optString(d, k) { return !(k in d) || d[k] is string; }
    function optMap(d, k) { return !(k in d) || d[k] is map; }
    function optList(d, k) { return !(k in d) || d[k] is list; }
    function optInt(d, k) { return !(k in d) || d[k] is int; }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function optNumber(d, k) { return !(k in d) || d[k] is number; }
    // The 200-character form used across the activity-wall item validators.
    function optShortString(d, k) {
      return !(k in d) || (d[k] is string && d[k].size() <= 200);
    }

    // ---- Student (GIS/ClassLink) auth helpers ----
    // GIS students sign in via studentLoginV1 custom tokens carrying
    // `studentRole: true` + a `classIds` list of their ClassLink sections.
    // These gate student-role access to their own classes without touching any
    // other auth path (teachers, admins, anon PIN students).

    // token.get('studentRole', false) (not direct access): the engine throws on
    // a missing claim (anon PIN tokens) even behind a != null guard, which would
    // make every passesStudentClassGate() callsite deny anon PIN students.
    function isStudentRoleUser() {
      return request.auth != null && request.auth.token.get('studentRole', false) == true;
    }

    // True iff the caller is a studentRole user AND the given classId is in
    // their classIds custom claim. False if the claim is missing or the
    // classId is empty/unknown.
    function studentRoleCanAccessClass(classId) {
      return isStudentRoleUser() &&
             request.auth.token.classIds is list &&
             classId is string &&
             classId.size() > 0 &&
             classId in request.auth.token.classIds;
    }

    // Session gate: passes when the caller is NOT a studentRole user, the
    // session has no class targeting (empty/missing classId — open to any
    // studentRole holder with the PIN, which is the secret in that path), or the
    // session's classId is in their classIds claim.
    function passesStudentClassGate(sessionClassId) {
      return !isStudentRoleUser() ||
             !(sessionClassId is string) ||
             sessionClassId.size() == 0 ||
             studentRoleCanAccessClass(sessionClassId);
    }

    // List-aware variant (used by mini_app_sessions): passes for non-studentRole
    // users, for sessions with no class targeting (empty/missing list — open to
    // any studentRole user with the link), or when any session classId is in the
    // caller's classIds claim.
    function passesStudentClassGateList(sessionClassIds) {
      return !isStudentRoleUser() ||
             !(sessionClassIds is list) ||
             sessionClassIds.size() == 0 ||
             (request.auth.token.classIds is list &&
              sessionClassIds.hasAny(request.auth.token.classIds));
    }

    // M17 session close window for session data `s`. closeAt/openAt are
    // epoch-ms numbers (never Timestamps, whose comparison with a number would
    // silently always pass) and absent on pre-M17 sessions, where both gates
    // are no-ops. 120000 ms is the grace: the client auto-submits answered
    // work when closeAt passes mid-attempt (spec §3a-D), so that write lands
    // at or just after closeAt and a zero-tolerance gate would discard it.
    function beforeClose(s) {
      return s.get('closeAt', null) == null ||
             request.time.toMillis() < s.closeAt + 120000;
    }
    // M17 open window, the mirror of beforeClose with the same grace so a
    // student whose clock runs slightly ahead of openAt isn't bounced. Callers
    // gate CREATE only: an attempt that legitimately started must never be
    // bricked by the teacher moving openAt later.
    function afterOpen(s) {
      return s.get('openAt', null) == null ||
             request.time.toMillis() >= s.openAt - 120000;
    }

    // Phase 5A compat: post-5A sessions write a `classIds` list, pre-5A sessions
    // write a single `classId`. Picks the list gate when `classIds` is non-empty,
    // else the legacy single-class gate. Callers pass get(...) defaults so an
    // absent field falls through to a no-op gate.
    function passesStudentClassGateCompat(sessionClassIds, sessionClassId) {
      return sessionClassIds is list && sessionClassIds.size() > 0
             ? passesStudentClassGateList(sessionClassIds)
             : passesStudentClassGate(sessionClassId);
    }

    // `list` scoping for the session collections (video activity / guided
    // learning / mini app / activity wall). A list rule is evaluated ONCE
    // against the query with an EMPTY resource, so every clause
    // must be provable from the client's own filters — it is not a per-document
    // filter. The three disjuncts below name the only three query shapes the
    // app sends: the teacher's own where('teacherUid','==',uid), and the two
    // class shapes from hooks/useStudentAssignments.ts,
    // where('classIds','array-contains-any',ids) and where('classId','in',ids),
    // whose `ids` come straight from the caller's own classIds claim.
    // Read teacherUid through .get(): bare, it throws on a query that does not
    // filter on it, and CEL only absorbs that while a class disjunct proves true.
    // NEVER add a disjunct that needs no document (e.g. `|| isStudentRoleUser()`):
    // it is provable for every caller and silently re-opens the collection to
    // enumeration. Never put `is list` or `size()` on a resource-derived value
    // either: that makes the clause unprovable, so it can only ever be false.
    function sessionListScoped() {
      return resource.data.get('teacherUid', '') == request.auth.uid ||
             (request.auth.token.get('classIds', []) is list &&
              (resource.data.get('classIds', []).hasAny(request.auth.token.get('classIds', [])) ||
               resource.data.get('classId', '') in request.auth.token.get('classIds', [])));
    }

    // ---- Organization helpers (see docs/organization_wiring_implementation.md) ----

    // Super admins from EITHER source (LO2): legacy admin_settings/user_roles
    // .superAdmins[], OR an operator-org member doc with roleId == 'super_admin'.
    // Mirrors OrganizationPanel.resolveActorRole. roleId is read from the operator
    // org (`orono`) by fixed path - CEL cannot resolve the caller's org dynamically.
    // email_verified is REQUIRED, same reason as isAdmin() above.
    function isSuperAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.get('email_verified', false) == true &&
             (isLegacySuperAdmin() || isMemberSuperAdmin());
    }

    function isLegacySuperAdmin() {
      return get(/databases/$(database)/documents/admin_settings/user_roles) != null &&
             request.auth.token.email.lower() in
               get(/databases/$(database)/documents/admin_settings/user_roles).data.get('superAdmins', []);
    }

    function isMemberSuperAdmin() {
      return get(/databases/$(database)/documents/organizations/orono/members/$(request.auth.token.email.lower())) != null &&
             get(/databases/$(database)/documents/organizations/orono/members/$(request.auth.token.email.lower())).data.get('roleId', '') == 'super_admin';
    }

    // Returns the caller's /organizations/{orgId}/members/{email} doc data.
    // Callers must guard with isOrgMember(orgId) first; otherwise get() fails.
    function orgMember(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email.lower())).data;
    }

    // Maps a legacy long-form building id to its canonical short id. MUST stay in
    // sync with BUILDING_ID_ALIASES in config/buildings.ts (CEL can't reuse the JS
    // map) — a mismatch re-introduces false denials/grants in the building-admin
    // update rule. Unknown ids pass through unchanged.
    function canonicalBuildingId(id) {
      return id == 'orono-high-school' ? 'high'
           : id == 'orono-middle-school' ? 'middle'
           : id == 'orono-intermediate-school' ? 'intermediate'
           : id == 'schumann-elementary' ? 'schumann'
           : id;
    }

    // True when a building (identified in either ID format) is among the
    // caller's managed buildingIds, comparing on canonical ids so legacy
    // stored ids on either side still match. Both the building doc id and
    // each member buildingId are normalized before the membership check.
    function manages(orgId, buildingId) {
      return orgMember(orgId).get('buildingIds', [])
               .hasAny(buildingIdAliasGroup(buildingId));
    }

    // Returns all ID forms (canonical + any legacy aliases) equivalent to the
    // given building id, so hasAny() matches a member buildingId stored in
    // either format. Mirrors the inverse of canonicalBuildingId() above.
    function buildingIdAliasGroup(buildingId) {
      return canonicalBuildingId(buildingId) == 'high'
               ? ['high', 'orono-high-school']
           : canonicalBuildingId(buildingId) == 'middle'
               ? ['middle', 'orono-middle-school']
           : canonicalBuildingId(buildingId) == 'intermediate'
               ? ['intermediate', 'orono-intermediate-school']
           : canonicalBuildingId(buildingId) == 'schumann'
               ? ['schumann', 'schumann-elementary']
           : [buildingId];
    }

    // Alias-aware overlap of two building-id lists. CEL has no .map() to
    // canonicalize element-wise, so lists overlap if (a) they share a raw id, or
    // (b) for any alias group both lists contain some form of it (e.g. 'high' vs
    // 'orono-high-school'). Unknown ids match only via raw overlap. Symmetric.
    function buildingListsOverlap(a, b) {
      return a.hasAny(b) ||
        (a.hasAny(['high', 'orono-high-school']) &&
         b.hasAny(['high', 'orono-high-school'])) ||
        (a.hasAny(['middle', 'orono-middle-school']) &&
         b.hasAny(['middle', 'orono-middle-school'])) ||
        (a.hasAny(['intermediate', 'orono-intermediate-school']) &&
         b.hasAny(['intermediate', 'orono-intermediate-school'])) ||
        (a.hasAny(['schumann', 'schumann-elementary']) &&
         b.hasAny(['schumann', 'schumann-elementary']));
    }

    // The caller's roleId within an org, or empty string when not a member.
    function memberRole(orgId, emailLower) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(emailLower))
             ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(emailLower)).data.get('roleId', '')
             : '';
    }

    // email_verified is REQUIRED, same reason as isAdmin() above.
    function isDomainAdmin(orgId) {
      return request.auth != null && request.auth.token.email != null &&
             request.auth.token.get('email_verified', false) == true &&
             memberRole(orgId, request.auth.token.email.lower()) == 'domain_admin';
    }

    // email_verified is REQUIRED, same reason as isAdmin() above.
    function isBuildingAdmin(orgId) {
      return request.auth != null && request.auth.token.email != null &&
             request.auth.token.get('email_verified', false) == true &&
             memberRole(orgId, request.auth.token.email.lower()) == 'building_admin';
    }

    // True when the caller has a member doc under the given org (any role,
    // any status). Phase 1 intentionally does not filter on status:'active';
    // Phase 3 will add a status check once invited/inactive states are wired.
    // email_verified is REQUIRED, same reason as isAdmin() above.
    function isOrgMember(orgId) {
      return request.auth != null && request.auth.token.email != null &&
             request.auth.token.get('email_verified', false) == true &&
             exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email.lower()));
    }

    // ---- M1 full sign-in lockout (deny-by-status) ----
    // CEL can't resolve a user's org dynamically or enumerate orgs, so the gate runs
    // against the operator org (`orono`), the one org checkable by fixed path.
    // Mirrors OPERATOR_ORG_ID in context/AuthContext.tsx. Follow-up: a member
    // deactivated only in a 2nd/3rd org is blocked by AuthContext, not by these rules.
    // operatorMember(): caller's operator-org member doc or null. One get() (cached
    // per evaluation) both tests membership and reads status.
    function operatorMember() {
      return get(/databases/$(database)/documents/organizations/orono/members/$(request.auth.token.email.lower()));
    }

    // True UNLESS the caller is an operator-org member explicitly marked
    // 'inactive'. Defaults ALLOW for anyone without an operator-org member doc
    // (anon/PIN, SSO students, no-org/other-org teachers), so it only subtracts
    // access from a deliberately deactivated member. The email guard avoids a CEL
    // throw on tokens with no email claim.
    function notDeactivated() {
      return !(request.auth != null &&
               request.auth.token.get('email', '') != '' &&
               operatorMember() != null &&
               operatorMember().data.get('status', 'active') == 'inactive');
    }

    // The owner-only boundary on /users/{userId}/**, written once. Same operand
    // order as the inline form it replaces, so the cheap checks still short-circuit
    // before notDeactivated()'s get(). ownsUserTeacher also denies studentRole
    // tokens, which never own teacher-namespace docs.
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId && notDeactivated();
    }
    function ownsUserTeacher(userId) {
      return request.auth != null && request.auth.uid == userId &&
             !isStudentRoleUser() && notDeactivated();
    }

    // ---- Organizations collection (Phase 3: scoped writes enabled) ----
    // Super admins: any field, any org. Domain admins: org-wide writes for their org
    // (except AI/plan flags, super-admin only). Building admins: read-only except
    // member `status` for a member whose buildingIds intersect their own, never roleId.
    // System roles (`system: true`) are client-immutable.
    // Ordering: isOrgMember() (one exists()) precedes isSuperAdmin() (exists()+get())
    // so the common teacher path stays cheap.

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isSuperAdmin();
      // Super admins: create/delete, AI/plan, status. Domain admins: identity
      // fields for their own org only. users/buildings are server-derived counts,
      // never client-settable at the domain-admin tier.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isDomainAdmin(orgId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'shortName', 'shortCode', 'state', 'primaryAdminEmail',
           'seedColor', 'supportUrl'
         ]));

      match /buildings/{buildingId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        // Only domain+ admins can create/delete buildings. Create must carry
        // the canonical orgId + matching doc id, pin `users == 0` (derived
        // count, server-managed), and only include the known building fields
        // so clients can't seed unexpected attributes.
        allow create: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          request.resource.data.orgId == orgId &&
          request.resource.data.id == buildingId &&
          request.resource.data.users == 0 &&
          request.resource.data.keys().hasOnly([
            'id', 'orgId', 'name', 'address', 'grades', 'type',
            'adminEmails', 'users'
          ]);
        allow delete: if isSuperAdmin() || isDomainAdmin(orgId);
        // Domain+ admins edit any building in their org; building admins edit
        // only buildings they manage. Both tiers share a field whitelist so
        // neither can touch identity fields (id, orgId) or the server-managed
        // `users` count. Super admins are unrestricted.
        allow update: if isSuperAdmin() ||
            ((isDomainAdmin(orgId) ||
              (isBuildingAdmin(orgId) &&
               manages(orgId, buildingId))) &&
             request.resource.data.id == resource.data.id &&
             request.resource.data.orgId == resource.data.orgId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'name', 'address', 'grades', 'type', 'adminEmails'
             ]));
      }

      match /domains/{domainId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        // Domain/super admin only. Create pins canonical orgId + doc id, forces
        // status:'pending' and users:0, and hasOnly([...]) blocks stray fields.
        // `domain` must be normalized (leading '@', lowercase, dotted hostname) on BOTH
        // create and update: resolveOrgIdForDomain (classlinkShared.ts) resolves a user's
        // org via EXACT-match query and never normalizes the STORED side, so a mismatched
        // value would be accepted here and then fail org resolution forever, silently.
        allow create: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          request.resource.data.orgId == orgId &&
          request.resource.data.id == domainId &&
          request.resource.data.status == 'pending' &&
          request.resource.data.users == 0 &&
          request.resource.data.domain.matches('^@[a-z0-9.-]+[.][a-z]{2,}$') &&
          request.resource.data.keys().hasOnly([
            'id', 'orgId', 'domain', 'authMethod', 'status', 'role',
            'users', 'addedAt'
          ]);
        allow delete: if isSuperAdmin() || isDomainAdmin(orgId);
        allow update: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          request.resource.data.domain.matches('^@[a-z0-9.-]+[.][a-z]{2,}$') &&
          (isSuperAdmin() ||
           (request.resource.data.id == resource.data.id &&
            request.resource.data.orgId == resource.data.orgId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'domain', 'authMethod', 'role'
            ])));
      }

      match /roles/{roleId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        // System roles are migration-seeded and client-immutable, except super
        // admins may patch `perms` (see update branch). Client-created roles must
        // pin path identity, be system:false, and stay within the schema so
        // clients can't attach unexpected fields.
        allow create: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          request.resource.data.id == roleId &&
          request.resource.data.system == false &&
          request.resource.data.keys().hasAll(['id', 'name', 'system', 'perms']) &&
          request.resource.data.keys().hasOnly([
            'id', 'name', 'blurb', 'color', 'system', 'perms'
          ]);
        // Update pins id + system and blocks unknown fields. Super admins may
        // also edit `perms` on system roles (system:true preserved); domain
        // admins stay locked out of system docs.
        allow update: if
          (isSuperAdmin() &&
           request.resource.data.system == resource.data.system &&
           request.resource.data.id == resource.data.id &&
           ((resource.data.system == true &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perms'])) ||
            (resource.data.system != true &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'name', 'blurb', 'color', 'perms'
             ])))) ||
          (isDomainAdmin(orgId) &&
           resource.data.system != true &&
           request.resource.data.system == resource.data.system &&
           request.resource.data.id == resource.data.id &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'blurb', 'color', 'perms'
           ]));
        allow delete: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          resource.data.system != true;
      }

      match /members/{emailLower} {
        // Members can always see their own membership (to bootstrap useAuth);
        // other org members can see the member directory. Self-probe comes
        // first so a non-member checking their own (absent) doc never triggers
        // the super-admin lookup. `resource == null` is allowed unconditionally
        // (nothing to leak); email_verified is required once the doc exists.
        allow read: if (request.auth != null &&
                       request.auth.token.email != null &&
                       request.auth.token.email.lower() == emailLower &&
                       (resource == null ||
                        request.auth.token.get('email_verified', false) == true)) ||
                    isOrgMember(orgId) ||
                    isSuperAdmin();
        // Domain+ admins manage members via a field whitelist so identity fields (email,
        // orgId, uid, addedBy, addedBySource) stay pinned. `uid` is NOT update-whitelisted:
        // the first-sign-in uid link must go through a CF so no client can reassign a uid
        // and hijack the account. Building admins may update only `status` on members whose
        // buildingIds intersect their own. Create pins doc id == lowercased email (so
        // isOrgMember()'s lookup resolves) and forces data.email == emailLower (F15).
        allow create: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          request.resource.data.email == request.resource.data.email.lower() &&
          request.resource.data.email == emailLower &&
          request.resource.data.orgId == orgId &&
          request.resource.data.keys().hasAll(['email', 'orgId', 'roleId', 'buildingIds', 'status']) &&
          request.resource.data.keys().hasOnly([
            'email', 'orgId', 'roleId', 'buildingIds', 'status',
            'name', 'invitedAt', 'addedBy', 'addedBySource'
          ]);
        allow delete: if isSuperAdmin() || isDomainAdmin(orgId);
        allow update: if isSuperAdmin() ||
          (isDomainAdmin(orgId) &&
           request.resource.data.email == resource.data.email &&
           request.resource.data.orgId == resource.data.orgId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'roleId', 'buildingIds', 'status', 'name', 'invitedAt', 'lastActive'
           ]) &&
           // Anti-escalation: roleId=='super_admin' is a live isSuperAdmin() grant
           // (isMemberSuperAdmin()), so a domain admin must not write it (incl.
           // onto their own doc) unless the doc already had it. Only a super admin
           // (first disjunct) can grant it.
           (request.resource.data.get('roleId', '') != 'super_admin' ||
            resource.data.get('roleId', '') == 'super_admin')) ||
          // Building admin may flip `status` on a member whose buildingIds overlap
          // their own, alias-aware via buildingListsOverlap() (so 'high' vs
          // 'orono-high-school' still match, no .map() needed). An empty list on
          // either side = no overlap, so an unscoped member (buildingIds: []) is
          // not editable until a domain admin assigns a building. See
          // config/buildings.ts.
          (isBuildingAdmin(orgId) &&
           buildingListsOverlap(resource.data.get('buildingIds', []), orgMember(orgId).get('buildingIds', [])) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          // Self-write: a user may stamp `lastActive` on their own member doc.
          // Strictly bound — email/orgId must match and only `lastActive` may
          // change, so it can't escalate role/buildingIds/status or touch another
          // user. Powers the admin panel's "Last active" column without a CF.
          (request.auth != null &&
           request.auth.token.email != null &&
           request.auth.token.get('email_verified', false) == true &&
           request.auth.token.email.lower() == emailLower &&
           request.resource.data.email == resource.data.email &&
           request.resource.data.orgId == resource.data.orgId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive']));
      }

      match /studentPageConfig/{configId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        // Only the canonical `default` doc is writable; clients never need
        // arbitrary config ids, and delete is refused so the org always has
        // a config doc. Payload must carry the canonical orgId and only the
        // known config fields so clients can't seed unexpected attributes.
        allow create, update: if (isSuperAdmin() || isDomainAdmin(orgId)) &&
          configId == 'default' &&
          request.resource.data.orgId == orgId &&
          request.resource.data.keys().hasOnly([
            'orgId', 'showAnnouncements', 'showTeacherDirectory',
            'showLunchMenu', 'accentColor', 'heroText'
          ]);
        allow delete: if false;
      }

      match /invitations/{token} {
        // Phase 4 wires invite acceptance; until then nothing reads or writes
        // from the client — Cloud Functions own this collection.
        allow read, write: if false; // TODO(phase-4)
      }

      // Mock classes for PII-free student SSO testing. Admin-managed allowlist
      // that the `studentLoginV1` function (Admin SDK, bypasses rules) reads
      // to mint a custom token without calling OneRoster, and that the teacher
      // assignment class pickers read to expose test targets. Invisible to
      // non-admin teachers.
      match /testClasses/{classId} {
        allow read, write: if isSuperAdmin() || isDomainAdmin(orgId);
      }

      // Cached analytics snapshot, written nightly by recomputeAdminAnalytics
      // (Admin SDK, bypasses rules). Read gated to org admins (any tier) — it
      // carries per-member emails + engagement data. All client writes blocked;
      // the scheduler is the sole writer.
      match /analytics/{document} {
        allow read: if isSuperAdmin() ||
                    isDomainAdmin(orgId) ||
                    isBuildingAdmin(orgId);
        allow write: if false;
      }
    }

    // Admins collection
    match /admins/{email} {
      // Users can read their own admin record to check status (lower() for
      // case-insensitive matching). `resource == null` allowed unconditionally
      // (nothing to leak); email_verified required once the doc exists.
      allow read: if request.auth != null &&
                  request.auth.token.email != null &&
                  request.auth.token.email.lower() == email.lower() &&
                  (resource == null ||
                   request.auth.token.get('email_verified', false) == true);
      allow write: if false; // Only create via Firebase Console or Admin SDK
    }

    // Dashboards — owner-only. studentRole tokens (studentLoginV1) are denied
    // outright: students don't own a teacher dashboard (the app redirects them to
    // /my-assignments), and this rule is the real boundary against a studentRole
    // user creating a dashboard doc under their own uid via direct Firestore.
    match /users/{userId}/dashboards/{dashboardId} {
      allow read, write: if ownsUserTeacher(userId);

      // DrawingWidget objects live in a page-nested subcollection so one write is
      // one object, not the whole canvas. /pages/{pageId} holds page metadata,
      // /objects/{objectId} the DrawableObject list. These nested rules repeat the
      // parent's owner-only boundary so the subcollection inherits it.
      match /drawings/{widgetId}/pages/{pageId} {
        allow read, write: if ownsUserTeacher(userId);

        match /objects/{objectId} {
          allow read, write: if ownsUserTeacher(userId);
        }
      }
    }

    // Rosters - users can only access their own rosters in their subcollection
    match /users/{userId}/rosters/{rosterId} {
      allow read, write: if ownsUser(userId);

      // Non-PII PIN index sidecar bridging PIN-joining students into the SSO uid
      // space. commitRosterPinIndexV1 writes and pinLoginV1 reads via Admin SDK;
      // clients have NO write path (load-bearing for cap enforcement). Owner/admin
      // read only, for support/debugging.
      match /pin_index/{indexKey} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // Printed paper answer-sheet runs. PII-free by construction: seat numbers map
    // to opaque Student ids and names are resolved from the Drive roster, so this
    // mirrors the owner-only boundary of /rosters above rather than adding one.
    // Only a real teacher account prints sheets, so anonymous PIN joiners are shut
    // out of their own namespace too — same posture as the session-create paths.
    match /users/{userId}/paper_batches/{batchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
                         && !isStudentRoleUser()
                         && request.auth.token.firebase.sign_in_provider != 'anonymous'
                         && notDeactivated();
    }

    // PLC Overview layout — per-user PLC dashboard bento-grid prefs. No PLC
    // membership check needed (a non-member's doc is inert — tiles still pass the
    // PLC rule gates to read content). Per-tile enum validation is delegated to
    // usePlcOverviewLayout.ts (CEL has no .every()); blast radius is owner-only
    // and the tiles size cap below bounds doc size.
    match /users/{userId}/plc_layouts/{plcId} {
      allow read, delete: if ownsUser(userId);
      allow write: if ownsUser(userId)
                   && request.resource.data.keys().hasOnly(['tiles', 'updatedAt'])
                   && request.resource.data.tiles is list
                   && request.resource.data.tiles.size() <= 50
                   && request.resource.data.updatedAt is int;
    }

    // Per-user unread cursor for a PLC activity feed: one doc per (user, plc),
    // `{ lastSeenAt }`. Strictly owner-only. Schema locked to `lastSeenAt`, which
    // dual-accepts int || timestamp during the serverTimestamp rollout.
    match /users/{userId}/plc_state/{plcId} {
      allow read, delete: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
                   && request.resource.data.keys().hasOnly(['lastSeenAt'])
                   && (
                        request.resource.data.lastSeenAt is int
                        || request.resource.data.lastSeenAt is timestamp
                      );
    }

    // Mini Apps - users can only access their own mini apps in their subcollection
    match /users/{userId}/miniapps/{appId} {
      allow read, write: if ownsUser(userId);
    }

    // Saved Widgets - per-user "Save as widget" shortcuts (frozen widget configs
    // surfaced as dock/library entries). Owner-only.
    match /users/{userId}/saved_widgets/{savedWidgetId} {
      allow read, write: if ownsUser(userId);
    }

    // Notebooks - users can only access their own notebooks in their subcollection
    match /users/{userId}/notebooks/{notebookId} {
      allow read, write: if ownsUser(userId);
    }

    // PDFs - users can only access their own PDFs in their subcollection
    match /users/{userId}/pdfs/{pdfId} {
      allow read, write: if ownsUser(userId);
    }

    // Quiz metadata - users can only access their own quiz metadata
    match /users/{userId}/quizzes/{quizId} {
      allow read, write: if ownsUser(userId);
    }

    // Question-bank metadata (docs/plans/QUIZ_QUESTION_BANKS_AND_LEARNING_TARGETS.md §4.2).
    // Content is Drive JSON like quizzes; PLC shares publish to /synced_question_banks.
    match /users/{userId}/question_banks/{bankId} {
      allow read, write: if ownsUser(userId);
    }

    // Activity Wall library - per-user reusable activity definitions.
    // Activities used to live inline on the Activity Wall widget's config;
    // moving them here lets teachers reuse the same activity across widgets
    // and survive widget removal. Owner-only.
    match /users/{userId}/activity_wall_activities/{activityId} {
      allow read, write: if ownsUser(userId);
    }

    // Quiz assignments - archive of past/current assignments of a quiz. Per-user.
    // Harden writes so the user can't spoof the embedded teacherUid / id fields —
    // those are relied on by ownership checks elsewhere (session rules, shared
    // assignment author checks). Keep teacherUid and id immutable after create.
    match /users/{userId}/quiz_assignments/{assignmentId} {
      allow read, delete: if ownsUser(userId);
      allow create: if ownsUser(userId)
                    && request.resource.data.teacherUid == userId
                    && request.resource.data.id == assignmentId;
      allow update: if ownsUser(userId)
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.id == resource.data.id;
    }

    // M12 rubrics — teacher-owned reusable rubric library. Schema-locked to the
    // `Rubric` interface's top-level keys so graders can trust the shape at read
    // time (criterion internals are client-validated; CEL can't deep-validate
    // nested lists). studentRole tokens denied — students never own rubrics.
    match /users/{userId}/rubrics/{rubricId} {
      allow read, delete: if ownsUserTeacher(userId);
      allow create: if ownsUserTeacher(userId)
                    && request.resource.data.id == rubricId
                    && request.resource.data.keys().hasOnly([
                         'id', 'title', 'description', 'criteria', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.criteria is list
                    && request.resource.data.createdAt is int
                    && request.resource.data.updatedAt is int;
      allow update: if ownsUserTeacher(userId)
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.keys().hasOnly([
                         'id', 'title', 'description', 'criteria', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.criteria is list
                    && request.resource.data.updatedAt is int;
    }

    // Per-teacher inventory of Schoology (LTI) sections this teacher has SEEN via
    // a launch but may not have linked yet — drives the "Link to Schoology"
    // review screen + the post-launch prompt, and carries the sessionId the
    // linking CFs use as their trust anchor. SERVER-WRITTEN (the launch-context
    // persist writes it via the Admin SDK); the owner can only READ their own.
    match /users/{userId}/lti_seen_sections/{contextId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // User data collection. Intentionally NOT gated by notDeactivated(): this
    // doc (email/lastLogin/buildings) is read during sign-in bootstrap, before
    // AuthContext's own membership listener has resolved status, and adding
    // the gate here would cost an extra get() on the hottest read path.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile (building selection, etc.) — stored per user. Same
    // bootstrap-path exemption as /users/{userId} above.
    match /users/{userId}/userProfile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Private server-managed credentials (e.g. encrypted Google OAuth
    // refresh_token via exchangeGoogleAuthCode / refreshGoogleAccessToken).
    // DENY ALL client access — Admin SDK only. Explicit (vs default-deny) to
    // document intent and guard against a future permissive users/** rule.
    match /users/{userId}/private/{document=**} {
      allow read, write: if false;
    }

    // Starter Packs
    match /artifacts/{appId}/public/data/starterPacks/{packId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Standards catalog (MN benchmarks) - seeded by the admin Standards panel from
    // config/standards/*.json with deterministic ids; any authed user reads it.
    match /standards_catalog/{benchmarkId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Video Activities - all authenticated users can read, only admins can write
    match /global_video_activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Catalyst Routines (legacy)
    match /artifacts/{appId}/public/data/catalystRoutines/{routineId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Catalyst Sets
    match /artifacts/{appId}/public/data/catalystSets/{setId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /artifacts/{appId}/users/{userId}/starterPacks/{packId} {
      allow read, write: if ownsUser(userId);
    }

    // Admin-only collections
    match /admin_settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Content areas (subjects) — teachers read them for their profile; admins edit.
    match /admin_settings/subjects {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Curated translation languages + org caps — teachers read the language list
    // for the quiz Languages tab; admins edit. Deliberately a SEPARATE doc from
    // quiz_read_aloud, which stays admin-only.
    match /admin_settings/quiz_translation {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for real-time (CRDT) PLC note editing — every member
    // reads it to decide which editor path to mount; admins flip it.
    match /admin_settings/plc_note_collab {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for paper answer sheets — teachers read it to decide
    // whether to surface the print/import entry points; admins flip it.
    match /admin_settings/paper_answer_sheets {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for printing a PLC teammate's paper answer sheets — a
    // member reads it to decide whether to surface the delegated print entry;
    // admins flip it. Separate from paper_answer_sheets so delegation can be
    // killed on its own.
    match /admin_settings/plc_delegated_printing {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for class groups in widgets — teachers read it to decide
    // whether to offer the group picker; admins flip it.
    match /admin_settings/roster_groups_integration {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for the Projects widget — teachers read it to decide
    // whether to mount the widget at all, and students so it stays a kill
    // switch for runs already created; admins flip it.
    match /admin_settings/projects_widget {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rollout switch for building a quiz from a test document — teachers read
    // it to decide whether to offer the import source; admins flip it.
    match /admin_settings/quiz_document_import {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin audit log — admin-only read; create-only (append-only so an admin
    // can't edit/delete their own trail). Written by GlobalPermissionsManager on
    // sensitive settings changes. timestamp is set server-side via
    // serverTimestamp(), so no is-int validation here.
    match /admin_audit_log/{logId} {
      allow read, create: if isAdmin();
    }

    // User Roles - stored in admin_settings for global access but restricted to admins
    match /admin_settings/user_roles {
      allow read, write: if isAdmin();
    }

    // Explicitly allow all authenticated users to read user roles
    // Removed because this exposes PII (emails). Need a different architecture.
    // Reverting to admin only for now.

    // Feature permissions - all authenticated users can read, only admins can write
    match /feature_permissions/{widgetType} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin-created short links resolved at /r/:code.
    // get: public. list: admin-only (blocks anonymous enumeration of codes+targets).
    // create: admins, plus non-anon users minting an Activity Wall gallery link
    // stamped with their own uid. edit/delete: admin-only.
    // update: narrow anonymous path - may only bump `clicks` by exactly 1 and stamp
    // `lastClickedAt` within +/-5min of server time (blocks counter inflation/reset).
    match /short_links/{code} {
      allow get: if true;
      allow list: if isAdmin();
      // Teachers may also mint a code, but only for an Activity Wall gallery
      // destination they stamp with their own uid — not an arbitrary redirect.
      // Student SSO sessions are custom-token (non-anonymous), so they need an
      // explicit exclusion or they would qualify as minters too.
      allow create: if isAdmin() ||
        (request.auth != null &&
         request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         !isStudentRoleUser() &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.destination is string &&
         request.resource.data.destination.matches('^https://(spartboard[.]web[.]app|spartboard[.]firebaseapp[.]com|spartboard--[a-z0-9-]+[.]web[.]app)/activity-wall/gallery/[A-Za-z0-9_-]+$'));
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clicks', 'lastClickedAt'])
            && request.resource.data.clicks == resource.data.get('clicks', 0) + 1
            && request.resource.data.lastClickedAt is int
            && request.resource.data.lastClickedAt <= request.time.toMillis() + 300000
            && request.resource.data.lastClickedAt >= request.time.toMillis() - 300000);
      allow delete: if isAdmin();
    }

    // Classroom Add-on course links - maps a Google Classroom courseId to a ClassLink
    // section sourcedId. READ open to any authed user (the discovery iframe needs it).
    // WRITES are server-only: linkClassroomCourse verifies the caller teaches the
    // course, then writes via Admin SDK. Rules can't verify that, so a client create
    // would let anyone squat any courseId and mis-route students.
    match /classroom_course_links/{courseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Schoology LTI 1.3: server-internal OIDC handshake state, Admin SDK only.
    // The login-initiation CF writes per-launch `state`/`nonce`; the launch CF reads
    // and deletes it. Short-lived CSRF protection with no client path - deny all.
    match /lti_oidc_state/{state} {
      allow read, write: if false;
    }

    // Server-internal one-time launch codes — Admin SDK only. After the LTI
    // launch CF validates the id_token it mints a single-use code that the
    // SpartBoard runner exchanges (server-side) for a custom auth token.
    // Mirrors lti_oidc_state: a transient server secret, so deny all client
    // access.
    match /lti_launch_codes/{code} {
      allow read, write: if false;
    }

    // Schoology section (LTI context) -> ClassLink class link; LTI analogue of
    // classroom_course_links, keyed by LTI `context_id`. READ open to any authed user
    // (teacher monitor + SidebarClasses resolve link state). WRITES are SERVER-ONLY:
    // linkLtiCourseV1 verifies the caller owns a session that SAW this context before
    // writing via Admin SDK. Rules can't validate an LTI launch, so a client write
    // would let any authed user squat any context_id.
    match /lti_course_links/{contextId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // PII-free grade-sync keys (pseudonym sub -> resourceLink). Written and read only
    // by CFs via the Admin SDK. Deny all client access: a doc carries the student's
    // LTI `sub` + AGS line-item/score URLs, which no client should enumerate.
    match /lti_grade_links/{pseudonymUid}/resources/{resourceLinkId} {
      allow read, write: if false;
    }

    // PII-free sticky identity bridge (Schoology sub pseudonym -> ClassLink pseudonym),
    // written and read only by the launch exchange CF via Admin SDK. Exists so a
    // OneRoster blip can't re-identify a student mid-assignment. Neither side is a
    // secret alone, but the mapping LINKS a student's two identities - deny all.
    match /lti_identity_bridge/{pseudonymUid} {
      allow read, write: if false;
    }

    // PII-free NRPS membership endpoints, keyed by quiz session -> context. Written and
    // read only by CFs via Admin SDK; a doc holds a roster service URL no client should
    // enumerate, so deny all. `{document=**}` covers the contexts/{contextId} subcollection.
    match /lti_session_memberships/{sessionId}/{document=**} {
      allow read, write: if false;
    }

    // Global permissions - all authenticated users can read, only admins can write
    match /global_permissions/{featureId=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Pilot / district-rollout requests submitted from the public /request
    // form (docs/wide-distro-plan.md Phase 2). Any signed-in user may CREATE
    // one with a strictly validated shape (identity fields pinned to their
    // token so requests can't impersonate); only admins read/triage. The
    // rolloutRequestEmail CF (Admin SDK) relays each create to /mail.
    match /rollout_requests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.get('email', '') != ''
        && request.resource.data.keys().hasOnly([
             'kind', 'name', 'email', 'role', 'organization', 'domain',
             'size', 'message', 'status', 'createdAt', 'submittedByUid'
           ])
        && request.resource.data.kind in ['pilot', 'district']
        && request.resource.data.status == 'new'
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.role is string
        && request.resource.data.role.size() <= 200
        && request.resource.data.organization is string
        && request.resource.data.organization.size() > 0
        && request.resource.data.organization.size() <= 300
        && request.resource.data.domain is string
        && request.resource.data.domain.size() <= 200
        && request.resource.data.size is string
        && request.resource.data.size.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is number;
    }

    // Mail queue consumed by the `firestore-send-email` Firebase extension.
    // Writes happen server-side only (Admin SDK bypasses rules, so the
    // `createOrganizationInvites` CF can still enqueue sends). Clients must
    // never read or write — these docs contain pending recipient addresses
    // and the extension's `delivery` subfield exposes SMTP response details.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Guided Learning
    match /users/{userId}/guided_learning/{setId} {
      allow read, write: if ownsUser(userId);
    }

    match /building_guided_learning/{setId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin backgrounds - authenticated users can read based on access level, only admins can write
    match /admin_backgrounds/{backgroundId} {
      // Admins can read everything
      allow read: if isAdmin();
      
      // Non-admins can read public backgrounds
      allow read: if request.auth != null && resource.data.accessLevel == 'public';
      
      // Non-admins can read beta backgrounds if they are explicitly in the beta list.
      // email_verified is REQUIRED, same reason as isAdmin() above.
      allow read: if request.auth != null &&
                  resource.data.accessLevel == 'beta' &&
                  request.auth.token.get('email_verified', false) == true &&
                  request.auth.token.email.lower() in resource.data.betaUsers;

      allow write: if isAdmin();
    }

    // Global weather data
    match /global_weather/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global music stations - authenticated users can read, only admins can write
    match /global_music_stations/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Instructional routines - all authenticated users can read, only admins can write
    match /instructional_routines/{routineId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Shared boards - backing store for live-shared dashboards. Import modes: copy
    // (snapshot, no doc-side state), view-only (reader joins as viewer, host pushes),
    // synced (reader joins as collaborator, both push). Update rules: host = anything;
    // collaborator = content but not participants/ownership; viewer = none; any authed
    // user may append only themselves to participants; intendedMode immutable after
    // create (the recipient flow trusts it to skip the picker).
    match /shared_boards/{shareId} {
      // GET (single doc, `resource` fully bound). Substitute shares carry org-internal
      // routing/Drive-grant metadata, so reads are limited to host, admins, and
      // @orono.k12.mn.us callers AND not past expiresAt for the email branch - otherwise
      // a direct-REST client could read a frozen board snapshot plus Drive-grant metadata
      // indefinitely after expiry (the sweep can leave an expired doc up to 7 days).
      // Host/admin still read past expiry for cleanup. Mirrors /shared_collections.
      // email_verified is REQUIRED on the @orono branch, same reason as isAdmin() above -
      // otherwise an unverified email/password account could self-report an
      // @orono.k12.mn.us address it doesn't own.
      allow get: if request.auth != null && (
        resource.data.get('intendedMode', null) != 'substitute'
        || resource.data.get('originalAuthor', null) == request.auth.uid
        || isAdmin()
        || (
          isVerifiedDistrictEmail()
          && resource.data.get('expiresAt', 0) > request.time.toMillis()
        )
      );

      // LIST is evaluated against the QUERY, not the matched documents. Only fields the
      // query pins with an EQUALITY filter carry their value; others fall back to the
      // `.get()` default, and a RANGE-filtered field raises an error that denies the whole
      // query. So the get branches can't be reused: under `intendedMode == 'substitute'`
      // the first branch is false, `originalAuthor` defaults to null, and range-filtered
      // `expiresAt` errors. Each branch below reads only what its own query pins:
      //   - own shares: originalAuthor == uid
      //   - /subs directory: intendedMode == 'substitute' + @orono email
      //   - PLC board picker: plcId == <plc> + membership (sound only because a substitute
      //     share can never carry a plcId - forbidden at create, pinned in update)
      // Unscoped list stays admin-only. Expiry is NOT enforceable here, so an @orono
      // caller can list - never `get` - an expired sub share until the sweep reaps it.
      // email_verified is REQUIRED on the @orono branch, same reason as the GET rule above.
      allow list: if request.auth != null && (
        isAdmin()
        || resource.data.get('originalAuthor', null) == request.auth.uid
        || (
          resource.data.get('intendedMode', null) == 'substitute'
          && isVerifiedDistrictEmail()
        )
        || (
          resource.data.get('plcId', null) != null
          && request.auth.uid in get(
            /databases/$(database)/documents/plcs/$(resource.data.plcId)
          ).data.memberUids
        )
      );

      // Host writes their own share; a `plcId` tag requires current membership of that
      // PLC. Substitute addendum (intendedMode == 'substitute'): buildingId non-empty
      // string; expiresAt a future number <=14 days out (caps share + Drive-grant
      // lifetime); initialState a list; subEmails capped <=20. PLC scoping is not
      // allowed for substitute shares.
      allow create: if request.auth != null &&
        request.resource.data.originalAuthor == request.auth.uid &&
        (
          request.resource.data.get('intendedMode', null) != 'substitute'
          || (
            request.resource.data.get('plcId', null) == null
            && request.resource.data.buildingId is string
            && request.resource.data.buildingId.size() > 0
            && request.resource.data.expiresAt is number
            && request.resource.data.expiresAt > request.time.toMillis()
            && request.resource.data.expiresAt <= request.time.toMillis() + 1209600000
            && request.resource.data.initialState is list
            // subEmails DoS cap: DashboardContext issues one Drive grant per entry
            // with no bound. Optional; <=20 when set. (Same guard on update below.)
            && (!('subEmails' in request.resource.data)
                || (request.resource.data.subEmails is list
                    && request.resource.data.subEmails.size() <= 20))
          )
        ) &&
        (
          request.resource.data.get('plcId', null) == null ||
          request.auth.uid in get(
            /databases/$(database)/documents/plcs/$(request.resource.data.plcId)
          ).data.memberUids
        );

      // Host or admin: full update, but intendedMode is locked to its create value and
      // any plcId change requires current membership of the target PLC (admins bypass).
      // Substitute addendum: all lifecycle fields (buildingId, initialState, expiresAt,
      // subEmails, driveGrants, sharedRosters) are pinned to create-time values so the frozen,
      // time-boxed snapshot can't drift. Admin-overridable.
      allow update: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin()) &&
        request.resource.data.get('intendedMode', null) == resource.data.get('intendedMode', null) &&
        // "substitute + plcId" must stay an impossible state. The `list` rule's plcId
        // branch admits any member of that PLC with no @orono/expiry gate and CANNOT
        // re-check intendedMode (the PLC query doesn't pin it, so in query scope it
        // resolves to the `.get()` default and passes silently). Create already forbids
        // plcId on substitute shares; this stops a later update from attaching one and
        // exposing driveGrants/subEmails/initialState. Deliberately NOT admin-overridable
        // - this is what makes the list branch sound.
        (
          request.resource.data.get('intendedMode', null) != 'substitute'
          || request.resource.data.get('plcId', null) == null
        ) &&
        (
          resource.data.get('intendedMode', null) != 'substitute'
          || isAdmin()
          || (
            request.resource.data.get('buildingId', null) == resource.data.get('buildingId', null) &&
            request.resource.data.get('initialState', null) == resource.data.get('initialState', null) &&
            request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null) &&
            request.resource.data.get('subEmails', null) == resource.data.get('subEmails', null) &&
            request.resource.data.get('driveGrants', null) == resource.data.get('driveGrants', null) &&
            request.resource.data.get('sharedRosters', null) == resource.data.get('sharedRosters', null)
          )
        ) &&
        (
          request.resource.data.get('plcId', null) == resource.data.get('plcId', null)
          || request.resource.data.get('plcId', null) == null
          || isAdmin()
          || request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(request.resource.data.plcId)
             ).data.memberUids
        ) &&
        // subEmails cap on EVERY owner update (copy/PLC shares too, not just
        // substitute which pins it above) — bounds doc size. Matches create cap.
        (!('subEmails' in request.resource.data)
          || (request.resource.data.subEmails is list
              && request.resource.data.subEmails.size() <= 20));

      // Collaborator (Synced): may update content but not participants,
      // originalAuthor, originalAuthorName (host display name — spoofable
      // identity), sharedAt, intendedMode, or plcId (pins PLC scope so a
      // collaborator can't retarget/strip another's share).
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.get('participants', {}) &&
        resource.data.participants[request.auth.uid].get('role', '') == 'collaborator' &&
        request.resource.data.get('participants', {}) == resource.data.get('participants', {}) &&
        request.resource.data.originalAuthor == resource.data.originalAuthor &&
        request.resource.data.get('originalAuthorName', null) == resource.data.get('originalAuthorName', null) &&
        request.resource.data.get('sharedAt', null) == resource.data.get('sharedAt', null) &&
        request.resource.data.get('intendedMode', null) == resource.data.get('intendedMode', null) &&
        request.resource.data.get('plcId', null) == resource.data.get('plcId', null);

      // Self-join: any authed user may add ONLY their own uid to participants
      // (Synced/View-Only importers). Not allowed on substitute shares — subs
      // view via /subs without importing, so a self-join would be a phantom.
      allow update: if request.auth != null &&
        resource.data.get('intendedMode', null) != 'substitute' &&
        !(request.auth.uid in resource.data.get('participants', {})) &&
        request.auth.uid in request.resource.data.get('participants', {}) &&
        request.resource.data.participants.diff(resource.data.get('participants', {}))
          .affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']);

      // Self-leave: any participant may remove ONLY their own uid from
      // participants. No-op for substitute shares (they never accept participants).
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.get('participants', {}) &&
        !(request.auth.uid in request.resource.data.get('participants', {})) &&
        resource.data.participants.diff(request.resource.data.get('participants', {}))
          .affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']);

      allow delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    // Collection-level shares — parent holds metadata, /boards/{boardId}
    // subcollection holds frozen Board snapshots. Mirrors /shared_boards
    // substitute gating + 14-day expiresAt cap.
    match /shared_collections/{shareId} {
      // Shape the doc must hold after any write: a non-empty, capped board list,
      // a named collection, and capped tree lists. Enforced on create AND update
      // because /subs and the host's manager render these fields unguarded.
      function validCollectionShareShape() {
        return request.resource.data.boardIds is list
          && request.resource.data.boardIds.size() > 0
          && request.resource.data.boardIds.size() <= 500
          && request.resource.data.collection.name is string
          && request.resource.data.collection.name.size() > 0
          && (!('sections' in request.resource.data)
              || (request.resource.data.sections is list
                  && request.resource.data.sections.size() <= 500))
          && (!('boards' in request.resource.data)
              || (request.resource.data.boards is list
                  && request.resource.data.boards.size() <= 500));
      }

      // GET: any authed user for non-substitute. Substitute shares gated by
      // host/admin/@orono.k12.mn.us email AND not past expiresAt (a hostile
      // direct-REST client would otherwise read stale snapshots forever). Host
      // and admin can read past expiry for cleanup. email_verified is REQUIRED
      // on the @orono branch, same reason as isAdmin() above - otherwise an
      // unverified email/password account could self-report an
      // @orono.k12.mn.us address it doesn't own.
      allow get: if request.auth != null && (
        resource.data.get('intendedMode', null) != 'substitute'
        || resource.data.get('hostUid', null) == request.auth.uid
        || isAdmin()
        || (
          isVerifiedDistrictEmail()
          && resource.data.get('expiresAt', 0) > request.time.toMillis()
        )
      );

      // LIST is query-scoped (see /shared_boards list for the full explanation): only
      // equality-pinned fields carry a value and range-filtered `expiresAt` errors.
      // Branches match the two queries the app issues - a host's own substitute shares
      // and the /subs directory. Expiry can't be enforced in query scope, so expired
      // shares stay listable (never `get`-able) until the sweep. email_verified is
      // REQUIRED on the @orono branch, same reason as the GET rule above.
      allow list: if request.auth != null && (
        isAdmin()
        || resource.data.get('hostUid', null) == request.auth.uid
        || (
          resource.data.get('intendedMode', null) == 'substitute'
          && isVerifiedDistrictEmail()
        )
      );

      // CREATE: host writes their own share. Shape per
      // validCollectionShareShape(); intendedMode in the legal set. Substitute adds
      // a 14-day TTL cap (1209600000ms) + non-empty buildingId (mirrors
      // /shared_boards). Optional subEmails/driveGrants are allowed at create and
      // constrained again by the update rule below.
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && validCollectionShareShape()
        && request.resource.data.intendedMode in ['copy', 'substitute']
        && (
          request.resource.data.intendedMode != 'substitute'
          || (
            request.resource.data.buildingId is string
            && request.resource.data.buildingId.size() > 0
            && request.resource.data.expiresAt is number
            && request.resource.data.expiresAt > request.time.toMillis()
            && request.resource.data.expiresAt <= request.time.toMillis() + 1209600000
            // subEmails DoS cap (one Drive grant per entry, unbounded). Optional;
            // a list of <=20 when present.
            && (!('subEmails' in request.resource.data)
                || (request.resource.data.subEmails is list
                    && request.resource.data.subEmails.size() <= 20))
          )
        );

      // UPDATE: host-only (or admin). intendedMode is pinned on BOTH branches:
      // gating on the pre-update value alone would let a host flip a copy share
      // (unrestricted here) into a substitute one with any buildingId, any
      // expiry and any number of subs, which every verified district account
      // could then read. The subEmails cap is pinned on both for the same reason.
      // hostUid is pinned on both branches too: the host/admin check reads the
      // pre-update doc, so without the pin a host could hand their own share to
      // an arbitrary uid and lose the ability to update or delete it.
      // A substitute share then takes only the keys the sub-shares manager
      // writes — re-pushing the boards, retargeting the subs, extending, or
      // stamping it expired to end it — so buildingId stays pinned by omission
      // from the allowlist. expiresAt is capped at 14 days out, the same cap as
      // create; it may be set into the past, which is how "End now" cuts the
      // sub off.
      allow update: if request.auth != null
        && (resource.data.get('hostUid', null) == request.auth.uid || isAdmin())
        && validCollectionShareShape()
        && request.resource.data.get('intendedMode', null)
           == resource.data.get('intendedMode', null)
        && request.resource.data.get('hostUid', null)
           == resource.data.get('hostUid', null)
        && (!('subEmails' in request.resource.data)
            || (request.resource.data.subEmails is list
                && request.resource.data.subEmails.size() <= 20))
        && (
          resource.data.get('intendedMode', null) == 'copy'
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'boards', 'boardIds', 'sections', 'collection', 'defaultBoardId',
              'kind', 'subEmails', 'sharedRosters', 'driveGrants',
              'contentVersion', 'updatedAt', 'expiresAt'
            ])
            && request.resource.data.expiresAt is number
            && request.resource.data.expiresAt <= request.time.toMillis() + 1209600000
          )
        );

      allow delete: if request.auth != null
        && (resource.data.get('hostUid', null) == request.auth.uid || isAdmin());

      // The parent's gates, written once for every sub-collection below. Reads
      // mirror parent semantics (incl. the substitute expiresAt cutoff); writes
      // are the parent's host only, and the create batch writes the parent
      // first, so the get() resolves. email_verified is REQUIRED on the @orono
      // branch, same reason as isAdmin() above.
      function shareData() {
        return get(/databases/$(database)/documents/shared_collections/$(shareId)).data;
      }
      function canReadShared() {
        return request.auth != null && (
          shareData().get('intendedMode', null) != 'substitute'
          || shareData().get('hostUid', null) == request.auth.uid
          || isAdmin()
          || (
            isVerifiedDistrictEmail()
            && shareData().get('expiresAt', 0) > request.time.toMillis()
          )
        );
      }
      function isShareHost() {
        return request.auth != null
          && shareData().get('hostUid', null) == request.auth.uid;
      }

      // Per-Board snapshots.
      match /boards/{boardId} {
        allow read: if canReadShared();
        allow create, update, delete: if isShareHost();
      }

      // Display content for widgets whose data lives outside the board, so a
      // sub sees the teacher's drawing, notebook or queue rather than their own.
      match /content/{contentId} {
        allow read: if canReadShared();
        allow create, update, delete: if isShareHost();
      }

      // Answer keys and full activity copies. Narrower than content/: the host,
      // an admin, or a sub this share names by email, and never past expiry.
      match /keys/{keyId} {
        allow read: if request.auth != null && (
          isShareHost()
          || isAdmin()
          || (
            isVerifiedDistrictEmail()
            && shareData().get('expiresAt', 0) > request.time.toMillis()
            && request.auth.token.get('email', '').lower()
               in shareData().get('subEmails', [])
          )
        );
        allow create, update, delete: if isShareHost();
      }
    }

    // Preset substitute emails — per-building list of generic sub accounts,
    // admin-managed, read by teachers for the share modal's preset chips. Doc id
    // = canonical building id (config/buildings.ts).
    match /preset_sub_emails/{buildingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Shared quizzes - Same pattern as shared_boards.
    match /shared_quizzes/{shareId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.originalAuthor == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    // Shared rubrics (M12) — link-based rubric sharing, same get/author-write
    // posture as shared_quizzes plus a schema lock (full rubric payload is
    // inlined so recipients import without a second read). No list — share docs
    // are fetched only by known id, preventing enumeration.
    match /shared_rubrics/{shareId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.originalAuthor == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'id', 'title', 'description', 'criteria',
                         'createdAt', 'updatedAt', 'originalAuthor', 'sharedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.criteria is list
                    && request.resource.data.originalAuthor is string
                    && request.resource.data.sharedAt is int;
      allow update, delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    // Shared quiz assignments - like shared_quizzes but also carries assignment
    // settings (class label, PLC sheet URL, session toggles) so a receiving
    // teacher can get a pre-configured, paused assignment when they paste the link.
    match /shared_assignments/{shareId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.originalAuthor == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    // Shared notebooks — a SMART Notebook published for staff sharing (carries
    // token-bearing asset URLs + title/sections; recipient pastes link to copy).
    // Same owner-write / authed-read pattern as shared_quizzes.
    match /shared_notebooks/{shareId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.originalAuthor == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    // Shared Activity Wall galleries — view-only published copy of a session's
    // submissions. Viewers land at /activity-wall/gallery/{shareId} and read the
    // doc for the sessionId + toggles (allowComments/allowCommentResponses/
    // allowLikes). Readable by any signed-in caller (incl. anonymous students).
    match /shared_activity_walls/{shareId} {
      // READ: any authed caller (incl. anonymous gallery viewers) may read a live share;
      // host and admin can still read past revoke/expiry for cleanup. Mirrors the
      // expiresAt cutoff on /shared_boards and /shared_collections - without it the
      // "Available until X" / revoke UX is cosmetic, since a caller bypassing the client
      // could keep reading a gallery's title/prompt/sessionId forever after revoke.
      allow read: if request.auth != null && (
        resource.data.get('originalAuthor', null) == request.auth.uid
        || isAdmin()
        || (
          resource.data.get('revoked', false) != true
          && (resource.data.get('expiresAt', null) == null
              || resource.data.get('expiresAt', 0) > request.time.toMillis())
        )
      );

      // Identity fields + the sessionId-ownership check force the doc to be
      // created by the teacher who owns the underlying session (can't publish
      // another teacher's submissions). hasOnly([...]) schema-locks the doc.
      // `revoked` is allowed (not required) at create for publish-then-revoke.
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.originalAuthor == request.auth.uid &&
        request.resource.data.id == shareId &&
        request.resource.data.sessionId is string &&
        // No startsWith() in rules — matches() (RE2) is the only prefix primitive.
        // Auth UIDs are alphanumeric (no regex-special chars), so embedding is safe.
        request.resource.data.sessionId.matches(request.auth.uid + '_.*') &&
        request.resource.data.keys().hasOnly([
          'id', 'sessionId', 'originalAuthor', 'title', 'prompt', 'mode',
          'identificationMode', 'allowComments', 'allowCommentResponses',
          'allowLikes', 'createdAt', 'expiresAt', 'revoked'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.prompt is string &&
        request.resource.data.mode in ['text', 'photo'] &&
        request.resource.data.identificationMode in ['anonymous', 'name', 'pin', 'name-pin'] &&
        request.resource.data.allowComments is bool &&
        request.resource.data.allowCommentResponses is bool &&
        request.resource.data.allowLikes is bool &&
        request.resource.data.createdAt is int &&
        (request.resource.data.expiresAt == null || request.resource.data.expiresAt is int) &&
        optBool(request.resource.data, 'revoked');

      // Identity fields frozen post-create (can't retarget the session or hijack
      // attribution); toggles (allow*, expiresAt, revoked) stay mutable for
      // revoke-without-delete and toggle-after-publish.
      allow update: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.originalAuthor == resource.data.originalAuthor &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());

      // Comments — any authenticated viewer (incl. anonymous) can create.
      // Parent share must allow comments; replies (parentCommentId != null)
      // additionally require allowCommentResponses == true.
      match /comments/{commentId} {
        function parentShare() {
          return get(/databases/$(database)/documents/shared_activity_walls/$(shareId)).data;
        }
        // READ mirrors the parent-doc gate: the share owner and admins can
        // always read (moderation/cleanup), but everyone else only while the
        // parent share is live. Without this, a caller that already holds the
        // shareId could keep enumerating every comment (content +
        // participantLabel) on a revoked or expired share indefinitely, even
        // though the parent doc read is now closed.
        allow read: if request.auth != null && (
          parentShare().get('originalAuthor', null) == request.auth.uid
          || isAdmin()
          || (
            parentShare().get('revoked', false) != true
            && (parentShare().get('expiresAt', null) == null
                || parentShare().get('expiresAt', 0) > request.time.toMillis())
          )
        );
        allow create: if request.auth != null &&
          parentShare().get('revoked', false) == false &&
          parentShare().get('allowComments', false) == true &&
          (
            request.resource.data.get('parentCommentId', null) == null ||
            parentShare().get('allowCommentResponses', false) == true
          ) &&
          request.resource.data.id == commentId &&
          request.resource.data.keys().hasOnly([
            'id', 'submissionId', 'content', 'participantLabel', 'authorUid',
            'createdAt', 'parentCommentId'
          ]) &&
          request.resource.data.submissionId is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000 &&
          request.resource.data.participantLabel is string &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.createdAt is int;
        // Commenter can delete their own comment; share owner / admin can
        // moderate any comment.
        allow delete: if request.auth != null &&
          (
            resource.data.get('authorUid', null) == request.auth.uid ||
            parentShare().get('originalAuthor', null) == request.auth.uid ||
            isAdmin()
          );
        allow update: if false;
      }

      // Likes — deterministic doc id (`{submissionId}__{authorUid}`) caps
      // each viewer to one like per submission. Toggling off is a delete.
      match /likes/{likeId} {
        function parentShare() {
          return get(/databases/$(database)/documents/shared_activity_walls/$(shareId)).data;
        }
        // Same live-share gate as comments: owner/admin always, everyone else
        // only while the parent share is neither revoked nor past expiresAt.
        allow read: if request.auth != null && (
          parentShare().get('originalAuthor', null) == request.auth.uid
          || isAdmin()
          || (
            parentShare().get('revoked', false) != true
            && (parentShare().get('expiresAt', null) == null
                || parentShare().get('expiresAt', 0) > request.time.toMillis())
          )
        );
        allow create: if request.auth != null &&
          parentShare().get('revoked', false) == false &&
          parentShare().get('allowLikes', false) == true &&
          request.resource.data.keys().hasOnly([
            'id', 'submissionId', 'authorUid', 'createdAt'
          ]) &&
          request.resource.data.submissionId is string &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.createdAt is int &&
          likeId == request.resource.data.submissionId + '__' + request.auth.uid;
        allow delete: if request.auth != null &&
          (
            resource.data.get('authorUid', null) == request.auth.uid ||
            parentShare().get('originalAuthor', null) == request.auth.uid ||
            isAdmin()
          );
        allow update: if false;
      }
    }

    // Synced quiz groups - canonical mutable record of a quiz shared across PLC peers.
    // Group id is an unguessable v4 UUID, so reads are auth-only. Content writes
    // require existing participation; version increments monotonically so a
    // non-participant can't overwrite. The participants map is client-immutable
    // (joins/leaves go through CFs); create is open iff participants carries only the
    // caller's uid.
    match /synced_quizzes/{groupId} {
      allow get: if request.auth != null;
      // list closed: it would let any authed user enumerate every synced quiz
      // (defeating the unguessable-id gate on get). Clients always know the
      // groupId via their quiz_metadata or a share URL, so get suffices.
      allow list: if false;

      // hasOnly(...) pins the top-level field surface so a client can't smuggle
      // extra fields downstream consumers might trust.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'title', 'questions',
             'participants', 'plcId', 'createdAt',
             'updatedAt', 'updatedBy', 'behavior', 'stimuli',
             'paperSheetStimuli', 'translations'
           ])
        && request.resource.data.id == groupId
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.participants.keys().hasOnly([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].joinedAt is int
        && request.resource.data.participants[request.auth.uid].joinedAt >= 0
        // Validate plcId type when present so a malformed link/cast can't write
        // a non-string value that downstream PLC reads would mishandle.
        && optString(request.resource.data, 'plcId')
        && optMap(request.resource.data, 'behavior')
        && optList(request.resource.data, 'stimuli')
        // Items printed on a paper answer sheet; same list shape as `stimuli`.
        && optList(request.resource.data, 'paperSheetStimuli')
        && optMap(request.resource.data, 'translations');

      // Content updates: caller must be a participant; participants + id are
      // client-immutable; version must increase by exactly 1 (concurrent loser
      // retries on the newer base); hasOnly locks the field surface.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'title', 'questions',
             'participants', 'plcId', 'createdAt',
             'updatedAt', 'updatedBy', 'behavior', 'stimuli',
             'paperSheetStimuli', 'translations'
           ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.updatedBy == request.auth.uid
        // plcId is the link to the owning PLC and must stay immutable post-create
        // — handle the case where either side is missing the field with a default.
        && request.resource.data.get('plcId', null) == resource.data.get('plcId', null)
        && optMap(request.resource.data, 'behavior')
        && optList(request.resource.data, 'stimuli')
        && optList(request.resource.data, 'paperSheetStimuli')
        && optMap(request.resource.data, 'translations');

      // No client delete. An orphaned (empty-participants) group stays so an old
      // share URL still resolves the bootstrap snapshot rather than 404.
      allow delete: if false;

      // ---- Bounded version history (PRD §5.1/§3.10) ----
      // Pre-edit snapshot of canonical content, written fire-and-forget after the
      // canonical commit so it never blocks a publish. Participant read;
      // participant-create-only with a schema lock + self-attributed `savedBy`. No
      // client update/delete — pruning past the ~10 cap is Admin-SDK GC.
      match /versions/{versionId} {
        // Participant read (mirrors the parent group's participant gate).
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/synced_quizzes/$(groupId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/synced_quizzes/$(groupId)).data.participants
          && request.resource.data.keys().hasOnly(['version', 'content', 'savedBy', 'savedAt'])
          && request.resource.data.savedBy == request.auth.uid
          && request.resource.data.version is int
          && request.resource.data.savedAt is int
          && request.resource.data.content is map;

        // Identity-immutable: snapshots are append-only from clients.
        allow update, delete: if false;
      }
    }

    // ---- Synced QUESTION BANKS (plan §4.2, decision 1) ----
    // Read-only PLC share of a personal bank: only the owner writes (the bank
    // editor republishes on every save); any authed user may get by id (ids are
    // unguessable uuids, handed out via plcs/{plcId}/question_banks headers).
    // No participants/join function - members never co-edit.
    match /synced_question_banks/{groupId} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'id', 'ownerUid', 'plcIds', 'version', 'title', 'questions',
             'stimuli', 'targets', 'language', 'questionCount', 'targetIds',
             'targetCounts', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.id == groupId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.plcIds is list
        && request.resource.data.questions is list
        && request.resource.data.questionCount is int
        && request.resource.data.targetIds is list
        && request.resource.data.targetCounts is map
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && optList(request.resource.data, 'stimuli')
        && optList(request.resource.data, 'targets');

      // Owner-only; version climbs by exactly one so stale pulls are detectable.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'id', 'ownerUid', 'plcIds', 'version', 'title', 'questions',
             'stimuli', 'targets', 'language', 'questionCount', 'targetIds',
             'targetCounts', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.plcIds is list
        && request.resource.data.questions is list
        && request.resource.data.questionCount is int
        && request.resource.data.targetIds is list
        && request.resource.data.targetCounts is map
        && request.resource.data.updatedAt is int
        && optList(request.resource.data, 'stimuli')
        && optList(request.resource.data, 'targets');

      // Unshare from the last PLC removes the copy; a slot pointing here then
      // fails assign-time resolution with a fix-it message.
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // ---- Shared / Synced VIDEO ACTIVITY parallel collections (PR3) ----
    // Mirrors the quiz /shared_assignments and /synced_quizzes blocks, scoped to Video
    // Activity. Kept parallel (not a `kind` discriminator) so quiz rules don't migrate
    // and VA's schema can drift independently.

    match /shared_video_activity_assignments/{shareId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.originalAuthor == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.get('originalAuthor', null) == request.auth.uid || isAdmin());
    }

    match /synced_video_activities/{groupId} {
      allow get: if request.auth != null;
      // list closed (see synced_quizzes): would let any authed user enumerate
      // every synced activity. Clients know the groupId via their
      // video_activity_metadata or a share URL.
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'title', 'youtubeUrl', 'questions',
             'participants', 'plcId', 'createdAt',
             'updatedAt', 'updatedBy', 'behavior'
           ])
        && request.resource.data.id == groupId
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.participants.keys().hasOnly([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].joinedAt is int
        && request.resource.data.participants[request.auth.uid].joinedAt >= 0
        && optString(request.resource.data, 'plcId')
        && optMap(request.resource.data, 'behavior');

      // Content updates: participant-only; participants + id client-immutable;
      // version increases by exactly 1. Mirrors synced_quizzes line-for-line.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'title', 'youtubeUrl', 'questions',
             'participants', 'plcId', 'createdAt',
             'updatedAt', 'updatedBy', 'behavior'
           ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.get('plcId', null) == resource.data.get('plcId', null)
        && optMap(request.resource.data, 'behavior');

      allow delete: if false;

      // ---- Bounded version history (PRD §5.1/§3.10) ----
      // Mirrors synced_quizzes/{groupId}/versions, scoped to Video Activity.
      // Participant read; participant-create-only (schema lock + self `savedBy`);
      // no client update/delete (server-side GC).
      match /versions/{versionId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/synced_video_activities/$(groupId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/synced_video_activities/$(groupId)).data.participants
          && request.resource.data.keys().hasOnly(['version', 'content', 'savedBy', 'savedAt'])
          && request.resource.data.savedBy == request.auth.uid
          && request.resource.data.version is int
          && request.resource.data.savedAt is int
          && request.resource.data.content is map;

        allow update, delete: if false;
      }
    }

    // ---- PLC (Professional Learning Community) helpers + rules ----
    // PLCs are top-level so every member can read the doc. The lead has full write
    // authority; non-leads can only self-add (accept an invite) or self-remove.
    // Invitations use a deterministic id `<plcId>_<emailLower>` so accept verifies an
    // invite without enumerating; re-inviting overwrites.
    function plcInviteDocId(plcId, emailLower) {
      return plcId + '_' + emailLower;
    }

    // The role recorded for a uid in the canonical `members` map (Decision
    // 1.2), or '' when the map is absent / that uid has no entry. Used by the
    // role/transfer branches to authorize lead + co-lead membership managers.
    function plcRoleOf(plcData, uid) {
      return plcData.get('members', {}).get(uid, {}).get('role', '');
    }

    // True when the caller may WRITE PLC content (Decision 3.2). An editor is a member
    // whose role in `members` is not 'viewer'. Legacy (map-less) PLCs treat any uid in
    // memberUids as an editor, so un-migrated members aren't locked out during rollout.
    // Content subcollections thread this into write branches; reads stay open.
    function plcCanEditContent(plcId) {
      let plcData = get(/databases/$(database)/documents/plcs/$(plcId)).data;
      let role = plcRoleOf(plcData, request.auth.uid);
      let mapHasCaller = request.auth.uid in plcData.get('members', {});
      // Map present + caller keyed: role governs (viewer => denied).
      // Map absent / caller not keyed: fall back to the denormalized index
      // (legacy PLCs have no viewers, so membership == edit rights).
      return mapHasCaller
        ? role != 'viewer'
        : request.auth.uid in plcData.memberUids;
    }

    // True when the caller is a membership manager — the sitting lead OR a coLead
    // (Decision 1.2). Falls back to the denormalized leadUid so legacy (map-less)
    // PLCs still authorize their lead; coLeads exist only once the map is present.
    function isPlcMembershipManager(plcData) {
      let role = plcRoleOf(plcData, request.auth.uid);
      return request.auth.uid == plcData.get('leadUid', '')
        || role == 'lead'
        || role == 'coLead';
    }

    // Exactly-one-lead invariant (Decision 1.2): a role change must never mint a
    // second lead (only transferLead moves the crown). CEL can't iterate a map, so
    // this leans on the leadUid mirror — the leadUid member is 'lead' both sides.
    // Pair with a leadUid-immutability check.
    function plcLeadRoleUnchanged(plcData, newData) {
      return plcRoleOf(newData, newData.get('leadUid', '')) == 'lead'
        && plcRoleOf(plcData, plcData.get('leadUid', '')) == 'lead';
    }

    // Guards the broad sitting-lead update branch against minting a second lead
    // (Decision 1.2). Its only permitted members mutation is a single-member REMOVAL
    // named by the transient `removeMemberUid` pointer. Returns true when members is
    // untouched, so rename / tenancy-backfill writes still pass.
    function plcBroadMembersOk() {
      let touchesMembers =
        'members' in request.resource.data.diff(resource.data).affectedKeys();
      let removed = request.resource.data.get('removeMemberUid', '');
      let newMembers = request.resource.data.get('members', {});
      let memberDiff = newMembers
        .diff(resource.data.get('members', {}))
        .affectedKeys();
      return !touchesMembers
        || (
             // The sitting lead must stay lead (no self-demote via this path).
             plcLeadRoleUnchanged(resource.data, request.resource.data)
             // A removal pointer is supplied and names the sole changed entry.
             && removed != ''
             && memberDiff.hasOnly([removed])
             // The named member is being removed (status flips to 'removed'),
             // and is NOT the sitting lead (the lead can't vacate this way).
             && removed != resource.data.get('leadUid', '')
             && (removed in resource.data.get('members', {}))
             && newMembers[removed].status == 'removed'
           );
    }

    // True iff the update is the caller self-adding to memberUids (accepting an
    // invite). Verified against a matching *pending* invitation doc, and
    // constrained so the only change is appending the caller (an invitee can't
    // rewrite the whole array).
    // email_verified is REQUIRED, same reason as isAdmin() above — otherwise an
    // unverified self-reported email lets an attacker accept another teacher's
    // PLC invite and join in their place.
    function isAcceptingPlcInvite(plcId) {
      let emailLower = request.auth.token.get('email', '').lower();
      let oldMembers = resource.data.memberUids;
      let newMembers = request.resource.data.memberUids;
      let oldEmails = resource.data.memberEmails;
      let newEmails = request.resource.data.memberEmails;
      // members map moves in lockstep with the denormalized indexes: accepting
      // appends only the caller's own entry (role 'member', status 'active').
      // OPTIONAL in the diff (legacy array-only PLCs still accept); when present,
      // may add only the caller's uid as an active self record.
      let membersUntouchedOrSelfAppended =
        !('members' in request.resource.data.diff(resource.data).affectedKeys())
        || (
             request.resource.data.members.diff(resource.data.get('members', {}))
               .affectedKeys().hasOnly([request.auth.uid])
             && request.resource.data.members[request.auth.uid].role == 'member'
             && request.resource.data.members[request.auth.uid].status == 'active'
             && request.resource.data.members[request.auth.uid].uid == request.auth.uid
           );
      return request.auth.token.get('email_verified', false) == true
        && emailLower != ''
        && !(request.auth.uid in oldMembers)
        && (request.auth.uid in newMembers)
        && newMembers.size() == oldMembers.size() + 1
        && newMembers.toSet().hasAll(oldMembers.toSet())
        && newEmails.diff(oldEmails).affectedKeys().hasOnly([request.auth.uid])
        && newEmails.get(request.auth.uid, '') == emailLower
        && membersUntouchedOrSelfAppended
        // leadUid is immutable on the accept path — an invitee can never seize
        // leadership while self-adding.
        && request.resource.data.get('leadUid', '') == resource.data.get('leadUid', '')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberEmails', 'members', 'updatedAt'])
        // Dual-accept the timestamp bump (serverTimestamp resolves to a
        // `timestamp`; legacy clients still write `int` during rollout).
        && plcUpdatedAtOk()
        && get(/databases/$(database)/documents/plc_invitations/$(plcInviteDocId(plcId, emailLower))).data.status == 'pending';
    }

    // updatedAt dual-accept (timestamp || legacy int millis) during the
    // serverTimestamp rollout (Decision 3.2). Centralized so tightening to
    // timestamp-only is a one-line change.
    function plcUpdatedAtOk() {
      let v = request.resource.data.get('updatedAt', 0);
      return v is timestamp || v is int;
    }

    // Dual-accept (timestamp || int millis) for a named time field on a PLC
    // subcollection doc (createdAt / lastEditedAt / updatedAt) during the
    // serverTimestamp rollout. Only widens the accepted type, no new field.
    function plcSubTimeFieldOk(field) {
      let v = request.resource.data.get(field, 0);
      return v is timestamp || v is int;
    }

    // Soft-delete tombstone (`deletedAt`, Decision 3.1) well-formed: absent, null,
    // timestamp, or legacy int millis. Carried by notes/todos/docs/quizzes/
    // video_activities/comments. Hard-deletion (>30d) is server-side via
    // gcPlcOrphans; these rules govern only the soft-delete/restore flips.
    function plcSubDeletedAtOk() {
      let v = request.resource.data.get('deletedAt', null);
      return v == null || v is timestamp || v is int;
    }

    // Optional pickup run-settings on a PLC quiz header: each field may be
    // absent; when present it must match the assignment-template shape.
    function plcQuizRunSettingsOk() {
      let d = request.resource.data;
      return (!('sessionMode' in d) || d.sessionMode in ['teacher', 'auto', 'student'])
        && optMap(d, 'sessionOptions')
        && (!('attemptLimit' in d) || d.attemptLimit == null || d.attemptLimit is int)
        && optString(d, 'quizId');
    }

    // Optional NULLABLE time field well-formed: absent, null, timestamp, or legacy
    // int millis. Used for Common Assessment scheduling (opensAt / dueAt, §3.6),
    // which unlike createdAt/updatedAt may be omitted or null.
    function plcSubNullableTimeFieldOk(field) {
      let v = request.resource.data.get(field, null);
      return v == null || v is timestamp || v is int;
    }

    // Tenancy field (orgId / buildingId, Decision 1.1) immutable-after-set: may be
    // backfilled once (null → value) or rewritten to the same value, never to a
    // different one — stops re-homing a PLC into another org's directory.
    function plcTenancyImmutableAfterSet(field) {
      let old = resource.data.get(field, null);
      let knew = request.resource.data.get(field, null);
      return old == null || knew == old;
    }

    // True iff a current member sets/clears `sharedSheetUrl` and nothing else (any
    // member, not lead-only). Allowed: null -> string, string -> null. Rejected:
    // string -> different string (would orphan another's cached sheet). Defense-in-depth
    // on the transactional client setPlcSharedSheetUrl.
    function isSettingPlcSharedSheetUrl() {
      return (request.auth.uid in resource.data.memberUids)
        // hasOnly + hasAny: diff is exactly sharedSheetUrl (+ updatedAt); hasAny
        // blocks an updatedAt-only ping that resets mtime without setting the URL.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sharedSheetUrl', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['sharedSheetUrl'])
        && (
             request.resource.data.sharedSheetUrl is string
             || request.resource.data.sharedSheetUrl == null
           )
        && (
             resource.data.get('sharedSheetUrl', null) == null
             || request.resource.data.sharedSheetUrl == null
             || request.resource.data.sharedSheetUrl == resource.data.sharedSheetUrl
           )
        && plcUpdatedAtOk();
    }

    // True iff the update is any current member toggling the dashboard `features`
    // map and nothing else — shared config, not lead-only. Closed to features +
    // updatedAt so it can't smuggle membership/leadership/sheet-URL changes.
    function isUpdatingPlcFeatures() {
      return (request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['features', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['features'])
        && request.resource.data.features is map
        && plcUpdatedAtOk();
    }

    // True iff the update is any current member toggling the opt-in weekly-digest
    // flag (`digestOptIn`, Decision 2.3) and nothing else (member-flippable like
    // features, not lead-only). Closed to digestOptIn + updatedAt, must be bool.
    // The email is sent server-side by plcWeeklyDigest, gated by the global
    // plc-digest.enabled kill switch (default OFF).
    function isUpdatingPlcDigestOptIn() {
      return (request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['digestOptIn', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['digestOptIn'])
        && request.resource.data.digestOptIn is bool
        && plcUpdatedAtOk();
    }

    // True iff the update is the caller self-removing from memberUids (leaving).
    // The lead can't use this path (transfer or delete first). Constrained so the
    // only change is dropping the caller (can't evict others while leaving).
    function isLeavingPlc() {
      let oldMembers = resource.data.memberUids;
      let newMembers = request.resource.data.memberUids;
      let oldEmails = resource.data.memberEmails;
      let newEmails = request.resource.data.memberEmails;
      // members map moves in lockstep: when in the diff, only the leaver's own
      // entry may change (flip to status 'removed'), so the branch can't rewrite a
      // teammate while self-removing. OPTIONAL (legacy array-only PLCs still leave).
      let membersUntouchedOrSelfRemoved =
        !('members' in request.resource.data.diff(resource.data).affectedKeys())
        || (
             request.resource.data.members.diff(resource.data.get('members', {}))
               .affectedKeys().hasOnly([request.auth.uid])
             && request.resource.data.members[request.auth.uid].status == 'removed'
           );
      return (request.auth.uid in oldMembers)
        && !(request.auth.uid in newMembers)
        && request.auth.uid != resource.data.leadUid
        && newMembers.size() == oldMembers.size() - 1
        && oldMembers.toSet().hasAll(newMembers.toSet())
        && newEmails.diff(oldEmails).affectedKeys().hasOnly([request.auth.uid])
        && membersUntouchedOrSelfRemoved
        // Keep the field-set closed so this branch still can't smuggle a name /
        // sheet-url / org change.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberEmails', 'members', 'updatedAt'])
        // leadUid is immutable on the leave path (a non-lead is leaving).
        && request.resource.data.get('leadUid', '') == resource.data.leadUid
        && plcUpdatedAtOk();
    }

    // True iff a membership manager (lead OR coLead) transfers leadership to another
    // current member - the only way to move the crown. Invoker is lead/coLead; new
    // leadUid is an existing member != old lead; map lockstep (never two leads); diff
    // closed to leadUid/members/memberUids/memberEmails/updatedAt; membership unchanged.
    function isTransferringPlcLead() {
      let oldLead = resource.data.leadUid;
      let newLead = request.resource.data.leadUid;
      // Lockstep checks apply only once a populated members map exists; legacy
      // map-less PLCs transfer via leadUid alone (only the sitting lead can).
      let mapPresent =
        'members' in request.resource.data
        && request.auth.uid in request.resource.data.members;
      let mapLockstep =
        !mapPresent
        || (
             request.resource.data.members[newLead].role == 'lead'
             && request.resource.data.members[oldLead].role != 'lead'
           );
      // A transfer may change ONLY the two lead entries — re-roling others must
      // go through isChangingMemberRole, one at a time.
      let membersDiffOk =
        !mapPresent
        || request.resource.data.members
             .diff(resource.data.get('members', {}))
             .affectedKeys().hasOnly([newLead, oldLead]);
      return isPlcMembershipManager(resource.data)
        && newLead != oldLead
        && (newLead in resource.data.memberUids)
        && (newLead in request.resource.data.memberUids)
        && mapLockstep
        && membersDiffOk
        // The leaving/incoming lead both remain members — the set is identical.
        && request.resource.data.memberUids.toSet()
             .hasAll(resource.data.memberUids.toSet())
        && resource.data.memberUids.toSet()
             .hasAll(request.resource.data.memberUids.toSet())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['leadUid', 'members', 'memberUids', 'memberEmails',
                       'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['leadUid'])
        && plcUpdatedAtOk();
    }

    // True iff a membership manager changes exactly ONE member's role within {coLead,
    // member, viewer} and nothing else. CEL can't index a map at a dynamic key, so the
    // target is the schema-locked transient `roleChangeUid` pointer. Guards
    // exactly-one-lead: leadUid immutable, lead stays 'lead', diff closed to members +
    // roleChangeUid + updatedAt, target != sitting lead, new role never 'lead'.
    function isChangingMemberRole() {
      let target = request.resource.data.get('roleChangeUid', '');
      let changedKeys =
        request.resource.data.members.diff(resource.data.get('members', {}))
          .affectedKeys();
      return isPlcMembershipManager(resource.data)
        // Field-set closed: only the members map, the target pointer, and the
        // customary updatedAt bump may change.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'roleChangeUid', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['members'])
        && target != ''
        // leadUid never moves on this branch (transferLead owns that).
        && request.resource.data.get('leadUid', '') == resource.data.get('leadUid', '')
        // The exactly-one-lead invariant: the lead member is 'lead' both sides.
        && plcLeadRoleUnchanged(resource.data, request.resource.data)
        // Exactly the named member's entry changes…
        && changedKeys.hasOnly([target])
        && changedKeys.size() == 1
        // …and the target is NOT the sitting lead (no self-demoting the lead).
        && target != resource.data.get('leadUid', '')
        // …to a non-lead role (coLead | member | viewer) — never 'lead'.
        && request.resource.data.members[target].role in ['coLead', 'member', 'viewer']
        // The changed member must already be (and remain) a real member entry —
        // role changes don't add/drop people (that's invite/leave/remove).
        && (target in resource.data.get('members', {}))
        && request.resource.data.members[target].uid == target
        && plcUpdatedAtOk();
    }

    // True iff an in-org SITE ADMIN recovers an abandoned PLC (Decision 3.4) -
    // reassigning leadership WITHOUT being a member. Scoped: isAdmin(); PLC has an
    // orgId and the admin is in that SAME org; new leadUid is an existing member != old
    // lead; map lockstep; membership unchanged; diff closed to leadUid/members/
    // memberUids/memberEmails/updatedAt. Mutually exclusive with the member-only branches.
    function isAdminManagingPlc() {
      let oldLead = resource.data.get('leadUid', '');
      let newLead = request.resource.data.get('leadUid', '');
      // Lockstep map<->leadUid checks only apply once the PLC carries a
      // populated members map (legacy PLCs reassign via leadUid alone).
      let mapPresent =
        'members' in request.resource.data
        && newLead in request.resource.data.members
        && oldLead in request.resource.data.get('members', {});
      let mapLockstep =
        !mapPresent
        || (
             request.resource.data.members[newLead].role == 'lead'
             && request.resource.data.members[oldLead].role != 'lead'
           );
      // Recovery may change ONLY the two lead entries in the members map — an
      // admin reassign can't silently re-role other members in the same write.
      let membersDiffOk =
        !mapPresent
        || request.resource.data.members
             .diff(resource.data.get('members', {}))
             .affectedKeys().hasOnly([newLead, oldLead]);
      return isAdmin()
        && resource.data.get('orgId', null) is string
        && isOrgMember(resource.data.orgId)
        && newLead != oldLead
        && (newLead in resource.data.memberUids)
        && (newLead in request.resource.data.memberUids)
        && mapLockstep
        && membersDiffOk
        // The membership SET is unchanged — recovery reassigns, never adds/drops.
        && request.resource.data.memberUids.toSet()
             .hasAll(resource.data.memberUids.toSet())
        && resource.data.memberUids.toSet()
             .hasAll(request.resource.data.memberUids.toSet())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['leadUid', 'members', 'memberUids', 'memberEmails',
                       'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['leadUid'])
        && plcUpdatedAtOk();
    }

    // In-org site admin adds, re-roles or removes ONE non-lead member; target named
    // by the transient `adminMemberUid`. leadUid and every other entry are untouched.
    function isAdminEditingPlcMembers() {
      let target = request.resource.data.get('adminMemberUid', '');
      let newMembers = request.resource.data.get('members', {});
      let oldMembers = resource.data.get('members', {});
      let oldUids = resource.data.memberUids;
      let newUids = request.resource.data.memberUids;
      // Uids the arrays know but the map does not (un-migrated PLC, or an invite accept that
      // only wrote the arrays) may be backfilled alongside the target. CEL cannot iterate a map,
      // so those backfilled entries are copied through by the client and not checked one by one.
      let arrayOnly = oldUids.toSet().difference(oldMembers.keys().toSet());
      let allowedKeys = arrayOnly.union([target].toSet());
      return isAdmin()
        && resource.data.get('orgId', null) is string
        && isOrgMember(resource.data.orgId)
        && target != ''
        && target != resource.data.leadUid
        && request.resource.data.leadUid == resource.data.leadUid
        && (target in newMembers)
        && newMembers.diff(oldMembers).affectedKeys().hasOnly(allowedKeys)
        // A backfill must carry every legacy uid and nothing else.
        && (oldMembers.size() > 0
            || (newMembers.keys().toSet().hasOnly(allowedKeys)
                && newMembers.keys().toSet().hasAll(allowedKeys)))
        && (resource.data.leadUid in newMembers)
        && newMembers[resource.data.leadUid].role == 'lead'
        && newMembers[target].uid == target
        && newMembers[target].role in ['coLead', 'member', 'viewer']
        && newMembers[target].status in ['active', 'removed']
        && ((target in newUids) == (newMembers[target].status == 'active'))
        && newUids.removeAll([target]).toSet().hasAll(oldUids.removeAll([target]))
        && oldUids.removeAll([target]).toSet().hasAll(newUids.removeAll([target]))
        && request.resource.data.memberEmails
             .diff(resource.data.get('memberEmails', {}))
             .affectedKeys().hasOnly(allowedKeys)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids', 'memberEmails', 'adminMemberUid',
                       'updatedAt'])
        && plcUpdatedAtOk();
    }

    // Slim, PII-free discovery mirror of each PLC root, server-written by
    // mirrorPlcIndex (Decision 1.1). Powers the "PLCs in my building" directory
    // without exposing teacher emails/names — only name/orgId/buildingId/opaque
    // memberUids + count. Read by same-org peers, members, and admins; writes are
    // server-only so a client can't forge a discovery entry.
    match /plcIndex/{plcId} {
      // isAdmin() is a bare /admins/{email} doc, which also mirrors org-scoped
      // building_admin (see functions/src/organizationMembersSync.ts) — used
      // bare here it let a building_admin of one org browse another org's PLC
      // directory. Scoped the same way as isAdminManagingPlc() below: same-org
      // admin only, same as the org-peer branch it sits next to. isSuperAdmin()
      // stays as a resource-independent branch (matching help_resources) so the
      // admin "browse every PLC" picker (hooks/usePlcs.ts's asAdmin mode, an
      // unfiltered list query) stays provable by Firestore's rules engine for a
      // genuine site-wide admin — without it, no read branch is resource-
      // independent and Firestore rejects the whole unfiltered query for
      // everyone, not just the building_admin this scoping is meant to deny.
      allow read: if request.auth != null
        && (
          request.auth.uid in resource.data.get('memberUids', [])
          || (
            resource.data.get('orgId', null) is string
            && isOrgMember(resource.data.orgId)
          )
          || (
            isAdmin()
            && resource.data.get('orgId', null) is string
            && isOrgMember(resource.data.orgId)
          )
          || isSuperAdmin()
        );
      // Server-only — clients never write the discovery mirror.
      allow create, update, delete: if false;
    }

    match /plcs/{plcId} {
      // Members + same-org admins only. The root doc carries member PII
      // (emails/names), so it's NOT exposed to same-org peers — discovery reads
      // the PII-free /plcIndex mirror instead. The gate reads BOTH the canonical
      // members map and the denormalized memberUids index (either shape
      // authorizes during rollout). isAdmin() is a bare /admins/{email} doc,
      // which also mirrors org-scoped building_admin (see
      // functions/src/organizationMembersSync.ts) — used bare it let a
      // building_admin of one org read another org's member emails/names off
      // this doc. Scoped to same-org, matching isAdminManagingPlc() and the
      // admin delete branch below (both already same-org-gated and tested in
      // plcAdminRecovery.test.ts) instead of the write side being scoped while
      // read stayed open. isSuperAdmin() stays as a resource-independent branch
      // for the same reason as plcIndex above — hooks/usePlcs.ts's asAdmin mode
      // runs the same kind of unfiltered list query against this collection.
      allow read: if request.auth != null
        && (
          request.auth.uid in resource.data.get('members', {})
          || request.auth.uid in resource.data.memberUids
          || (
            isAdmin()
            && resource.data.get('orgId', null) is string
            && isOrgMember(resource.data.orgId)
          )
          || isSuperAdmin()
        );

      // The creating teacher is the lead and only initial member: members map
      // carries exactly that uid at role 'lead' (active), mirrored by
      // memberUids == [uid] and leadUid == uid. Optional tenancy (orgId/
      // buildingId) null or string; createdAt/updatedAt dual-accept timestamp||int.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.leadUid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members.keys().size() == 1
        && request.resource.data.members[request.auth.uid].role == 'lead'
        && request.resource.data.members[request.auth.uid].status == 'active'
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid
        && (
             !('orgId' in request.resource.data)
             || request.resource.data.orgId == null
             || request.resource.data.orgId is string
           )
        && (
             !('buildingId' in request.resource.data)
             || request.resource.data.buildingId == null
             || request.resource.data.buildingId is string
           )
        && (
             request.resource.data.get('createdAt', 0) is timestamp
             || request.resource.data.get('createdAt', 0) is int
           )
        && (
             request.resource.data.get('updatedAt', 0) is timestamp
             || request.resource.data.get('updatedAt', 0) is int
           );

      // Lead can rename, remove a member (via `removeMemberUid`), or backfill tenancy -
      // but can't vacate leadership (leadUid immutable) or mint a second lead
      // (plcBroadMembersOk limits members mutations to one named removal). Tenancy
      // (orgId/buildingId) is immutable-after-set. The update branches are MUTUALLY
      // EXCLUSIVE, each a disjoint shape: broad sitting-lead update; isAcceptingPlcInvite;
      // isLeavingPlc; isTransferringPlcLead / isChangingMemberRole; isSettingPlcSharedSheetUrl
      // / isUpdatingPlcFeatures / isUpdatingPlcDigestOptIn; isAdminManagingPlc (the only
      // non-member branch).
      allow update: if request.auth != null && (
        (
          request.auth.uid == resource.data.leadUid
          && request.resource.data.leadUid == resource.data.leadUid
          && resource.data.leadUid in request.resource.data.memberUids
          && plcUpdatedAtOk()
          && plcTenancyImmutableAfterSet('orgId')
          && plcTenancyImmutableAfterSet('buildingId')
          // Block minting a second lead — members changes here are a single named
          // removal only (exactly-one-lead invariant, Decision 1.2).
          && plcBroadMembersOk()
        )
        || isAcceptingPlcInvite(plcId)
        || isLeavingPlc()
        || isTransferringPlcLead()
        || isChangingMemberRole()
        || isSettingPlcSharedSheetUrl()
        || isUpdatingPlcFeatures()
        || isUpdatingPlcDigestOptIn()
        || isAdminManagingPlc()
        || isAdminEditingPlcMembers()
      );

      // The lead can dissolve the PLC; an in-org SITE ADMIN can also dissolve an
      // abandoned PLC for recovery (Decision 3.4), gated to a PLC whose orgId
      // matches an org the admin belongs to.
      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.leadUid
          || (
            isAdmin()
            && resource.data.get('orgId', null) is string
            && isOrgMember(resource.data.orgId)
          )
        );

      // Index of PLC-mode assignments authored by any member — a small snapshot
      // (title, ownerUid, sheetUrl, createdAt) written by the author when their
      // quiz_assignments doc opts into PLC mode. Subcollection so member-gated
      // reads stay one-line.
      match /assignment_index/{assignmentId} {
        // Any current member can read the index — the dashboard renders
        // the same list for everyone in the PLC.
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Author-only writes; doc id pinned to the source assignment id for join-back.
        // Author must be a current PLC member. hasOnly([...]) locks the shape. sheetUrl is
        // optional ('' when the assignment has no sheet); when set it is pinned to the
        // trusted Google Sheets host/path (rendered as a clickable link, so an arbitrary
        // string is a phishing vector). create/update are split so update can
        // check the *existing* ownerUid and pin id/ownerUid/createdAt.
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.ownerUid
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids
          && assignmentId == request.resource.data.id
          && request.resource.data.keys().hasOnly([
               'id', 'kind', 'ownerUid', 'ownerName', 'ownerEmail',
               'title', 'sheetUrl', 'status', 'createdAt'
             ])
          && request.resource.data.kind in ['quiz', 'video-activity']
          && request.resource.data.status in ['active', 'paused', 'inactive']
          && (
               request.resource.data.sheetUrl == ''
               || request.resource.data.sheetUrl.matches('^https://docs[.]google[.]com/spreadsheets/.*$')
             );

        allow update: if request.auth != null
          // Caller must be the *existing* owner — prevents takeover by a
          // different member rewriting `ownerUid` to themselves.
          && request.auth.uid == resource.data.ownerUid
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids
          // Identity fields immutable; mutable: status (mirrored on pause/
          // deactivate/reopen) + legacy fields. Shape closed via hasOnly([...]).
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && assignmentId == request.resource.data.id
          && request.resource.data.keys().hasOnly([
               'id', 'kind', 'ownerUid', 'ownerName', 'ownerEmail',
               'title', 'sheetUrl', 'status', 'createdAt'
             ])
          && request.resource.data.kind in ['quiz', 'video-activity']
          && request.resource.data.status in ['active', 'paused', 'inactive']
          && (
               request.resource.data.sheetUrl == ''
               || request.resource.data.sheetUrl.matches('^https://docs[.]google[.]com/spreadsheets/.*$')
             );

        // Authors clean up their own entries. No lead-override — leads ask the
        // owner to sweep stale entries.
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.ownerUid;
      }

      // Anonymized per-assessment aggregates (Decisions 6.0+3.3) — member-readable,
      // PII-free rollups of every teacher's contributions. Writes are server-only
      // (aggregatePlcAssessment + migratePlcs via Admin SDK). Members read (gated
      // on members map OR memberUids); never create/update/delete, so the
      // raw-contribution PII boundary holds.
      match /aggregates/{aggregateId} {
        function plcRootData() {
          return get(/databases/$(database)/documents/plcs/$(plcId)).data;
        }
        allow read: if request.auth != null
          && (
            request.auth.uid in plcRootData().get('members', {})
            || request.auth.uid in plcRootData().memberUids
          );
        // No client writes — server-only (Admin SDK bypasses rules).
        allow create, update, delete: if false;
      }

      // PLC Common Assessments (Decision 4.0c) - a quiz/VA whose pooled results aggregate
      // to one canonical id. PLC-owned: any non-viewer member authors/edits/soft-deletes.
      // Identity (id), authorship, kind, and the syncGroupId pointer are immutable
      // post-create so a stale mirror can't retarget the sync group. Shape locked via
      // hasOnly([...]); time fields dual-accept int||timestamp||null.
      match /assessments/{assessmentId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: any non-viewer member (plcCanEditContent — viewers denied), doc
        // id pinned, createdBy == caller.
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'kind', 'syncGroupId', 'unitLabel',
               'opensAt', 'dueAt', 'status',
               'createdBy', 'createdAt', 'updatedAt', 'deletedAt',
               'sourceQuizId', 'dirtyAt', 'folderId'
             ])
          && request.resource.data.id == assessmentId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.kind in ['quiz', 'video-activity']
          && request.resource.data.syncGroupId is string
          // Non-empty syncGroupId (the aggregation pipeline keys on it);
          // defense-in-depth, the client also rejects empty.
          && request.resource.data.syncGroupId.size() > 0
          && request.resource.data.status in [
               'planning', 'active', 'reviewing', 'closed'
             ]
          && (
               !('unitLabel' in request.resource.data)
               || request.resource.data.unitLabel is string
             )
          && plcSubNullableTimeFieldOk('opensAt')
          && plcSubNullableTimeFieldOk('dueAt')
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('createdAt')
          && plcSubTimeFieldOk('updatedAt')
          // sourceQuizId: first quiz that auto-created this assessment. dirtyAt is
          // owned by the markPlcAssessmentDirty function (Admin SDK); clients may
          // only write it as null/absent.
          && (
               !('sourceQuizId' in request.resource.data)
               || request.resource.data.sourceQuizId is string
             )
          && (
               !('folderId' in request.resource.data)
               || request.resource.data.folderId == null
               || request.resource.data.folderId is string
             )
          && request.resource.data.get('dirtyAt', null) == null;

        // Update: non-viewer member mutates working fields (title/unitLabel/
        // opensAt/dueAt/status/updatedAt) or soft-deletes via deletedAt. Identity,
        // createdBy/createdAt, kind, syncGroupId immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'kind', 'syncGroupId', 'unitLabel',
               'opensAt', 'dueAt', 'status',
               'createdBy', 'createdAt', 'updatedAt', 'deletedAt',
               'sourceQuizId', 'dirtyAt', 'folderId'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.syncGroupId == resource.data.syncGroupId
          && request.resource.data.title is string
          && request.resource.data.status in [
               'planning', 'active', 'reviewing', 'closed'
             ]
          && (
               !('unitLabel' in request.resource.data)
               || request.resource.data.unitLabel is string
             )
          && plcSubNullableTimeFieldOk('opensAt')
          && plcSubNullableTimeFieldOk('dueAt')
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('updatedAt')
          && (
               !('folderId' in request.resource.data)
               || request.resource.data.folderId == null
               || request.resource.data.folderId is string
             )
          // Server-written dirtyAt and the sourceQuizId pointer must round-trip
          // unchanged: clients can neither forge nor clear them.
          && request.resource.data.get('sourceQuizId', null)
               == resource.data.get('sourceQuizId', null)
          && request.resource.data.get('dirtyAt', null)
               == resource.data.get('dirtyAt', null);

        // Non-viewer member can hard-delete (PLC-owned model). Soft-delete via
        // deletedAt is typical; the orphaned aggregates/{assessmentId} doc is
        // swept by gcPlcOrphans. Viewers denied via plcCanEditContent.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC Meeting records (Decisions 4.0/4.0b) - the archived, exportable record from
      // Meeting Mode. PLC-owned: any current member authors, edits, or soft-deletes.
      // Identity (`id`), authorship (`createdBy`), `heldAt`, and `facilitatorUid` are
      // pinned post-create so a teammate's edit can't rewrite who ran the meeting or when.
      // The `decisions`/`actionItems` lists carry opaque interior maps whose shape varies;
      // CEL can't `.every()` over a list, so the rule validates the list TYPE and leans on
      // the client parser - blast radius is one membership-gated PLC's own record.
      match /meetings/{meetingId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: any non-viewer member, doc id pinned, createdBy must equal the
        // caller. A viewer (Decision 3.2) is denied via plcCanEditContent.
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'heldAt', 'facilitatorUid', 'attendeeUids',
               'assessmentIds', 'agenda', 'decisions', 'actionItems',
               'notesBody', 'status', 'createdBy', 'updatedAt', 'deletedAt'
             ])
          && request.resource.data.id == meetingId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.facilitatorUid is string
          && request.resource.data.attendeeUids is list
          && request.resource.data.assessmentIds is list
          && request.resource.data.decisions is list
          && request.resource.data.actionItems is list
          && (
               !('agenda' in request.resource.data)
               || request.resource.data.agenda is string
             )
          && (
               !('notesBody' in request.resource.data)
               || request.resource.data.notesBody is string
             )
          && request.resource.data.status in ['in-progress', 'completed']
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('heldAt')
          && plcSubTimeFieldOk('updatedAt');

        // Update: non-viewer member mutates working fields or soft-deletes via
        // deletedAt. id/createdBy/heldAt/facilitatorUid immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'heldAt', 'facilitatorUid', 'attendeeUids',
               'assessmentIds', 'agenda', 'decisions', 'actionItems',
               'notesBody', 'status', 'createdBy', 'updatedAt', 'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.heldAt == resource.data.heldAt
          && request.resource.data.facilitatorUid == resource.data.facilitatorUid
          && request.resource.data.attendeeUids is list
          && request.resource.data.assessmentIds is list
          && request.resource.data.decisions is list
          && request.resource.data.actionItems is list
          && (
               !('agenda' in request.resource.data)
               || request.resource.data.agenda is string
             )
          && (
               !('notesBody' in request.resource.data)
               || request.resource.data.notesBody is string
             )
          && request.resource.data.status in ['in-progress', 'completed']
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('updatedAt');

        // Non-viewer member can hard-delete (PLC-owned); soft-delete via deletedAt
        // is typical, tombstone GC is gcPlcOrphans. Viewers denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC Quiz Library (Phase 2). Lightweight headers pointing at canonical
      // /synced_quizzes/{groupId} docs (questions live there). Any member shares /
      // mirror-edits (title/questionCount) / unshares; orphan policy "PLC copy
      // stays". Shape locked via hasOnly([...]); identity + attribution
      // (id/syncGroupId/sharedBy*/sharedAt) immutable post-create.
      match /quizzes/{plcQuizId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: any non-viewer member (plcCanEditContent), doc id pinned,
        // sharedBy == caller. Questions live in the synced group. Optional
        // deletedAt tombstone (Decision 3.1); shape locked via hasOnly([...]).
        // Optional run-settings (sessionMode/sessionOptions/attemptLimit) are
        // the pickup defaults a teammate inherits; mirrored after each publish.
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'questionCount', 'syncGroupId',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt',
               'sessionMode', 'sessionOptions', 'attemptLimit', 'quizId',
               'folderId', 'archived'
             ])
          && plcQuizRunSettingsOk()
          && optBool(request.resource.data, 'archived')
          && plcQuizId == request.resource.data.id
          && request.resource.data.sharedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.syncGroupId is string
          // Non-empty syncGroupId (defense-in-depth; the CF also rejects empty).
          && request.resource.data.syncGroupId.size() > 0
          && request.resource.data.sharedByEmail is string
          && request.resource.data.sharedByName is string
          && request.resource.data.sharedAt is int
          && request.resource.data.updatedAt is int
          && (
               !('folderId' in request.resource.data)
               || request.resource.data.folderId == null
               || request.resource.data.folderId is string
             )
          && plcSubDeletedAtOk();

        // Update: non-viewer member mirrors title/questionCount/run-settings/
        // updatedAt or soft-deletes via deletedAt. Identity + attribution
        // immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'questionCount', 'syncGroupId',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt',
               'sessionMode', 'sessionOptions', 'attemptLimit', 'quizId',
               'folderId', 'archived'
             ])
          && plcQuizRunSettingsOk()
          && optBool(request.resource.data, 'archived')
          && request.resource.data.id == resource.data.id
          && request.resource.data.syncGroupId == resource.data.syncGroupId
          && request.resource.data.sharedBy == resource.data.sharedBy
          && request.resource.data.sharedByEmail == resource.data.sharedByEmail
          && request.resource.data.sharedByName == resource.data.sharedByName
          && request.resource.data.sharedAt == resource.data.sharedAt
          && request.resource.data.title is string
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.updatedAt is int
          && (
               !('folderId' in request.resource.data)
               || request.resource.data.folderId == null
               || request.resource.data.folderId is string
             )
          && plcSubDeletedAtOk();

        // Non-viewer member can unshare (PLC-owned model); viewers denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC folders (PLC_ASSESSMENT_DATA §3.4): shared tree for the Assessments list.
      // PLC learning targets: one array doc (`learningTargets`) per PLC, edited by
      // any non-viewer member. Cap 1,000 targets; `masteryCutoffs` is PLC-only.
      // Interior target maps are validated by the client; blast radius is one PLC.
      match /meta/{metaId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;
        allow create, update: if request.auth != null
          && metaId == 'learningTargets'
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'targets', 'masteryCutoffs', 'updatedAt'
             ])
          && request.resource.data.targets is list
          && request.resource.data.targets.size() <= 1000
          && request.resource.data.updatedAt is int
          && (
               !('masteryCutoffs' in request.resource.data)
               || (
                    request.resource.data.masteryCutoffs.keys().hasOnly([
                      'proficient', 'approaching'
                    ])
                    && request.resource.data.masteryCutoffs.proficient is int
                    && request.resource.data.masteryCutoffs.approaching is int
                    && request.resource.data.masteryCutoffs.proficient >= 0
                    && request.resource.data.masteryCutoffs.proficient <= 100
                    && request.resource.data.masteryCutoffs.approaching >= 0
                    && request.resource.data.masteryCutoffs.approaching
                         <= request.resource.data.masteryCutoffs.proficient
                  )
             );
        allow delete: if false;
      }

      // PLC question-bank headers (plan §5): pointer at /synced_question_banks/{groupId}.
      // Any non-viewer member shares; only the sharer or a lead/co-lead changes or
      // removes the row. Identity + attribution immutable post-create.
      match /question_banks/{entryId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'questionCount', 'syncGroupId', 'targetIds',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt'
             ])
          && entryId == request.resource.data.id
          && request.resource.data.sharedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.syncGroupId is string
          && request.resource.data.syncGroupId.size() > 0
          && request.resource.data.targetIds is list
          && request.resource.data.sharedByEmail is string
          && request.resource.data.sharedByName is string
          && request.resource.data.sharedAt is int
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && (
               resource.data.sharedBy == request.auth.uid
               || isPlcMembershipManager(
                    get(/databases/$(database)/documents/plcs/$(plcId)).data
                  )
             )
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'questionCount', 'syncGroupId', 'targetIds',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.syncGroupId == resource.data.syncGroupId
          && request.resource.data.sharedBy == resource.data.sharedBy
          && request.resource.data.sharedByEmail == resource.data.sharedByEmail
          && request.resource.data.sharedByName == resource.data.sharedByName
          && request.resource.data.sharedAt == resource.data.sharedAt
          && request.resource.data.title is string
          && request.resource.data.questionCount is int
          && request.resource.data.targetIds is list
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        allow delete: if request.auth != null
          && plcCanEditContent(plcId)
          && (
               resource.data.sharedBy == request.auth.uid
               || isPlcMembershipManager(
                    get(/databases/$(database)/documents/plcs/$(plcId)).data
                  )
             );
      }

      match /folders/{folderId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;
        allow create, update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'name', 'parentId', 'order', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
               request.resource.data.parentId == null
               || request.resource.data.parentId is string
             )
          && request.resource.data.order is int
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int;
        allow delete: if request.auth != null && plcCanEditContent(plcId);
      }

      // PLC Video Activity Library (Phase 4). Mirrors the quiz library —
      // headers pointing at /synced_video_activities/{groupId}. Any member
      // shares/mirror-edits/unshares; orphan policy "PLC copy stays". Extra field
      // vs quizzes: youtubeUrl (tile thumbnail); other invariants identical.
      match /video_activities/{plcVideoActivityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: non-viewer member (plcCanEditContent), doc id pinned, sharedBy ==
        // caller. Questions live in the synced group. Optional deletedAt tombstone;
        // shape locked via hasOnly([...]).
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'youtubeUrl', 'questionCount', 'syncGroupId',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt'
             ])
          && plcVideoActivityId == request.resource.data.id
          && request.resource.data.sharedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.youtubeUrl is string
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.syncGroupId is string
          // Non-empty syncGroupId (defense-in-depth; the CF also rejects empty).
          && request.resource.data.syncGroupId.size() > 0
          && request.resource.data.sharedByEmail is string
          && request.resource.data.sharedByName is string
          && request.resource.data.sharedAt is int
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        // Update: non-viewer member mirrors title/questionCount/youtubeUrl/
        // updatedAt or soft-deletes via deletedAt. Identity + attribution
        // immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'youtubeUrl', 'questionCount', 'syncGroupId',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt', 'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.syncGroupId == resource.data.syncGroupId
          && request.resource.data.sharedBy == resource.data.sharedBy
          && request.resource.data.sharedByEmail == resource.data.sharedByEmail
          && request.resource.data.sharedByName == resource.data.sharedByName
          && request.resource.data.sharedAt == resource.data.sharedAt
          && request.resource.data.title is string
          && request.resource.data.youtubeUrl is string
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount >= 0
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        // Non-viewer member can unshare (PLC-owned model); viewers denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC Rubric Library (M12 Phase 3-I). The full rubric payload is inlined (rubrics
      // are small; no synced-group indirection). Posture mirrors the Quiz Library: any
      // non-viewer member shares/mirror-edits/unshares; identity + attribution immutable
      // post-create. `criteria` is a list of complex objects CEL can't deep-validate;
      // shape locked via hasOnly([...]), interior validation is client-enforced.
      match /rubrics/{plcRubricId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'description', 'criteria',
               'createdAt', 'updatedAt',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'deletedAt'
             ])
          && plcRubricId == request.resource.data.id
          && request.resource.data.sharedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.criteria is list
          && request.resource.data.sharedByEmail is string
          && request.resource.data.sharedByName is string
          && request.resource.data.sharedAt is int
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        // Update: non-viewer member mirror-edits content fields or soft-deletes
        // via deletedAt. Identity + attribution immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'description', 'criteria',
               'createdAt', 'updatedAt',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.sharedBy == resource.data.sharedBy
          && request.resource.data.sharedByEmail == resource.data.sharedByEmail
          && request.resource.data.sharedByName == resource.data.sharedByName
          && request.resource.data.sharedAt == resource.data.sharedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title is string
          && request.resource.data.criteria is list
          && request.resource.data.updatedAt is int
          && plcSubDeletedAtOk();

        // Non-viewer member can unshare (PLC-owned model); viewers denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC-authored Assignments (Phase 3). Templates any member can pick up onto
      // their board, pointing at a canonical synced_quizzes/{groupId} (content
      // lives there). Posture mirrors the Quiz Library — any member authors /
      // mirror-updates / unshares; identity + attribution immutable. Orphan
      // policy: deleting a template doesn't cascade to already-imported personal
      // assignments.
      match /assignments/{plcAssignmentId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: non-viewer member (plcCanEditContent), doc id pinned, sharedBy ==
        // caller. sessionOptions is an opaque map (keys vary by mode); shape pinned
        // via hasOnly([...]), per-field validation is client-side.
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'quizTitle', 'quizId', 'syncGroupId',
               'sessionMode', 'sessionOptions', 'attemptLimit',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt'
             ])
          && plcAssignmentId == request.resource.data.id
          && request.resource.data.sharedBy == request.auth.uid
          && request.resource.data.quizTitle is string
          && request.resource.data.quizId is string
          && request.resource.data.syncGroupId is string
          // Guard against an empty `syncGroupId` smuggling a stub entry.
          && request.resource.data.syncGroupId.size() > 0
          && request.resource.data.sessionMode in ['teacher', 'auto', 'student']
          && request.resource.data.sessionOptions is map
          && (request.resource.data.attemptLimit == null
                || request.resource.data.attemptLimit is int)
          && request.resource.data.sharedByEmail is string
          && request.resource.data.sharedByName is string
          && request.resource.data.sharedAt is int
          && request.resource.data.updatedAt is int;

        // Update: non-viewer member mirrors title/sessionOptions/updatedAt.
        // Identity + attribution immutable; viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'quizTitle', 'quizId', 'syncGroupId',
               'sessionMode', 'sessionOptions', 'attemptLimit',
               'sharedBy', 'sharedByEmail', 'sharedByName',
               'sharedAt', 'updatedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.quizId == resource.data.quizId
          && request.resource.data.syncGroupId == resource.data.syncGroupId
          && request.resource.data.sharedBy == resource.data.sharedBy
          && request.resource.data.sharedByEmail == resource.data.sharedByEmail
          && request.resource.data.sharedByName == resource.data.sharedByName
          && request.resource.data.sharedAt == resource.data.sharedAt
          && request.resource.data.quizTitle is string
          && request.resource.data.sessionMode in ['teacher', 'auto', 'student']
          && request.resource.data.sessionOptions is map
          && (request.resource.data.attemptLimit == null
                || request.resource.data.attemptLimit is int)
          && request.resource.data.updatedAt is int;

        // Non-viewer member can unshare; already-imported personal assignments
        // keep running (independent docs). Viewers denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC shared notes (Phase 5). Collaborative notebook — any member CRUDs any
      // note; LWW via lastEditedBy/lastEditedAt. Shape locked via hasOnly([...]).
      match /notes/{noteId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: non-viewer member (plcCanEditContent). Optional fields: kind
        // ('freeform'|'meeting'), meetingId, version (Decision 2.4), deletedAt
        // tombstone — all OPTIONAL so legacy notes validate; hasOnly([...]) closes
        // the shape.
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'body', 'kind', 'meetingId', 'actionItems',
               'createdBy', 'createdAt',
               'lastEditedBy', 'lastEditedAt',
               'version', 'deletedAt', 'yState'
             ])
          && request.resource.data.id == noteId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.lastEditedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.body is string
          && (
               !('kind' in request.resource.data)
               || request.resource.data.kind in ['freeform', 'meeting']
             )
          && (
               !('meetingId' in request.resource.data)
               || request.resource.data.meetingId == null
               || request.resource.data.meetingId is string
             )
          && (
               !('actionItems' in request.resource.data)
               || (request.resource.data.actionItems is list
                    && request.resource.data.actionItems.size() <= 200)
             )
          && (
               !('yState' in request.resource.data)
               || request.resource.data.yState is string
             )
          // A fresh note may omit `version` (legacy/no-version) or start it at
          // an int (clients seed 0/1). The update branch enforces the +1 bump.
          && (
               !('version' in request.resource.data)
               || request.resource.data.version is int
             )
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('createdAt')
          && plcSubTimeFieldOk('lastEditedAt');

        // Update: any non-viewer member edits any note; id/createdBy/createdAt
        // immutable, editor stamps lastEditedBy. Optimistic concurrency (Decision
        // 2.4): incoming version must be old+1 (stale writer is rejected → conflict
        // toast); during rollout both-absent version is also accepted. Viewers
        // denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'body', 'kind', 'meetingId', 'actionItems',
               'createdBy', 'createdAt',
               'lastEditedBy', 'lastEditedAt',
               'version', 'deletedAt', 'yState'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.lastEditedBy == request.auth.uid
          && plcSubTimeFieldOk('lastEditedAt')
          && request.resource.data.title is string
          && request.resource.data.body is string
          && (
               !('kind' in request.resource.data)
               || request.resource.data.kind in ['freeform', 'meeting']
             )
          && (
               !('meetingId' in request.resource.data)
               || request.resource.data.meetingId == null
               || request.resource.data.meetingId is string
             )
          && (
               !('actionItems' in request.resource.data)
               || (request.resource.data.actionItems is list
                    && request.resource.data.actionItems.size() <= 200)
             )
          && (
               !('yState' in request.resource.data)
               || request.resource.data.yState is string
             )
          && plcSubDeletedAtOk()
          // Version precondition: new == old + 1, OR both absent (rollout).
          && (
               (
                 'version' in request.resource.data
                 && 'version' in resource.data
                 && request.resource.data.version == resource.data.version + 1
               )
               || (
                 !('version' in request.resource.data)
                 && !('version' in resource.data)
               )
             );

        // Non-viewer member can delete (PLC-owned, not creator-owned); viewers
        // denied.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);

        // Yjs CRDT update log — one base64 update per doc, replayed on top of
        // the note's compacted `yState`. Append-only for clients: an update is
        // never rewritten, only deleted once compaction has folded it into the
        // snapshot. Shape locked via hasOnly([...]); `uid` is the author so a
        // member can't forge a teammate's update.
        match /yUpdates/{updateId} {
          allow read: if request.auth != null
            && request.auth.uid in get(
                 /databases/$(database)/documents/plcs/$(plcId)
               ).data.memberUids;

          allow create: if request.auth != null
            && plcCanEditContent(plcId)
            && request.resource.data.keys().hasOnly(['u', 'uid', 'at'])
            && request.resource.data.u is string
            && request.resource.data.u.size() <= 200000
            && request.resource.data.uid == request.auth.uid
            && plcSubTimeFieldOk('at');

          allow update: if false;

          allow delete: if request.auth != null
            && plcCanEditContent(plcId);
        }
      }

      // PLC shared Google Docs. Lightweight pointers — the doc content
      // lives in Google, not here. Any current member can CRUD.
      match /docs/{docId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Create: non-viewer member (plcCanEditContent). Optional deletedAt
        // tombstone; shape locked via hasOnly([...]).
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'url',
               'createdBy', 'createdByName', 'createdAt', 'updatedAt',
               'deletedAt'
             ])
          && request.resource.data.id == docId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.url is string
          && request.resource.data.createdByName is string
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('createdAt')
          && plcSubTimeFieldOk('updatedAt');

        // A viewer (Decision 3.2) is denied via plcCanEditContent.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'url',
               'createdBy', 'createdByName', 'createdAt', 'updatedAt',
               'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title is string
          && request.resource.data.url is string
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('updatedAt');

        // A viewer (Decision 3.2) is denied via plcCanEditContent.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC shared to-do list (Phase 5). One doc per todo (concurrent toggles
      // don't serialize). Any member CRUDs any todo.
      match /todos/{todoId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // Legacy; imported into note action items (§7.4) — no new to-dos.
        allow create: if false;

        // Legacy; only the soft-delete tombstone may still be written (§7.4) —
        // used to archive a to-do once it's been imported into a note.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
          && plcSubDeletedAtOk();

        // A viewer (Decision 3.2) is denied via plcCanEditContent.
        allow delete: if request.auth != null
          && plcCanEditContent(plcId);
      }

      // PLC presence (Decision 2.1, §3.3). Per-section "who's here": each member
      // heartbeats their OWN doc (id == uid) ~45s. Any member reads all presence
      // docs; a member writes only their own (presenceUid == auth.uid), so nobody
      // spoofs a teammate. Shape locked via hasOnly([...]); lastActiveAt
      // dual-accepts int||timestamp. Stale-doc GC is gcPlcOrphans, not these rules.
      match /presence/{presenceUid} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        allow create, update: if request.auth != null
          && request.auth.uid == presenceUid
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids
          && request.resource.data.keys().hasOnly([
               'uid', 'displayName', 'section', 'lastActiveAt'
             ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.section is string
          && (
               request.resource.data.lastActiveAt is int
               || request.resource.data.lastActiveAt is timestamp
             );

        // A member may clear their own presence on unmount / sign-out.
        allow delete: if request.auth != null
          && request.auth.uid == presenceUid;
      }

      // PLC activity log (Decision 2.2, §3.4). Append-only event feed written
      // fire-and-forget. Any member reads; any member creates an event but only
      // one whose actorUid == their uid (no forging). Clients never update/delete
      // (immutable; ~90d trimming is gcPlcOrphans). Shape locked via hasOnly([...]);
      // type pinned to the PlcActivityType union; optional target* validated.
      match /activity/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        allow create: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids
          && request.resource.data.keys().hasOnly([
               'id', 'type', 'actorUid', 'actorName',
               'targetType', 'targetId', 'targetTitle', 'createdAt'
             ])
          && request.resource.data.id == eventId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type in [
               'member_joined', 'member_left', 'role_changed',
               'assessment_created', 'assessment_shared',
               'assessment_results_ready', 'meeting_held',
               'note_created', 'comment_added',
               'item_deleted', 'item_restored', 'paper_printed'
             ]
          && request.resource.data.actorName is string
          && (
               !('targetType' in request.resource.data)
               || request.resource.data.targetType is string
             )
          && (
               !('targetId' in request.resource.data)
               || request.resource.data.targetId is string
             )
          && (
               !('targetTitle' in request.resource.data)
               || request.resource.data.targetTitle is string
             )
          && plcSubTimeFieldOk('createdAt');

        // No client update/delete — see the block comment above (Wave-4 GC).
        allow update, delete: if false;
      }

      // PLC comments + @mentions (Decision 2.6, §3.5). Scoped to dataCard /
      // assessment / note targets. Any member reads. Create: any member, authorUid
      // == caller, id pinned, schema locked. Update: author may edit body/editedAt
      // and/or soft-delete; any member may flip deletedAt; identity/attribution/
      // targeting/mentions immutable. Hard-delete is gcPlcOrphans.
      match /comments/{commentId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(plcId)
             ).data.memberUids;

        // A viewer (Decision 3.2) is denied content writes via plcCanEditContent
        // (reads stay open above).
        allow create: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'targetType', 'targetId',
               'authorUid', 'authorName', 'body', 'mentions',
               'createdAt', 'editedAt', 'deletedAt'
             ])
          && request.resource.data.id == commentId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.targetType in ['dataCard', 'assessment', 'note']
          && request.resource.data.targetId is string
          && request.resource.data.authorName is string
          && request.resource.data.body is string
          && request.resource.data.mentions is list
          && (
               !('editedAt' in request.resource.data)
               || request.resource.data.editedAt == null
               || request.resource.data.editedAt is int
               || request.resource.data.editedAt is timestamp
             )
          && plcSubDeletedAtOk()
          && plcSubTimeFieldOk('createdAt');

        // Update: identity/attribution/targeting/mentions immutable. Author edits
        // body/editedAt and/or soft-deletes; any non-viewer may flip deletedAt (a
        // non-author can only ever change deletedAt). Viewers denied.
        allow update: if request.auth != null
          && plcCanEditContent(plcId)
          && request.resource.data.keys().hasOnly([
               'id', 'targetType', 'targetId',
               'authorUid', 'authorName', 'body', 'mentions',
               'createdAt', 'editedAt', 'deletedAt'
             ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.mentions == resource.data.mentions
          && request.resource.data.body is string
          && (
               !('editedAt' in request.resource.data)
               || request.resource.data.editedAt == null
               || request.resource.data.editedAt is int
               || request.resource.data.editedAt is timestamp
             )
          && plcSubDeletedAtOk()
          // Only the author may change body/editedAt; a non-author update must
          // leave body + editedAt untouched (i.e. it may only flip deletedAt).
          && (
               request.auth.uid == resource.data.authorUid
               || (
                 request.resource.data.body == resource.data.body
                 && request.resource.data.get('editedAt', null)
                      == resource.data.get('editedAt', null)
               )
             );

        // Hard delete is server-only (GC). Clients soft-delete via `deletedAt`.
        allow delete: if false;
      }
    }

    match /plc_invitations/{inviteId} {
      // Invitee sees their own invites; the inviter sees the ones they sent (for
      // the sidebar "Pending invites" / "Outstanding invitations" panels).
      // email_verified is REQUIRED on the invitee branch, same reason as isAdmin()
      // above — otherwise an unverified self-reported email would let an attacker
      // read an invite addressed to someone else's inbox.
      allow read: if request.auth != null
        && request.auth.token.get('email', '') != ''
        && (
          (request.auth.token.get('email_verified', false) == true
            && resource.data.inviteeEmailLower == request.auth.token.email.lower())
          || request.auth.uid == resource.data.invitedByUid
        );

      // Lead of the target PLC creates (or re-creates) the invite. The doc
      // id is forced to the deterministic format so isAcceptingPlcInvite
      // can verify by id without a query.
      allow create, update: if request.auth != null
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.inviteeEmailLower is string
        && request.resource.data.inviteeEmailLower.size() <= 255
        // Lead OR co-lead may invite — membership management mirrors the
        // role-change / remove / transfer actions co-leads already perform
        // (Decision 1.2). isPlcMembershipManager reads the members map (falling
        // back to the denormalized leadUid mirror) so it covers both shapes.
        && isPlcMembershipManager(get(/databases/$(database)/documents/plcs/$(request.resource.data.plcId)).data)
        && inviteId == plcInviteDocId(request.resource.data.plcId, request.resource.data.inviteeEmailLower)
        // Schema lock (L-1): pin the invite doc shape so a manager can't inject
        // arbitrary fields future code/rules might trust. `orgId` is optional.
        && request.resource.data.keys().hasOnly([
             'plcId', 'plcName', 'inviteeEmailLower', 'invitedByUid',
             'invitedByName', 'invitedAt', 'status', 'orgId'
           ]);

      // Invitee patches only status + respondedAt to accept/decline. Status must
      // go pending → terminal (no resurrecting to pending or arbitrary strings).
      // The invitee never deletes; the lead revokes, accepted invites kept for audit.
      // email_verified is REQUIRED, same reason as isAdmin() above — otherwise an
      // unverified self-reported email lets an attacker accept/decline an invite
      // addressed to someone else.
      allow update: if request.auth != null
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true
        && resource.data.inviteeEmailLower == request.auth.token.email.lower()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Lead/co-lead can revoke (delete) invites; the inviter can always delete
      // their own (also cleans up orphans if the parent PLC is gone).
      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.invitedByUid
          // Any membership manager (lead OR co-lead) can revoke an invite, not
          // only the original inviter — mirrors the create gate (Decision 1.2).
          || isPlcMembershipManager(get(/databases/$(database)/documents/plcs/$(resource.data.plcId)).data)
        );
    }

    // Sessions - Teacher owns it, Students can join
    match /sessions/{userId} {
      // Only authenticated users (including anonymous) can read sessions
      // This allows students to find sessions by code and listen to updates.
      // Also relied on by hooks/useLiveSession.ts's allocateSessionCode()
      // for its collision check — narrowing this will break it too.
      // TODO: For Phase 2/Production, implement Cloud Functions to validate
      // join codes server-side and remove this broad read permission.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId; // Teacher controls it

      match /students/{studentId} {
        // Student session records store only a PIN - no PII. The anonymous auth UID is the
        // doc ID so rules can validate ownership without server-side logic. Authed users
        // read (PIN duplicate checks); students create/update only their own record
        // (heartbeats/disconnects); only teacher and admins delete.
        allow read: if request.auth != null;
        // Matches the client's exact write shape (useLiveSession.ts `newStudent`) - without
        // it, any caller who learns a sessionId could spray unbounded arbitrary-shape docs
        // into a teacher's live roster. pin is capped at MAX_PIN_LENGTH (10).
        // Not enforced: cross-document PIN uniqueness (needs a transaction or CF); tracked
        // in firestore-rules.md.
        function isValidLiveStudentPayload(data) {
          return data.keys().hasOnly(['pin', 'status', 'joinedAt', 'lastActive']) &&
            data.pin is string && data.pin.size() > 0 && data.pin.size() <= 10 &&
            data.status in ['active', 'frozen', 'disconnected'] &&
            data.joinedAt is int && data.joinedAt > 0 &&
            data.lastActive is int && data.lastActive > 0;
        }
        allow create: if request.auth != null &&
          request.auth.uid == studentId &&
          isValidLiveStudentPayload(request.resource.data);
        // Teacher/admin may set `status` to any value (freeze control, disconnect sweep).
        // The owning student may only mark themselves disconnected - letting them set
        // 'active'/'frozen' would allow self-unfreeze via a bare status-only write. The
        // student also rejoins by re-writing the full shape over an existing doc
        // (joinSession's setDoc, evaluated as an update), blocked while frozen and pinned
        // to 'active', so a fabricated rejoin can't escape a freeze or self-freeze.
        allow update: if request.auth != null &&
          (
            ((request.auth.uid == userId || isAdmin()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
             request.resource.data.status in ['active', 'frozen', 'disconnected']) ||
            (request.auth.uid == studentId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
             request.resource.data.status == 'disconnected') ||
            (request.auth.uid == studentId &&
             resource.data.status != 'frozen' &&
             request.resource.data.status == 'active' &&
             isValidLiveStudentPayload(request.resource.data))
          );
        allow delete: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    // Per-student assignment pointers (M17). One doc per (student, assignment), written
    // EXCLUSIVELY by setAssignmentTargetsV1 and the deletion cleanup triggers via Admin
    // SDK - no client write path exists (the pseudonym uid derivation needs the
    // server-only HMAC secret). Reads (get AND list) are gated on the {studentUid} path
    // segment plus the studentRole claim, so a student's own listener works and nobody
    // can enumerate another student's items.
    // NON-GOAL, recorded deliberately: nothing may query /student_assignments per-student
    // ACROSS assignments. Teacher surfaces resolve identity through the per-assignment
    // pseudonym functions, which preserves cross-assignment unlinkability. A
    // collectionGroup query on `items` is denied by omission.
    match /student_assignments/{studentUid} {
      allow read, write: if false;

      match /items/{assignmentId} {
        allow read: if request.auth != null &&
          request.auth.uid == studentUid &&
          isStudentRoleUser();
        allow write: if false;
      }
    }

    // Server-time clock-skew probe (M17 §3a-D / utils/serverTime.ts). Any
    // signed-in user (teacher or student) may write/read only their own
    // scratch doc — used solely to diff a serverTimestamp() round-trip
    // against local Date.now() and derive an approximate offset. No PII,
    // no cross-user access.
    match /server_time_probe/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['at']) &&
        request.resource.data.at == request.time;
    }

    // Quiz join-code -> session pointers. One doc per (code, session), written by
    // the owning teacher alongside the session itself.
    //
    // Why this collection exists: the PIN join flow has to turn a 6-char code into
    // a session id, and it used to do that with where('code','==',code) against
    // quiz_sessions. A `list` rule is evaluated ONCE against the query with an EMPTY
    // resource, so it cannot prove that a filter on `code` was supplied — which is
    // why quiz_sessions still answers `list` to any authed caller (see the note
    // there). Here the code is a PATH segment, so the same lookup is provable by
    // construction: the caller had to know the code to address the collection at all.
    //
    // Reads are open to any authed caller INCLUDING anonymous, because K-2 students
    // have no account to sign in with and reach their quiz by PIN. Knowing the code
    // IS the gate, exactly as it was before.
    match /quiz_join_codes/{code} {
      // Nothing is stored on the parent doc; the pointers live in /sessions.
      allow read, write: if false;

      match /sessions/{sessionId} {
        allow get, list: if request.auth != null;
        // Owner-only, doc id == session id, and no free-form storage.
        allow create: if request.auth != null &&
          request.auth.token.firebase.sign_in_provider != 'anonymous' &&
          code.matches('^[A-Z0-9]{1,16}$') &&
          request.resource.data.keys().hasOnly(['sessionId', 'teacherUid', 'createdAt']) &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.teacherUid == request.auth.uid &&
          request.resource.data.createdAt is int;
        // Immutable: an update could re-aim a live code at a different session,
        // which is the one thing this collection must never let anyone do.
        // Re-pointing is a delete + create, both owner-gated.
        allow update: if false;
        // `resource == null` makes deleting a pointer that was never written a
        // no-op. deleteAssignment batches this atomically with the session and
        // assignment deletes, and every session predating this collection has no
        // pointer — without it, dereferencing the null resource throws, the batch
        // is denied, and deleting a quiz breaks until the backfill has run.
        allow delete: if request.auth != null && (
          resource == null ||
          resource.data.teacherUid == request.auth.uid
        );
      }
    }

    // Quiz Sessions — keyed by session UUID (was teacherUid). The teacher
    // owns the document and stores their uid on the `teacherUid` field.
    // Multiple concurrent sessions per teacher are allowed.
    match /quiz_sessions/{sessionId} {
      // Reads are intentionally permissive: any authed caller can get/list session docs.
      // studentRole class gating is enforced on the response WRITE rules below (runtime
      // get() of the parent classId), not on read - students see session metadata by id
      // but can't submit outside their classIds. Privacy: a sessionId is an unguessable
      // v4 UUID and the doc exposes no PII (answer-key stripped).
      allow read: if request.auth != null;
      // NOTE: `list` is NOT scoped here yet, unlike the other session collections.
      // The PIN join flow queries this collection by join code
      // (`where('code','==',code)`) as an ANONYMOUS student, and a list rule is
      // evaluated against the query with an empty resource — it cannot prove that
      // a filter on `code` was supplied.
      //
      // The `quiz_join_codes` lookup above now resolves a code without that query,
      // so this IS closable: split into `allow get` plus
      // `allow list: if request.auth != null && sessionListScoped();` — the same
      // shape as the four collections below, verified against the emulator. It
      // waits on every production browser reaching the new join path and on the
      // live sessions being backfilled, because a merge to a dev-* branch ships
      // these rules to production while the client only reaches a preview channel.
      // Sequence: docs/plans/QUIZ_JOIN_CODE_LOOKUP.md.
      // Only the teacher (session owner) can create/update/delete the session document.
      // Ownership is carried on the `teacherUid` field (no longer the doc id).
      // PLC pooling link (docs/plans/PLC_ASSESSMENT_DATA.md §4): a session may
      // carry plcId + syncGroupId only for a PLC the caller belongs to. Writes are
      // already owner-only, so set/clear of plcId stays teacher-only. `.get()`
      // everywhere so a missing field denies instead of throwing.
      function plcLinkOk(d) {
        return d.get('plcId', '') is string && d.get('plcId', '').size() > 0
          && d.get('syncGroupId', '') is string && d.get('syncGroupId', '').size() > 0
          && request.auth.uid in get(
               /databases/$(database)/documents/plcs/$(d.plcId)
             ).data.memberUids;
      }
      allow create: if request.auth != null &&
        request.resource.data.teacherUid == request.auth.uid &&
        (!('plcId' in request.resource.data) || plcLinkOk(request.resource.data));
      // Update: an unchanged or cleared plcId needs no PLC read; a new/changed
      // non-null plcId re-runs the membership gate.
      allow update: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid &&
        (request.resource.data.get('plcId', null) == resource.data.get('plcId', null) ||
         request.resource.data.get('plcId', null) == null ||
         plcLinkOk(request.resource.data));
      allow delete: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;

      match /responses/{responseKey} {
        // Quiz response records store only a PIN - no name/email. {responseKey} equals the
        // student uid for SSO joiners, or `pin-{classPeriod}-{pin}` for anonymous joiners
        // (so the attempt cap survives storage resets), so ownership compares the
        // `studentUid` field, not the key. Teacher ownership is read from the parent session.
        // LO4: all session-field helpers below read off ONE sessionData() snapshot.
        function sessionData() {
          return get(/databases/$(database)/documents/quiz_sessions/$(sessionId)).data;
        }
        function sessionTeacherUid() {
          return sessionData().teacherUid;
        }
        function sessionClassId() {
          return sessionData().get('classId', '');
        }
        function sessionClassIds() {
          return sessionData().get('classIds', []);
        }
        // Defense in depth — block response writes on view-only sessions.
        // Pre-feature sessions without a `mode` field default to 'submissions'.
        function sessionMode() {
          return sessionData().get('mode', 'submissions');
        }
        // Server-side attempt cap (last line of defense vs a race/buggy/hostile
        // client; the client also enforces it). null = no cap.
        function sessionAttemptLimit() {
          return sessionData().get('attemptLimit', null);
        }
        // Two pre-existing student flows legitimately write AFTER closeAt and
        // must not regress: the published-results anti-screenshot counters, and
        // a teacher-granted extension (`unlocked: true`, cleared by the student
        // on completion). Both are exempted from the close gate below.
        function isResultsProtectionOnlyWrite() {
          return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['resultsTabWarnings', 'resultsLockedOut', 'resultsLockedOutAt']);
        }

        // Student branch allows resource == null so the join flow can probe via
        // getDoc() before create/resume (else a Null-value throw on studentUid).
        // The class gate stays a hard prerequisite so a studentRole user can't
        // probe a session they're not enrolled in (anon PIN passes by definition).
        allow read: if request.auth != null && (
          request.auth.uid == sessionTeacherUid() ||
          isAdmin() ||
          (passesStudentClassGateCompat(sessionClassIds(), sessionClassId()) &&
           (resource == null || request.auth.uid == resource.data.studentUid))
        );
        // Create runs only when the doc is absent, so the deterministic key gives
        // one-doc-per-roster-student. Field ownership: auth.uid == studentUid. SSO writers
        // use responseKey == auth.uid; anon PIN writers use `pin-{encodedPeriod}-{encodedPin}`.
        // Same-PIN+period classmate grief isn't fully preventable (shared secret);
        // cross-auth-type paths are closed.
        allow create: if request.auth != null &&
          request.resource.data.studentUid == request.auth.uid &&
          // If supplied, lastWriteAt must be server-stamped (== request.time).
          // Optional (legacy joins/fixtures); worst case it's missed by the idle
          // auto-submit sweep, not data loss.
          (request.resource.data.get('lastWriteAt', null) == null ||
           request.resource.data.lastWriteAt == request.time) &&
          // Students cannot forge a score on creation
          request.resource.data.score == null &&
          // Students cannot forge prior completions
          request.resource.data.get('completedAttempts', 0) == 0 &&
          // preSyncVersion must be 0 at create so syncAssignmentToLatest's
          // where('preSyncVersion','==',0) query catches the row; a forged value
          // (e.g. 999) would dodge sync tagging. Tags are teacher-written.
          request.resource.data.get('preSyncVersion', 0) == 0 &&
          // Block forging teacher/cron-only fields at create (autoSubmitted,
          // unlocked, unlockedAt, grading.*). Explicit denials; the UPDATE rule's
          // hasOnly whitelist is the source of truth for the student's surface.
          request.resource.data.get('autoSubmitted', null) == null &&
          request.resource.data.get('unlocked', null) == null &&
          request.resource.data.get('unlockedAt', null) == null &&
          request.resource.data.get('grading', null) == null &&
          // servedQuestionIds is stamped on UPDATE (answer writes), where it
          // is validated against the student's own pointer doc. Blocking it
          // at create stops a forged subset riding in on the join write.
          request.resource.data.get('servedQuestionIds', null) == null &&
          // Per-student publication and the answer key are teacher-written only.
          request.resource.data.get('resultsOverride', null) == null &&
          request.resource.data.get('revealedAnswers', null) == null &&
          // studentRole users must be enrolled in the session's class
          passesStudentClassGateCompat(sessionClassIds(), sessionClassId()) &&
          // Block submissions on view-only sessions (mode is frozen at creation)
          sessionMode() == 'submissions' &&
          // Block joins after the assignment's close time (M17).
          beforeClose(sessionData()) &&
          // Block joins before the assignment's open time (M17).
          afterOpen(sessionData()) &&
          (isStudentRoleUser()
            ? responseKey == request.auth.uid
            : responseKey.matches('^pin-[a-z0-9_]{1,64}-[a-z0-9_]{1,64}$'));
        allow update: if request.auth != null && (
          // Teacher and admins can update any field
          request.auth.uid == sessionTeacherUid() || isAdmin() ||
          // Students update only their own response (ownership via studentUid, not the key).
          // Mutable: answers, status, submittedAt, tabSwitchWarnings, completedAttempts,
          // classPeriod, score (reset to null on rejoin). pin/join metadata immutable.
          // Monotonic: tabSwitchWarnings, completedAttempts. Students may only write null to score.
          (request.auth.uid == resource.data.studentUid &&
           passesStudentClassGateCompat(sessionClassIds(), sessionClassId()) &&
           // Student writes stop at the session close time (M17). The teacher
           // branch above is unaffected — grading continues after close.
           (beforeClose(sessionData()) ||
            isResultsProtectionOnlyWrite() ||
            resource.data.get('unlocked', false) == true) &&
           request.resource.data.studentUid == resource.data.studentUid &&
           // SSO studentRole responses omit `pin` entirely, so direct dot-access on
           // `resource.data.pin` would throw a Null-value error and deny the write. Use
           // `.get(_, null)` so the immutability check tolerates the field being absent on
           // both sides - the `hasOnly([...])` clause below still blocks adding/changing it.
           request.resource.data.get('pin', null) == resource.data.get('pin', null) &&
           request.resource.data.get('joinedAt', null) == resource.data.get('joinedAt', null) &&
           // Score may stay unchanged OR transition to null (rejoin reset). Students can never
           // write a non-null score they didn't already have - blocks forgery while allowing
           // mid-quiz writes (null on both sides) and post-publish results-protection writes
           // (score unchanged from the graded value).
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['score']) ||
            request.resource.data.score == null) &&
           // Students may only ever write `0` to `preSyncVersion`. The rejoin path resets it to
           // 0 so a previously-tagged response re-enters the untagged pool that
           // syncAssignmentToLatest queries. Arbitrary values would let a student forge a tag
           // to dodge future sync tagging, mirroring the create-time constraint above.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['preSyncVersion']) ||
            request.resource.data.preSyncVersion == 0) &&
           // NOTE: `grading` (and everything under it) is deliberately ABSENT from this
           // whitelist. The teacher branch above is unrestricted, so teachers write
           // `grading.<questionId>` via dotted field paths; any student write touching
           // `grading.*` is rejected by this hasOnly([...]). See
           // docs/written-response-quiz-questions.md section 9.
           // `backTranslations` is excluded for the same reason: the teacher-owner
           // path writes machine back-translations of a student's own answer, and a
           // student must never be able to forge or edit one.
           // Use `affectedKeys()` (added + removed + changed), not `changedKeys()` - the latter
           // only covers keys present on BOTH sides, so a smuggled NEW field would land in
           // addedKeys and bypass the whitelist entirely.
           request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['answers', 'status', 'submittedAt', 'tabSwitchWarnings', 'completedAttempts', 'classPeriod', 'score', 'preSyncVersion', 'unlocked', 'resultsTabWarnings', 'resultsLockedOut', 'resultsLockedOutAt', 'lastWriteAt', 'handRaisedAt', 'stimulusPlays', 'stimulusErrors', 'servedQuestionIds', 'recordingNoticeAckedAt']) &&
           // M17 served-subset snapshot: a student may only stamp
           // servedQuestionIds when it exactly equals the override subset the
           // setAssignmentTargetsV1 CF fanned out to their own pointer doc —
           // anything else would let a hostile client shrink the scoring
           // denominator. Clearing the field (mid-attempt override removal)
           // is always allowed.
           // Bank-slot sessions (plan §4.4): the student app draws its own subset,
           // so the doc only pins the size to totalQuestions (fixed + every slot
           // count) - a client can pick which pool questions it sees but never
           // shrink the scoring denominator.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['servedQuestionIds']) ||
            request.resource.data.get('servedQuestionIds', null) == null ||
            (sessionData().get('bankSlots', null) != null &&
             request.resource.data.servedQuestionIds is list &&
             request.resource.data.servedQuestionIds.size() == sessionData().totalQuestions) ||
            (sessionData().get('assignmentId', '') != '' &&
             exists(/databases/$(database)/documents/student_assignments/$(request.auth.uid)/items/$(sessionData().assignmentId)) &&
             request.resource.data.servedQuestionIds ==
               get(/databases/$(database)/documents/student_assignments/$(request.auth.uid)/items/$(sessionData().assignmentId)).data.get('override', {}).get('questionIds', null))) &&
           // Stimulus telemetry maps (per-attempt play + load-failure counters). Truthfulness
           // is client-enforced diagnostics, not a security boundary - but size is: the teacher
           // monitor reads every response doc in the session, so cap the key count to stop a
           // student inflating their doc toward the 1 MB limit with junk keys.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stimulusPlays']) ||
            (request.resource.data.stimulusPlays is map &&
             request.resource.data.stimulusPlays.keys().size() <= 200)) &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stimulusErrors']) ||
            (request.resource.data.stimulusErrors is map &&
             request.resource.data.stimulusErrors.keys().size() <= 100)) &&
           // `handRaisedAt` must be server-stamped when raising, or null when
           // the student lowers their own hand — never a client timestamp.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['handRaisedAt']) ||
            request.resource.data.handRaisedAt == request.time ||
            request.resource.data.handRaisedAt == null) &&
           // `recordingNoticeAckedAt` (Tennessen notice ack, #2737) is a
           // client epoch-ms stamp, not server-stamped, so it can't be
           // pinned to `request.time` like its siblings above — but it must
           // still be a real positive timestamp, not an arbitrary
           // string/map/sentinel a student could smuggle into a doc the
           // teacher monitor reads for every response in the session.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['recordingNoticeAckedAt']) ||
            (request.resource.data.recordingNoticeAckedAt is int &&
             request.resource.data.recordingNoticeAckedAt > 0)) &&
           // `lastWriteAt` is the idle-auto-submit cutoff and must be server-stamped
           // (serverTimestamp(), which resolves to request.time at evaluation), NOT a client
           // Date.now(). Equality with request.time enforces that: a raw Timestamp or number is
           // rejected. Closes the clock-skew failure modes - past-clock devices can't be
           // force-finalized early, future-clock devices can't evade idle auto-submit.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastWriteAt']) ||
            request.resource.data.lastWriteAt == request.time) &&
           // Students may only ever CLEAR the unlock flag (write `false`)
           // — never set it to true. The teacher's unlock action sets
           // `unlocked: true`; `completeQuiz` clears it back to false
           // when the resumed attempt is finalized.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlocked']) ||
            request.resource.data.get('unlocked', false) == false) &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tabSwitchWarnings']) ||
            request.resource.data.tabSwitchWarnings >= resource.data.get('tabSwitchWarnings', 0)) &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAttempts']) ||
            request.resource.data.get('completedAttempts', 0) >= resource.data.get('completedAttempts', 0)) &&
           // Results-view screenshot-protection guards. useResultsTabWarnings increments
           // `resultsTabWarnings` on each visibility/blur round-trip and flips
           // `resultsLockedOut` (+ `resultsLockedOutAt`) at the threshold. Both monotonic from
           // the student side; only the teacher can decrement warnings or clear the lockout.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resultsTabWarnings']) ||
            request.resource.data.get('resultsTabWarnings', 0) >= resource.data.get('resultsTabWarnings', 0)) &&
           // `resultsLockedOut` may only stay the same OR transition false→true.
           // A student-side write of `true→false` (self-unlock) is rejected.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resultsLockedOut']) ||
            (resource.data.get('resultsLockedOut', false) == false ||
             request.resource.data.get('resultsLockedOut', false) == true)) &&
           // Attempt-cap: completedAttempts ≤ attemptLimit (null = unlimited),
           // else a hostile client could increment past the cap.
           (sessionAttemptLimit() == null ||
            request.resource.data.get('completedAttempts', 0) <= sessionAttemptLimit()) &&
           // Status-transition gate: blocks 'completed' → 'completed' (re-complete
           // via race/bug). Submitting goes joined/in-progress → completed; rejoin
           // goes completed → joined. Only fires when the update touches status, so
           // status-untouched writes pass even on an already-completed doc.
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            resource.data.get('status', '') != 'completed' ||
            request.resource.data.get('status', '') != 'completed'))
        );
        allow delete: if request.auth != null &&
          (request.auth.uid == sessionTeacherUid() || isAdmin());

        // Append-only snapshot log of overwritten answers — captures a prior
        // answers[i] before it's replaced (see submitAnswer in useQuizSession.ts),
        // to recover text lost to a race or post-lockout retype. Throttled on the
        // client; the rule pins the doc shape against arbitrary dumps.
        match /history/{historyId} {
          function parentStudentUid() {
            return get(/databases/$(database)/documents/quiz_sessions/$(sessionId)/responses/$(responseKey)).data.studentUid;
          }
          // Read: teacher, admin, or the owning student.
          allow read: if request.auth != null && (
            isAdmin() ||
            request.auth.uid == sessionTeacherUid() ||
            request.auth.uid == parentStudentUid()
          );
          // Create: only the owning student of the parent response; strict shape;
          // snapshotAt == request.time forces server stamping.
          allow create: if request.auth != null &&
            request.auth.uid == parentStudentUid() &&
            request.resource.data.keys().hasOnly(
              ['questionId', 'answer', 'answeredAt', 'status', 'snapshotAt']
            ) &&
            request.resource.data.questionId is string &&
            request.resource.data.answer is string &&
            request.resource.data.answeredAt is number &&
            request.resource.data.status in ['draft', 'submitted'] &&
            request.resource.data.snapshotAt == request.time;
          // Immutable from clients. Teachers/admins may clean up.
          allow update: if false;
          allow delete: if request.auth != null &&
            (request.auth.uid == sessionTeacherUid() || isAdmin());
        }
      }

      // Archived responses — copies of teacher-removed responses (was a hard
      // delete). Frees the deterministic key for a fresh rejoin while preserving
      // partial answers for teacher recovery. Students never read archives. Idle
      // auto-submit doesn't archive (those stay in /responses, autoSubmitted:true).
      match /archived_responses/{responseKey} {
        function sessionTeacherUidArch() {
          return get(/databases/$(database)/documents/quiz_sessions/$(sessionId)).data.teacherUid;
        }
        allow read: if request.auth != null && (
          request.auth.uid == sessionTeacherUidArch() || isAdmin()
        );
        // Teacher or admin can archive (symmetric with the parent delete rule,
        // else an admin's archive+delete batch rolls back). archivedBy ==
        // auth.uid (no proxy writes); archiveReason constrained to a small set.
        allow create: if request.auth != null &&
          (request.auth.uid == sessionTeacherUidArch() || isAdmin()) &&
          request.resource.data.archivedBy == request.auth.uid &&
          request.resource.data.archivedAt is number &&
          request.resource.data.get('archiveReason', '') in
            ['teacher-removed', 'session-ended', 'idle-auto-submit-failed'];
        // Archive is otherwise immutable from the client. Future
        // cleanup (delete after N days) will run via admin SDK only.
        allow update, delete: if isAdmin();
      }

      // View tracking for view-only Share links — each pageview appends an
      // immutable {viewedAt} doc; the teacher's archive counts via
      // getCountFromServer() ("URL opens", refresh-inflation accepted). Create
      // requires the parent session to exist AND be view-only (no metric spam).
      match /views/{viewId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          get(/databases/$(database)/documents/quiz_sessions/$(sessionId)).data.teacherUid == request.auth.uid
        );
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['viewedAt']) &&
          request.resource.data.viewedAt is timestamp &&
          exists(/databases/$(database)/documents/quiz_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/quiz_sessions/$(sessionId)).data.get('mode', 'submissions') == 'view-only';
        allow update, delete: if false;
      }
    }

    // Quiz Attempt Ledger — top-level cross-launch attempt counter per
    // (ASSIGNMENT, student), not per quiz template. Doc id
    // `${assignmentId}__${studentUid}`; studentUid field must equal the caller's
    // auth uid (rules can't split the id). Writes happen inside completeQuiz, so
    // the append-only completedAttempts invariant is the last line of defense
    // against rollback; removeStudent deletes the ledger atomically.
    match /quiz_attempt_ledger/{ledgerId} {
      // resource == null short-circuit lets the join flow probe via getDoc()
      // before first-completion create (else a Null-value throw on teacherUid).
      // The student pseudonym uid is an opaque HMAC, so probing another's path
      // isn't realistic without already knowing that uid.
      allow read: if request.auth != null && (
        resource == null ||
        isAdmin() ||
        request.auth.uid == resource.data.teacherUid ||
        request.auth.uid == resource.data.studentUid
      );
      // Student creates their own ledger entry on first completion: studentUid ==
      // auth uid; completedAttempts == exactly 1 (entry exists only after the first
      // completion, and can't forge prior history); identity fields well-typed.
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.completedAttempts == 1 &&
        request.resource.data.quizId is string &&
        request.resource.data.teacherUid is string &&
        request.resource.data.lastAttemptAt is number;
      // Update split: STUDENT branch (increment by 1) and TEACHER branch (decrease/
      // reset). Identity fields immutable on both.
      allow update: if request.auth != null && (
        // Student branch — increment by exactly 1.
        (request.auth.uid == resource.data.studentUid &&
         request.resource.data.studentUid == resource.data.studentUid &&
         request.resource.data.quizId == resource.data.quizId &&
         request.resource.data.teacherUid == resource.data.teacherUid &&
         request.resource.data.completedAttempts == resource.data.completedAttempts + 1 &&
         request.resource.data.lastAttemptAt is number)
        ||
        // Teacher reset/refund branch — may only DECREASE completedAttempts
        // (removeStudent reset, unlockStudentAttempt refund); never inflate, so the
        // cap stays an anti-cheating defense.
        (request.auth.uid == resource.data.teacherUid &&
         request.resource.data.studentUid == resource.data.studentUid &&
         request.resource.data.quizId == resource.data.quizId &&
         request.resource.data.teacherUid == resource.data.teacherUid &&
         request.resource.data.get('completedAttempts', 0) >= 0 &&
         request.resource.data.get('completedAttempts', 0) <=
           resource.data.get('completedAttempts', 0))
        ||
        isAdmin()
      );
      // Teacher or admin may delete (monitor "Reset"/"Remove student"); students
      // can't (they'd wipe their own cap). resource == null makes deleting a
      // non-existent ledger a no-op — without it removeStudent's atomic
      // archive+delete batch breaks for responses that never wrote a ledger
      // (anon PIN, idle blanks, stubs, legacy).
      allow delete: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.teacherUid || isAdmin()
      );
    }

    // Video Activity Attempt Ledger — same shape as the Quiz ledger.
    // Doc id: `${assignmentId}__${studentUid}` (assignmentId = session id);
    // scoped per assignment, not per activity template.
    match /video_activity_attempt_ledger/{ledgerId} {
      // See `quiz_attempt_ledger` above for the `resource == null`
      // rationale — same pattern, same threat model.
      allow read: if request.auth != null && (
        resource == null ||
        isAdmin() ||
        request.auth.uid == resource.data.teacherUid ||
        request.auth.uid == resource.data.studentUid
      );
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.completedAttempts == 1 &&
        request.resource.data.activityId is string &&
        request.resource.data.teacherUid is string &&
        request.resource.data.lastAttemptAt is number;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.studentUid &&
         request.resource.data.studentUid == resource.data.studentUid &&
         request.resource.data.activityId == resource.data.activityId &&
         request.resource.data.teacherUid == resource.data.teacherUid &&
         request.resource.data.completedAttempts == resource.data.completedAttempts + 1 &&
         request.resource.data.lastAttemptAt is number)
        ||
        // Teacher reset/refund branch (see quiz_attempt_ledger): may only DECREASE
        // completedAttempts (removeStudent reset + unlockStudentAttempt refund).
        (request.auth.uid == resource.data.teacherUid &&
         request.resource.data.studentUid == resource.data.studentUid &&
         request.resource.data.activityId == resource.data.activityId &&
         request.resource.data.teacherUid == resource.data.teacherUid &&
         request.resource.data.get('completedAttempts', 0) >= 0 &&
         request.resource.data.get('completedAttempts', 0) <=
           resource.data.get('completedAttempts', 0))
        ||
        isAdmin()
      );
      // resource == null no-op mirrors quiz_attempt_ledger (avoids a null-deref
      // deny). VA has no ledger-deleting remove path today, but keeps the two
      // ledgers symmetric.
      allow delete: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.teacherUid || isAdmin()
      );
    }

    // Announcements — admins write; reads are tenant-scoped. Legacy docs (no
    // orgId) stay readable by any authed user (preserves pre-isolation behavior);
    // a doc WITH an orgId is readable only by that org's members (isOrgMember) or
    // a real super admin.
    match /announcements/{announcementId} {
      // isAdmin() is a bare /admins/{email} doc, which also mirrors org-scoped
      // building_admin (see functions/src/organizationMembersSync.ts) — used
      // bare it let a building_admin of one org read (and write) another org's
      // announcements. isSuperAdmin() is resource-independent (matching
      // help_resources/plcs), so the admin "browse every announcement" manager
      // (components/admin/Announcements/Widget.tsx's unfiltered onSnapshot)
      // stays provable for a genuine site-wide admin. A same-org admin's read
      // is already covered by the isOrgMember(orgId) branch below — an admin
      // role is itself a member doc in its own org via the same sync — so no
      // separate same-org-admin read branch is needed here (unlike plcs, which
      // has no "any org member" read branch to fall back on).
      allow read: if request.auth != null
        && (
          // Missing orgId OR explicit orgId:null = legacy/global, any authed user.
          // (The null case avoids isOrgMember(null) hiding the doc from everyone.)
          !('orgId' in resource.data)
          || resource.data.orgId == null
          || isOrgMember(resource.data.orgId)
          || isSuperAdmin()
        );

      // Global/legacy (missing or null orgId) is super-admin only; an
      // org-scoped doc is writable by that org's admin or a super admin.
      // The ternary's condition uses .get(key, default) since 'orgId' may be
      // absent on a legacy doc; the true branch's dot-access is then safe
      // (that branch only runs once 'is string' has confirmed the key is
      // present) — matches helpScopeOk()'s scoping idiom above.
      function announcementWriteScopeOk(d) {
        return d.get('orgId', null) is string
          ? (isOrgMember(d.orgId) || isSuperAdmin())
          : isSuperAdmin();
      }
      allow create: if isAdmin() && announcementWriteScopeOk(request.resource.data);
      // orgId is immutable through this path — a same-org admin editing their
      // own announcement can't re-home it to another org or to global.
      allow update: if isAdmin() && announcementWriteScopeOk(resource.data)
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if isAdmin() && announcementWriteScopeOk(resource.data);

      // Poll votes subcollection - authed users read live tallies and cast votes.
      // Value-locked to exactly what PollWidget's setDoc({count: increment(1)}, {merge:true})
      // produces: create must land on 1, update must be previous + 1. Field transforms are
      // resolved into request.resource before rules run, so the real call site passes while
      // a same-shaped overwrite ({count: 0} or {count: 999999}) is denied. Caps abuse at +1
      // per write; per-voter dedup would need a per-voter vote doc. Delete is admin-only.
      match /pollVotes/{optionIndex} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['count']) &&
          request.resource.data.count is int &&
          request.resource.data.count == 1;
        allow update: if request.auth != null &&
          request.resource.data.keys().hasOnly(['count']) &&
          request.resource.data.count is int &&
          resource.data.count is int &&
          request.resource.data.count == resource.data.count + 1;
        allow delete: if isAdmin();
      }
    }

    // Dashboard Templates - all authenticated users can read, only admins can write
    match /dashboard_templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin-curated resources pushed to PLCs. Any authenticated teacher can
    // read (matches dashboard_templates / instructional_routines); the PLC
    // client filters by scope + plcIds. Only admins write. Single shared doc
    // per resource — no per-PLC fan-out.
    match /plc_resources/{resourceId} {
      allow read: if request.auth != null;
      // Shape locked via hasOnly([...]) (post-write merged doc, so partial updates
      // validate in full). Gate: createdByAdminUid == auth.uid; createdByAdminEmail
      // is a display snapshot validated as a string (not pinned to token.email).
      allow create, update: if isAdmin()
        && request.resource.data.id == resourceId
        && request.resource.data.keys().hasOnly([
             'id', 'kind', 'title', 'description', 'refId', 'scope', 'plcIds',
             'createdByAdminUid', 'createdByAdminEmail', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.kind in
             ['quiz', 'video-activity', 'assignment', 'doc', 'board']
        && request.resource.data.scope in ['all', 'selected']
        && request.resource.data.plcIds is list
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.refId is string
        && request.resource.data.createdByAdminUid == request.auth.uid
        && request.resource.data.createdByAdminEmail is string
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }


    // Help Center config — the shared category list. Any authed user reads it
    // (the Help modal renders categories); only super admins edit it.
    match /help_center/config {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isSuperAdmin()
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt', 'updatedBy'])
        && request.resource.data.categories is list
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is int;
    }

    // Help resources — admin-curated guides. orgId == null means global (super
    // admin only); an org-scoped item is written by that org's admins and read
    // by its members. Teachers may only bump openCount, by exactly one.
    match /help_resources/{itemId} {
      function helpScopeOk(d) {
        return (d.orgId == null && isSuperAdmin())
          || (d.orgId is string && isOrgMember(d.orgId));
      }
      function helpShapeOk(d) {
        return d.id == itemId
          && d.keys().hasOnly(['id', 'kind', 'title', 'description', 'categoryId', 'order',
               'visible', 'orgId', 'widgetTypes', 'url', 'embedType', 'setId', 'openCount',
               'createdBy', 'createdByEmail', 'createdAt', 'updatedAt'])
          && d.kind in ['embed', 'guided-learning']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.description is string && d.description.size() <= 1000
          && d.categoryId is string && d.order is int && d.visible is bool
          && d.widgetTypes is list && d.openCount is int
          && (d.kind == 'embed'
                ? (d.url is string && d.url.matches('^https://.*') && d.embedType is string && d.setId == null)
                : (d.setId is string && d.url == null && d.embedType == null))
          && d.createdByEmail is string && d.createdAt is int && d.updatedAt is int;
      }
      // Teacher-only: anon PIN and studentRole tokens carry no email claim, so
      // the same idiom isAdmin() uses keeps student sessions out of the library.
      // isSuperAdmin(), not isAdmin(): a bare /admins/{email} doc also mirrors
      // org-scoped roles like building_admin (see functions/src/authz.ts), so
      // isAdmin() here let a building_admin of one org read another org's
      // items. isSuperAdmin() matches helpScopeOk()'s own idiom above and the
      // client's useHelpResources({allOrgs: isSuperAdmin}) assumption.
      function helpReaderOk() {
        return request.auth != null
          && request.auth.token.get('email', '') != ''
          && (resource.data.orgId == null || isOrgMember(resource.data.orgId) || isSuperAdmin());
      }
      allow read: if helpReaderOk();
      allow create: if isAdmin() && helpShapeOk(request.resource.data)
        && helpScopeOk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.openCount == 0;
      allow update: if (isAdmin() && helpShapeOk(request.resource.data)
        && helpScopeOk(resource.data)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.openCount == resource.data.openCount)
        || (helpReaderOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount'])
        && request.resource.data.openCount == resource.data.openCount + 1);
      allow delete: if isAdmin() && helpScopeOk(resource.data);
    }

    // Global PDFs - all authenticated users can read, only admins can write
    match /global_pdfs/{pdfId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Mini Apps - all authenticated users can read, only admins can write
    match /global_mini_apps/{appId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Custom Widgets — admins read/write all; non-admins read published+enabled+
    // accessible widgets. NOTE: resource.data.buildings is UI-targeting only (Dock
    // display filter), NOT an access boundary (enforcing it needs a get(); content
    // is already authed-scoped within the district). Future per-building control:
    // add buildings to custom claims and check request.auth.token.buildings.
    match /custom_widgets/{widgetId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
         resource.data.published == true &&
         resource.data.enabled == true &&
         (
           resource.data.accessLevel == 'public' ||
           // email_verified is REQUIRED, same reason as isAdmin() above.
           (resource.data.accessLevel == 'beta' &&
            request.auth.token.email != null &&
            request.auth.token.get('email_verified', false) == true &&
            request.auth.token.email.lower() in resource.data.betaUsers)
         ));
      allow write: if isAdmin();
    }

    // Next Up Sessions — Teacher owns it, students submit entries to buffer
    match /nextup_sessions/{sessionId} {
      // Students read session to check if active
      allow read: if request.auth != null;
      // Only teacher (session owner) can create/update the session metadata
      // sessionId is formatted as [teacherUid]_[widgetId]
      allow write: if request.auth != null && 
                   (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));

      match /entries/{entryId} {
        // Students can submit entries (create). Parent session must exist and
        // be active, and the payload must match the client's exact write
        // shape ({name, joinedAt}) — the teacher's listener queries
        // orderBy('joinedAt'), so a doc missing that field is invisible to it
        // and would accumulate forever; an unbounded name string would bloat
        // the teacher's Drive queue export.
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/nextup_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/nextup_sessions/$(sessionId)).data.get('isActive', false) == true &&
          request.resource.data.keys().hasOnly(['name', 'joinedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.joinedAt is int;
        // Only teacher and admin can read/delete entries (buffer processing)
        // Path-based ownership check ensures query safety for the teacher's listener
        allow read, delete: if request.auth != null &&
                            (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
      }
    }

    // Video Activity Sessions — Teacher creates, anonymous students can read and submit responses
    match /video_activity_sessions/{sessionId} {
      function vaS() {
        return get(/databases/$(database)/documents/video_activity_sessions/$(sessionId)).data;
      }
      function vaOwner(s) {
        return request.auth != null && (s.teacherUid == request.auth.uid || isAdmin());
      }
      // `get` stays permissive (see quiz_sessions); `list` is scoped so a signed-in
      // caller can't enumerate every teacher's sessions.
      allow get: if request.auth != null;
      allow list: if request.auth != null && sessionListScoped();
      // Non-anonymous teachers create only sessions they own.
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.teacherUid == request.auth.uid;
      // Teacher owners update their own session (renames, status, sync-pull, PLC
      // attach, score-publish, sharing fields); identity immutable. Looser
      // allowlist like Quiz sessions (ownership + immutable identity, no per-field
      // hasOnly). The student response rule below stays tight.
      allow update: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.activityId == resource.data.activityId &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      // Owning teacher (or admin) may delete (VA "Delete permanently" cleanup).
      // Mirrors GL sessions.
      allow delete: if vaOwner(resource.data);

      // Answer key, kept off the student-readable session doc. getAfter lets the
      // create batch write it alongside the session.
      match /key/{keyId} {
        allow read: if vaOwner(vaS());
        allow write: if vaOwner(vaS()) ||
          vaOwner(getAfter(/databases/$(database)/documents/video_activity_sessions/$(sessionId)).data);
      }

      // Doc id (responseDocId): auth.uid (SSO) or pin-{period}-{pin} (anon).
      // Mirrors the Quiz keying contract (computeResponseKey / encodeResponseKeySegment).
      match /responses/{responseDocId} {
        function vaGate() {
          return passesStudentClassGateCompat(vaS().get('classIds', []), vaS().get('classId', ''));
        }

        // Student branch allows resource == null so the join flow can probe via
        // getDoc() before create (else a Null-value throw on studentUid). Mirrors
        // the Quiz response read.
        allow read: if request.auth != null && (
          vaOwner(vaS()) ||
          (vaGate() &&
           (resource == null || request.auth.uid == resource.data.studentUid))
        );
        // Students create their own response: studentUid == auth uid (no
        // impersonation). Doc-id by auth mode: SSO → responseDocId == auth.uid;
        // anon PIN → ^pin-[a-z0-9_]{1,64}-[a-z0-9_]{1,64}$ (mirrors
        // encodeResponseKeySegment, closes the cross-auth grief path). studentRole
        // users must be enrolled in the session's class.
        allow create: if request.auth != null &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.score == null &&
          request.resource.data.completedAt == null &&
          // Students cannot forge prior completions — initialize to 0.
          request.resource.data.get('completedAttempts', 0) == 0 &&
          request.resource.data.get('tabSwitchWarnings', 0) == 0 &&
          vaGate() &&
          // Block submissions on view-only sessions (mode is frozen at creation)
          vaS().get('mode', 'submissions') == 'submissions' &&
          // Block joins after the assignment's close time (M17).
          beforeClose(vaS()) &&
          // Block joins before the assignment's open time (M17).
          afterOpen(vaS()) &&
          (isStudentRoleUser()
            ? responseDocId == request.auth.uid
            : responseDocId.matches('^pin-[a-z0-9_]{1,64}-[a-z0-9_]{1,64}$'));
        // Update split: TEACHER branch (PR3 publish-scores: score/isCorrect/
        // scoreVisibility; gated by parent teacherUid, admins also pass) and
        // STUDENT branch (answer-submit, append-only invariants). Mutually
        // exclusive by intent — the teacher branch checks only
        // session owner, so a student falls through to the student branch.
        allow update: if request.auth != null && (
          // Teacher branch.
          vaOwner(vaS()) ||
          // Student branch — same invariants as before PR3.
          (
            resource.data.studentUid == request.auth.uid &&
            vaGate() &&
            // Student writes stop at the session close time (M17); the teacher
            // branch above is unaffected. A teacher-granted extension
            // (`unlocked: true`) is exempt so the resumed attempt can finish.
            (beforeClose(vaS()) ||
             resource.data.get('unlocked', false) == true) &&
            request.resource.data.studentUid == resource.data.studentUid &&
            request.resource.data.get('pin', null) == resource.data.get('pin', null) &&
            request.resource.data.get('name', null) == resource.data.get('name', null) &&
            request.resource.data.get('joinedAt', null) == resource.data.get('joinedAt', null) &&
            request.resource.data.score == resource.data.score &&
            // affectedKeys() (not changedKeys()) covers added/removed too, so a
            // smuggled new field can't slip past the whitelist.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'answers',
              'completedAt',
              'tabSwitchWarnings',
              'completedAttempts',
              'classPeriod',
              'unlocked'
            ]) &&
            // Students may only ever CLEAR unlocked (teacher sets true;
            // completeActivity clears it on resumed-attempt submit).
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlocked']) ||
             request.resource.data.get('unlocked', false) == false) &&
            request.resource.data.answers is list &&
            // Append-only on answers, except a rejoin-reset (prior completedAt
            // non-null → null) may clear answers to []. Otherwise no rollback.
            ((resource.data.get('completedAt', null) != null &&
              request.resource.data.get('completedAt', null) == null &&
              request.resource.data.answers.size() == 0) ||
             (request.resource.data.answers.size() >= resource.data.answers.size() &&
              request.resource.data.answers.hasAll(resource.data.answers))) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tabSwitchWarnings']) ||
             request.resource.data.tabSwitchWarnings >= resource.data.get('tabSwitchWarnings', 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAttempts']) ||
             request.resource.data.get('completedAttempts', 0) >= resource.data.get('completedAttempts', 0)) &&
            // Attempt-cap enforcement — last line of defense behind the
            // client-side join + completeActivity transactions.
            (vaS().get('sessionOptions', {}).get('attemptLimit', null) == null ||
             request.resource.data.get('completedAttempts', 0) <= vaS().sessionOptions.attemptLimit) &&
            // completedAt gate: blocks non-null → non-null (race/bug). Completion
            // is null → non-null; rejoin is non-null → null.
            (resource.data.get('completedAt', null) == null ||
             request.resource.data.get('completedAt', null) == null)
          )
        );
        // Owning teacher (or admin) may delete responses when permanently
        // deleting the assignment (matches GL responses).
        allow delete: if vaOwner(vaS());
      }

      // View tracking for view-only Share links (see quiz_sessions/views).
      // Create requires the parent session to exist AND be in view-only mode.
      match /views/{viewId} {
        allow read: if vaOwner(vaS());
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['viewedAt']) &&
          request.resource.data.viewedAt is timestamp &&
          vaS().get('mode', 'submissions') == 'view-only';
        allow update, delete: if false;
      }
    }

    // Video Activity metadata — stored per teacher user
    match /users/{userId}/video_activities/{activityId} {
      allow read, write: if ownsUser(userId);
    }

    // MiniApp Assignment Sessions — Teacher creates, anonymous students can read
    match /mini_app_sessions/{sessionId} {
      // `get` stays permissive (see quiz_sessions); `list` is scoped so a signed-in
      // caller can't enumerate every teacher's sessions.
      allow get: if request.auth != null;
      allow list: if request.auth != null && sessionListScoped();
      // Only authenticated (non-anonymous) teachers can create sessions they own
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.teacherUid == request.auth.uid;
      // Teachers can rename or end their own sessions (assignmentName, status, endedAt only)
      allow update: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assignmentName', 'status', 'endedAt']) &&
        request.resource.data.status in ['active', 'ended'];
      allow delete: if false;

      // MiniApp student submissions (replaces the legacy Sheets pipeline). Doc id
      // is an opaque per-assignment pseudonym (studentRole) or the anonymous auth
      // uid (legacy shared-link). Payload is deliberately opaque — no PII.
      match /submissions/{submissionId} {
        function maSessionData() {
          return get(/databases/$(database)/documents/mini_app_sessions/$(sessionId)).data;
        }
        function maSessionClassIds() {
          return maSessionData().get('classIds', []);
        }
        // Create and update share one rule here, so the open window is
        // scoped to the CREATE case (`resource == null`).
        function maWithinSessionOpenWindow() {
          return resource != null || afterOpen(maSessionData());
        }

        // Teacher + admins read all submissions; a student reads their own (the
        // /my-assignments completion badge). Identity is the studentUid field
        // (works for both pseudonym and auth-uid doc ids).
        allow read: if request.auth != null && (
          isAdmin() ||
          maSessionData().teacherUid == request.auth.uid ||
          resource.data.studentUid == request.auth.uid
        );

        // Any authed user (anon or studentRole) creates/updates their own submission while
        // the session is active. studentUid must == auth.uid. Anon launches must also use
        // auth.uid as the doc id (no doc-spraying); studentRole launches use an opaque
        // pseudonym (HMAC-unforgeable, class-gated). Two write paths: full submission
        // (submissionsEnabled, payload <=50 keys) and completion marker (exactly
        // {completed: true}) for the /my-assignments badge.
        allow create, update: if request.auth != null &&
          maSessionData().status == 'active' &&
          passesStudentClassGateList(maSessionClassIds()) &&
          (isStudentRoleUser() || submissionId == request.auth.uid) &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['submittedAt', 'studentUid', 'payload']) &&
          request.resource.data.submittedAt is int &&
          request.resource.data.payload is map &&
          request.resource.data.payload.size() <= 50 &&
          // Block submissions on view-only sessions (mode is frozen at creation).
          // Defense in depth alongside the existing `submissionsEnabled` gate.
          maSessionData().get('mode', 'submissions') == 'submissions' &&
          // Block submissions after the assignment's close time (M17).
          beforeClose(maSessionData()) &&
          // Block a first submission before the assignment's open time (M17).
          maWithinSessionOpenWindow() &&
          (
            maSessionData().get('submissionsEnabled', false) == true ||
            (request.resource.data.payload.keys().hasOnly(['completed']) &&
             request.resource.data.payload.completed == true)
          );

        // Only the owning teacher or an admin may delete submissions —
        // used when a teacher wipes an assignment.
        allow delete: if request.auth != null && (
          isAdmin() ||
          maSessionData().teacherUid == request.auth.uid
        );
      }

      // View tracking for view-only Share links (see quiz_sessions/views).
      // Create requires the parent session to exist AND be in view-only mode.
      match /views/{viewId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          get(/databases/$(database)/documents/mini_app_sessions/$(sessionId)).data.teacherUid == request.auth.uid
        );
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['viewedAt']) &&
          request.resource.data.viewedAt is timestamp &&
          exists(/databases/$(database)/documents/mini_app_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/mini_app_sessions/$(sessionId)).data.get('mode', 'submissions') == 'view-only';
        allow update, delete: if false;
      }
    }

    // AI Usage Tracking — read-only for users; all writes go through Cloud
    // Functions (Admin SDK), so a user can't reset their daily quota by writing
    // count = 0 from the client.
    match /ai_usage/{usageId} {
      // Document ID is formatted as {uid}_{YYYY-MM-DD}
      // Security rule replacement for startsWith: usageId >= prefix && usageId < prefix + '\uf8ff'
      allow read: if request.auth != null && (
        (usageId >= request.auth.uid + '_' && usageId < request.auth.uid + '_' + '\uf8ff') ||
        isAdmin()
      );
      // No client write — quota increments are performed server-side via Admin SDK only.
    }

    // Guided Learning Sessions — Teacher creates, authenticated (incl. anonymous) students read and submit
    match /guided_learning_sessions/{sessionId} {
      // `get` stays permissive (see quiz_sessions); `list` is scoped so a signed-in
      // caller can't enumerate every teacher's sessions.
      allow get: if request.auth != null;
      allow list: if request.auth != null && sessionListScoped();
      // Only authenticated (non-anonymous) teachers can create sessions; they must own it
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.teacherUid == request.auth.uid;
      // Owning teacher (or admin) may update (publishAssignmentScores mirrors
      // scoreVisibility + revealedAnswers onto the session so the student listener
      // can gate review without teacher-owned docs; mirrors Quiz sessions) and
      // delete (GL "Delete permanently" cleanup).
      allow update, delete: if request.auth != null &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());

      // The session doc, named once: the full path repeated a dozen times in
      // the sub-collections below is worth real bytes against the cap.
      function glSession() {
        return get(/databases/$(database)/documents/guided_learning_sessions/$(sessionId)).data;
      }
      // Shared by responses and progress.
      function glClassGate() {
        return passesStudentClassGateCompat(glSession().get('classIds', []), glSession().get('classId', ''));
      }
      function glIsTeacher() {
        return isAdmin() || glSession().teacherUid == request.auth.uid;
      }
      // GL stores assignment mode under `assignmentMode` (its `mode` is
      // play-mode: structured/guided/explore); other widgets use `mode`.
      function glSessionMode() {
        return glSession().get('assignmentMode', 'submissions');
      }

      match /responses/{studentUid} {
        // Teacher can read all responses; students can only read their own
        allow read: if request.auth != null && (
          glIsTeacher() ||
          (studentUid == request.auth.uid && glClassGate())
        );
        // Students create their own response; doc ID, studentAnonymousId, and sessionId must match.
        // studentRole users must also be enrolled in the session's class.
        allow create: if request.auth != null &&
          studentUid == request.auth.uid &&
          request.resource.data.studentAnonymousId == request.auth.uid &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.score == null &&
          glClassGate() &&
          // Block submissions on view-only sessions (mode is frozen at creation)
          glSessionMode() == 'submissions' &&
          // Block joins outside the assignment's open/close window (M17).
          beforeClose(glSession()) &&
          afterOpen(glSession());
        // Two disjoint branches: TEACHER (owning teacher/admin writes score + per-answer
        // isCorrect on publish, clears on unpublish; teacherUid is the sole gate,
        // unconstrained payload) and STUDENT (append answers / set completedAt, score
        // client-immutable). Mutually exclusive - a student fails the teacher disjunct and
        // falls through to the student invariants.
        allow update: if request.auth != null && (
          // Teacher branch.
          glIsTeacher() ||
          // Student branch — unchanged.
          (
            studentUid == request.auth.uid &&
            glClassGate() &&
            // Student writes stop at the session close time (M17); the teacher
            // branch above is unaffected.
            beforeClose(glSession()) &&
            request.resource.data.studentAnonymousId == resource.data.studentAnonymousId &&
            request.resource.data.sessionId == resource.data.sessionId &&
            request.resource.data.startedAt == resource.data.startedAt &&
            request.resource.data.score == resource.data.score &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'completedAt', 'pin']) &&
            request.resource.data.answers.size() >= resource.data.answers.size()
          )
        );
        // Owning teacher (or admin) may delete responses — used when the
        // teacher permanently deletes an assignment.
        allow delete: if request.auth != null && glIsTeacher();
      }

      // Per-viewer step analytics (GL Studio plan P2-5). Doc id is the viewer's
      // uid. Share-link viewers have no class, so the class gate and open
      // window apply only to submissions sessions; the close window always does.
      match /progress/{uid} {
        function glValidProgress() {
          let d = request.resource.data;
          return d.keys().hasOnly(['mode', 'modeSwitches', 'furthestStepIdx', 'completed', 'steps', 'startedAt', 'updatedAt']) &&
            d.furthestStepIdx is int && d.furthestStepIdx >= 0 && d.furthestStepIdx <= 500 &&
            d.steps is map && d.steps.size() <= 200 &&
            d.startedAt is timestamp &&
            (!('mode' in d) || d.mode in ['watch', 'try']) &&
            optInt(d, 'modeSwitches') && optBool(d, 'completed') &&
            (!('updatedAt' in d) || d.updatedAt is timestamp);
        }
        allow get: if request.auth != null && (uid == request.auth.uid || glIsTeacher());
        allow list: if request.auth != null && glIsTeacher();
        allow create, update: if request.auth != null &&
          uid == request.auth.uid &&
          glValidProgress() &&
          (resource == null || request.resource.data.startedAt == resource.data.startedAt) &&
          beforeClose(glSession()) &&
          (glSessionMode() == 'view-only' || (glClassGate() && afterOpen(glSession())));
      }

      // View tracking for view-only Share links (see quiz_sessions/views). GL
      // stores assignment mode under `assignmentMode` (its `mode` is play-mode).
      match /views/{viewId} {
        allow read: if request.auth != null && glIsTeacher();
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['viewedAt']) &&
          request.resource.data.viewedAt is timestamp &&
          exists(/databases/$(database)/documents/guided_learning_sessions/$(sessionId)) &&
          glSessionMode() == 'view-only';
        allow update, delete: if false;
      }
    }

    // Activity Wall Sessions — Teacher owns it (UID prefix in sessionId), students submit entries
    // sessionId is formatted as {teacherUid}_{activityId}
    match /activity_wall_sessions/{sessionId} {
      // `get` stays permissive (see quiz_sessions); `list` is scoped so a signed-in
      // caller can't enumerate every teacher's sessions. Ownership for writes is
      // the `{uid}_` doc-id prefix, which a list rule cannot prove — the session
      // mirror also carries `teacherUid`, which is what the library query filters
      // on and what sessionListScoped() proves.
      allow get: if request.auth != null;
      allow list: if request.auth != null && sessionListScoped();
      // Only authenticated non-anonymous teachers/admins can create or update the session document itself.
      allow create, update: if request.auth != null &&
                            request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                            (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
      allow delete: if false;

      // Merged student page helpers (shared by submissions, likes, comments).
      function awParentSession() {
        return get(/databases/$(database)/documents/activity_wall_sessions/$(sessionId)).data;
      }
      function awIsOwner() {
        return isAdmin() || sessionId.matches(request.auth.uid + '_.*');
      }
      // Padlet-lite audience: an enrolled studentRole user, or anyone once the
      // teacher opted into guests. Legacy sessions (no layout) never match.
      function awStudentAudienceOk() {
        return 'layout' in awParentSession() &&
               passesStudentClassGateCompat(
                 awParentSession().get('classIds', []),
                 awParentSession().get('classId', '')
               ) &&
               (isStudentRoleUser() || awParentSession().get('allowGuests', false) == true);
      }
      // Session-level twin of the submissions block's awAcceptingResponses():
      // a closed wall stops taking new engagement, not just new posts.
      function awSessionAcceptingResponses() {
        return awParentSession().get('acceptingResponses', true) != false;
      }
      // Who may see engagement (likes/comments): the owner, the public
      // gallery audience, or the student-page audience while the wall is
      // visible (a hidden wall must not leak comments on unseen posts).
      function awViewerOk() {
        return awIsOwner() ||
               awParentSession().get('publiclyShared', false) == true ||
               (awStudentAudienceOk() &&
                awParentSession().get('studentsCanSeePosts', true) != false);
      }
      // Engagement (likes/comments) reads are an unfiltered collection listen
      // (useWallEngagement.ts has no per-post `where`, by design), so the list-query rule
      // can only depend on session-level state: a rule referencing resource.data here
      // would make the ENTIRE listen unsafe and Firestore denies the whole query (rules
      // aren't filters). So the moderation boundary holds at CREATE time instead: a
      // like/comment may never attach to a submission still pending review, for ANY caller
      // including the owner - otherwise that unreviewed post's content reaches the whole
      // class through this same unfiltered listen the instant anyone engages with it.
      // submissionId must also reference a real, approved post: every legitimate caller
      // supplies the id of a post it is rendering, so this costs no real usage while
      // closing a fabricated-id create.
      function awEngagementSubmissionOk(refSubmissionId) {
        let ref = /databases/$(database)/documents/activity_wall_sessions/$(sessionId)/submissions/$(refSubmissionId);
        return exists(ref) && get(ref).data.get('status', 'approved') == 'approved';
      }

      match /submissions/{submissionId} {
        // Single cached read of the parent session (same-path get() is cached
        // per evaluation, so the helpers below don't multiply billed reads).
        function awSession() {
          return get(/databases/$(database)/documents/activity_wall_sessions/$(sessionId)).data;
        }
        function awSessionClassId() {
          return awSession().get('classId', '');
        }
        // Phase-5A multi-class targeting field. Mirrors the quiz/VA/GL/miniapp
        // session shape so the create gate below can use the compat helper.
        function awSessionClassIds() {
          return awSession().get('classIds', []);
        }
        // Moderation flag: when true the client submits 'pending' for teacher
        // review; when false/absent it auto-approves. Pinning create's status
        // to this value (instead of allowing either) closes a bypass where a
        // submitter could set status: 'approved' directly and skip the review
        // queue even though the teacher enabled moderation.
        function awSessionModerationEnabled() {
          return awSession().get('moderationEnabled', false);
        }
        // Padlet-lite marker. The deployed prod client mirrors sessions WITHOUT
        // a `layout` field and posts submissions with no `type`/`authorUid`, so
        // every new create gate below is opt-in on this flag: legacy sessions
        // keep exactly the pre-redesign contract until P3-3 retires them.
        function awIsPadletSession() {
          return 'layout' in awSession();
        }
        function awAcceptingResponses() {
          return awSession().get('acceptingResponses', true) != false;
        }
        // Padlet walls admit enrolled studentRole users (the class gate above
        // already ran), or ANY authenticated caller once the teacher opted into
        // guest posting. A signed-in non-student on an SSO-only wall is denied.
        function awPadletAccessOk() {
          return isStudentRoleUser() ||
                 awSession().get('allowGuests', false) == true;
        }
        // `word` is wordcloud-only and `text` is everywhere else; the four
        // media types each need their per-wall toggle.
        function awTypeAllowed() {
          let t = request.resource.data.get('type', 'text');
          return t in ['text', 'word', 'photo', 'link', 'file', 'video'] &&
                 (t != 'word' || awSession().get('layout', '') == 'wordcloud') &&
                 (t != 'text' || awSession().get('layout', '') != 'wordcloud') &&
                 (!(t in ['photo', 'link', 'file', 'video']) ||
                  awSession().get('allowedTypes', {}).get(t, false) == true);
        }
        // Per-student cap is enforced through the doc id: `{uid}__{n}` with
        // n < maxPostsPerStudent. One-doc-per-slot means a student cannot
        // exceed the cap by racing writes (same pattern as quiz responses).
        function awWithinPostCap() {
          let cap = awSession().get('maxPostsPerStudent', 0);
          return !(cap is int) || cap <= 0 ||
                 (submissionId.matches('^' + request.auth.uid + '__(0|[1-9][0-9]{0,2})$') &&
                  int(submissionId.split('__')[1]) < cap);
        }

        // Short authored labels stay bounded so no branch can grow a doc every
        // gallery viewer re-downloads on each snapshot.
        function awBoundedStrings() {
          let d = request.resource.data;
          return optShortString(d, 'title') &&
                 optShortString(d, 'label') &&
                 optShortString(d, 'sectionId') &&
                 optShortString(d, 'cellKey') &&
                 optShortString(d, 'fileName') &&
                 optShortString(d, 'mimeType') &&
                 optShortString(d, 'participantLabel');
        }
        // linkPreview is fetched metadata: closed key set, bounded text.
        function awLinkPreviewOk() {
          let lp = request.resource.data.get('linkPreview', {});
          return !('linkPreview' in request.resource.data) ||
                 (request.resource.data.linkPreview is map &&
                  lp.keys().hasOnly(['title', 'description', 'image', 'domain', 'videoId']) &&
                  (!('title' in lp) || (lp.title is string && lp.title.size() <= 500)) &&
                  (!('description' in lp) || (lp.description is string && lp.description.size() <= 500)) &&
                  (!('image' in lp) || (lp.image is string && lp.image.size() <= 2048)) &&
                  (!('domain' in lp) || (lp.domain is string && lp.domain.size() <= 2048)) &&
                  optShortString(lp, 'videoId'));
        }
        // Per-field type contract shared by create, the owner/admin update
        // branch, and the student self-edit branch (all see the merged doc).
        function awFieldTypesOk() {
          let d = request.resource.data;
          return (!('type' in d) || d.type in ['text', 'word', 'photo', 'link', 'file', 'video']) &&
                 optString(d, 'authorUid') &&
                 optBool(d, 'isGuest') &&
                 optBool(d, 'pinned') &&
                 optNumber(d, 'order') &&
                 optNumber(d, 'lat') &&
                 optNumber(d, 'lng') &&
                 optInt(d, 'sizeBytes') &&
                 optInt(d, 'editedAt') &&
                 optString(d, 'storagePath') &&
                 optString(d, 'activityId') &&
                 (!('authorRole' in d) || d.authorRole == 'teacher') &&
                 awBoundedStrings() &&
                 awLinkPreviewOk();
        }

        // Any authed user (incl. anon) can create a submission (photo subs may carry storage
        // metadata for Drive archiving). studentRole users must be enrolled; uses the
        // Phase-5A compat gate (classIds ?? legacy classId). hasOnly() closes an
        // unbounded-field-injection gap: without it a caller could smuggle arbitrary extra
        // keys - incl. a large junk string toward the 1MB cap - past every per-field check,
        // and every gallery viewer's onSnapshot would pay to download it on each emission.
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/activity_wall_sessions/$(sessionId)) &&
          passesStudentClassGateCompat(awSessionClassIds(), awSessionClassId()) &&
          request.resource.data.keys().hasOnly([
            'id', 'activityId', 'content', 'submittedAt', 'status',
            'participantLabel', 'storagePath', 'archiveStatus',
            'type', 'authorUid', 'isGuest', 'title', 'sectionId', 'cellKey',
            'label', 'lat', 'lng', 'linkPreview', 'order',
            'fileName', 'mimeType', 'sizeBytes', 'editedAt'
          ]) &&
          request.resource.data.id is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 5000 &&
          request.resource.data.submittedAt is int &&
          request.resource.data.status == (awSessionModerationEnabled() ? 'pending' : 'approved') &&
          !('authorRole' in request.resource.data) &&
          awFieldTypesOk() &&
          // authorUid is an ownership claim on every session shape, not just padlet ones.
          (!('authorUid' in request.resource.data) ||
           (request.resource.data.authorUid == request.auth.uid &&
            request.resource.data.authorUid.size() <= 200)) &&
          (!('archiveStatus' in request.resource.data) || request.resource.data.archiveStatus == 'firebase') &&
          (!awIsPadletSession() ||
            (awAcceptingResponses() &&
             awPadletAccessOk() &&
             request.resource.data.authorUid == request.auth.uid &&
             awTypeAllowed() &&
             awWithinPostCap()));
        // Teacher posts from the widget face: auto-approved even under
        // moderation, stamped authorRole 'teacher' so the card is labelled.
        allow create: if request.auth != null &&
          request.auth.token.firebase.sign_in_provider != 'anonymous' &&
          awIsOwner() &&
          awIsPadletSession() &&
          request.resource.data.keys().hasOnly([
            'id', 'activityId', 'content', 'submittedAt', 'status',
            'participantLabel', 'storagePath', 'archiveStatus',
            'type', 'authorUid', 'isGuest', 'title', 'sectionId', 'cellKey',
            'label', 'lat', 'lng', 'linkPreview', 'order',
            'fileName', 'mimeType', 'sizeBytes', 'editedAt', 'authorRole'
          ]) &&
          request.resource.data.id is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 5000 &&
          request.resource.data.submittedAt is int &&
          request.resource.data.status == 'approved' &&
          request.resource.data.authorRole == 'teacher' &&
          request.resource.data.authorUid == request.auth.uid &&
          awFieldTypesOk() &&
          awTypeAllowed() &&
          (!('archiveStatus' in request.resource.data) || request.resource.data.archiveStatus == 'firebase');
        // Teacher/admins read+delete submissions, EXCEPT a published view-only gallery
        // (publiclyShared) is readable by any authed caller. Delete stays teacher/admin-only.
        // A student can list/get their own posts via where('authorUid','==',uid) even on a
        // non-public wall. A published PADLET gallery only exposes APPROVED posts, so a
        // pending post never leaks; new clients query where('status','==','approved').
        // Legacy sessions keep the old unconditional public read (the deployed prod gallery
        // lists unfiltered and would break otherwise). Merged student page: the student-link
        // audience reads approved posts while the teacher keeps the wall visible.
        allow read: if request.auth != null &&
                            (isAdmin() ||
                             sessionId.matches(request.auth.uid + '_.*') ||
                             (awSession().get('publiclyShared', false) == true &&
                              (!awIsPadletSession() ||
                               resource.data.status == 'approved')) ||
                             (awStudentAudienceOk() &&
                              awSession().get('studentsCanSeePosts', true) != false &&
                              resource.data.status == 'approved') ||
                             resource.data.authorUid == request.auth.uid);
        allow delete: if request.auth != null &&
                            (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
        // Students may retract their own post while the wall is open and the
        // teacher enabled deletion (Padlet-lite sessions only).
        allow delete: if request.auth != null &&
                            awIsPadletSession() &&
                            resource.data.get('authorUid', '') == request.auth.uid &&
                            awSession().get('allowStudentDelete', false) == true &&
                            awAcceptingResponses();
        // hasOnly() lists every field this doc can ever carry (create-time fields + the
        // Admin-SDK-written archive fields) since request.resource.data on an update is the
        // doc AFTER merge - untouched existing fields (e.g. driveFileId) stay present and
        // must pass the whitelist too. See create's comment for why an extra field matters.
        allow update: if request.auth != null &&
                            (isAdmin() || sessionId.matches(request.auth.uid + '_.*')) &&
                            request.resource.data.keys().hasOnly([
                              'id', 'activityId', 'content', 'submittedAt', 'status',
                              'participantLabel', 'storagePath', 'archiveStatus',
                              'driveFileId', 'driveUrl', 'archiveError', 'archivedAt',
                              'archiveStartedAt', 'attemptCount', 'lastAttemptAt',
                              'storageCleanupPending', 'drivePermission',
                              'type', 'authorUid', 'isGuest', 'title', 'sectionId',
                              'cellKey', 'order', 'label', 'lat', 'lng', 'pinned',
                              'linkPreview', 'fileName', 'mimeType', 'sizeBytes',
                              'editedAt', 'authorRole'
                            ]) &&
                            request.resource.data.id is string &&
                            request.resource.data.content is string &&
                            request.resource.data.content.size() > 0 &&
                            request.resource.data.content.size() <= 5000 &&
                            request.resource.data.submittedAt is int &&
                            request.resource.data.status in ['approved', 'pending'] &&
                            awFieldTypesOk() &&
                            (!('archiveStatus' in request.resource.data) || request.resource.data.archiveStatus in ['firebase', 'syncing', 'archived', 'failed', 'lost']) &&
                            optString(request.resource.data, 'driveFileId') &&
                            optString(request.resource.data, 'driveUrl') &&
                            optString(request.resource.data, 'archiveError') &&
                            optInt(request.resource.data, 'archivedAt') &&
                            optInt(request.resource.data, 'archiveStartedAt') &&
                            optInt(request.resource.data, 'attemptCount') &&
                            optInt(request.resource.data, 'lastAttemptAt') &&
                            optBool(request.resource.data, 'storageCleanupPending') &&
                            optString(request.resource.data, 'drivePermission');
        // Student self-edit: only the author, only while the wall is open and the teacher
        // enabled editing, only content-shaped fields. `status` is writable in exactly one
        // direction: when moderation is on and the edit touches `content`, the post returns
        // to 'pending' - otherwise a student could smuggle unreviewed text into an approved
        // card. With moderation off, status must stay untouched.
        allow update: if request.auth != null &&
                            awIsPadletSession() &&
                            resource.data.get('authorUid', '') == request.auth.uid &&
                            awSession().get('allowStudentEdit', false) == true &&
                            awAcceptingResponses() &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                              'content', 'title', 'label', 'sectionId', 'cellKey',
                              'lat', 'lng', 'editedAt', 'linkPreview', 'storagePath',
                              'archiveStatus', 'fileName', 'mimeType', 'sizeBytes',
                              'status'
                            ]) &&
                            (awSessionModerationEnabled() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasAny(['content'])
                              ? request.resource.data.status == 'pending'
                              : request.resource.data.status == resource.data.status) &&
                            request.resource.data.content is string &&
                            request.resource.data.content.size() > 0 &&
                            request.resource.data.content.size() <= 5000 &&
                            awFieldTypesOk() &&
                            // A re-upload may only re-enter the pipeline at 'firebase', under its own object path.
                            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['archiveStatus']) ||
                             request.resource.data.archiveStatus == 'firebase') &&
                            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['storagePath']) ||
                             request.resource.data.storagePath.matches('^activity_wall_media/' + sessionId + '/' + submissionId + '/.+'));
      }

      // Likes — one per viewer per post ({submissionId}__{uid} doc id), shared
      // by the student page and the public gallery. Gated on the wall's own
      // allowLikes flag (share-level likes are read-only history).
      match /likes/{likeId} {
        allow read: if request.auth != null && awViewerOk();
        allow create: if request.auth != null &&
          awViewerOk() &&
          (awIsOwner() || awSessionAcceptingResponses()) &&
          awParentSession().get('allowLikes', false) == true &&
          awEngagementSubmissionOk(request.resource.data.get('submissionId', '')) &&
          request.resource.data.keys().hasOnly([
            'id', 'submissionId', 'authorUid', 'createdAt'
          ]) &&
          request.resource.data.submissionId is string &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.createdAt is int &&
          likeId == request.resource.data.submissionId + '__' + request.auth.uid;
        allow delete: if request.auth != null &&
          (resource.data.get('authorUid', null) == request.auth.uid || awIsOwner());
        allow update: if false;
      }

      // Comments — replies need allowCommentResponses; commenter or owner deletes.
      match /comments/{commentId} {
        allow read: if request.auth != null && awViewerOk();
        allow create: if request.auth != null &&
          awViewerOk() &&
          (awIsOwner() || awSessionAcceptingResponses()) &&
          awParentSession().get('allowComments', false) == true &&
          awEngagementSubmissionOk(request.resource.data.get('submissionId', '')) &&
          (
            request.resource.data.get('parentCommentId', null) == null ||
            awParentSession().get('allowCommentResponses', false) == true
          ) &&
          request.resource.data.id == commentId &&
          request.resource.data.keys().hasOnly([
            'id', 'submissionId', 'content', 'participantLabel', 'authorUid',
            'createdAt', 'parentCommentId'
          ]) &&
          request.resource.data.submissionId is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000 &&
          request.resource.data.participantLabel is string &&
          request.resource.data.participantLabel.size() <= 200 &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.createdAt is int;
        allow delete: if request.auth != null &&
          (resource.data.get('authorUid', null) == request.auth.uid || awIsOwner());
        allow update: if false;
      }
    }

    // Poll Sessions — public, anonymous device-voting for the Poll widget.
    // sessionId is formatted as {teacherUid}_{pollSessionId}. The teacher owns
    // the session doc (UID prefix); participants write one uid-keyed vote each.
    match /poll_sessions/{sessionId} {
      // Reads are permissive for any authed caller (mirrors activity_wall_sessions).
      allow read: if request.auth != null;
      // Only a non-anonymous teacher whose uid prefixes the sessionId (or an
      // admin) may create/update the session doc itself.
      allow create, update: if request.auth != null &&
                            request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                            (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
      allow delete: if false;

      // Vote doc id is the composite `{questionIndex}_{uid}` so one listener
      // covers every question in a multi-question poll while still holding the
      // one-vote-per-device-per-question invariant.
      match /votes/{voteId} {
        // Reads the parent session once (let-bound), reused for the active-gate
        // and the per-question optionIndex range check. Same-path reads are
        // cached per evaluation, so the preceding exists() isn't double-billed.
        // Invoked only after the allow rule confirmed both indices are ints.
        function voteTargetsActiveInRangeOption() {
          let session = get(/databases/$(database)/documents/poll_sessions/$(sessionId)).data;
          let counts = session.get('optionCounts', []);
          let questionIndex = request.resource.data.questionIndex;
          return session.get('active', false) == true &&
            questionIndex >= 0 &&
            questionIndex < counts.size() &&
            request.resource.data.optionIndex >= 0 &&
            request.resource.data.optionIndex < counts[questionIndex];
        }

        // Any authed user (incl. anon) may create/update ONLY the vote doc whose
        // id == `{questionIndex}_{their uid}`. Exactly the three declared keys;
        // questionIndex int in [0, optionCounts.size()); optionIndex int in
        // [0, optionCounts[questionIndex]); only while active. Re-voting the
        // same question overwrites (one per device per question).
        allow create, update: if request.auth != null &&
          request.resource.data.keys().hasOnly(['questionIndex', 'optionIndex', 'votedAt']) &&
          request.resource.data.questionIndex is int &&
          request.resource.data.optionIndex is int &&
          request.resource.data.votedAt is int &&
          voteId == string(request.resource.data.questionIndex) + '_' + request.auth.uid &&
          exists(/databases/$(database)/documents/poll_sessions/$(sessionId)) &&
          voteTargetsActiveInRangeOption();

        // Reads open to any authed user — vote docs are anonymous tallies
        // (no PII), which is what powers the live results on phones + board.
        allow read: if request.auth != null;

        // Delete (reset) is teacher/admin-only.
        allow delete: if request.auth != null &&
          (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
      }
    }

    // === Video Activity assignments (Wave 2-VA) ===
    // Per-teacher archive of video activity assignments — mirrors quiz_assignments.
    match /users/{userId}/video_activity_assignments/{id} {
      allow read, write: if ownsUser(userId);
    }

    // === Wave 2 library assignment archives (appended) ===
    // MiniApp assignment archive (Wave 2-MA).
    match /users/{userId}/miniapp_assignments/{id} {
      allow read, write: if ownsUser(userId);
    }
    // === /Wave 2 library assignment archives ===

    // === Guided Learning assignments (Wave 2-GL) ===
    // Per-teacher archive of guided learning assignments. Owner-only read/write.
    match /users/{userId}/guided_learning_assignments/{id} {
      allow read, write: if ownsUser(userId);
    }

    // === Library folders (Wave 3) ===
    // Per-teacher folder tree per library widget (Quiz/VA/GL/MiniApp); folders
    // never cross widgets. Owner-only read/write, like *_assignments above.
    match /users/{userId}/collections/{collectionId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/quiz_folders/{folderId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/question_bank_folders/{folderId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/video_activity_folders/{folderId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/guided_learning_folders/{folderId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/miniapp_folders/{folderId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/projects_folders/{folderId} {
      allow read, write: if ownsUserTeacher(userId);
    }

    // === Flashcards (PR 1: teacher-owned authoring library) ===
    match /users/{userId}/flashcard_sets/{setId} {
      allow read, write: if ownsUserTeacher(userId);
    }
    match /users/{userId}/flashcard_folders/{folderId} {
      allow read, write: if ownsUserTeacher(userId);
    }
    match /users/{userId}/flashcard_assignments/{assignmentId} {
      allow read, write: if ownsUserTeacher(userId);
    }

    // Public Flashcards snapshots — single-document reads work without auth so
    // Schoology/Google Sites embeds do not depend on partitioned auth storage.
    // Listing is intentionally denied: a share id is the access capability.
    match /public_flashcard_sets/{shareId} {
      function validPublicFlashcardSnapshot() {
        return request.resource.data.teacherUid == request.auth.uid
               && request.resource.data.keys().hasOnly([
                 'teacherUid', 'setId', 'title', 'description',
                 'termLanguage', 'definitionLanguage', 'cards',
                 'updatedAt'
               ])
               && request.resource.data.setId is string
               && request.resource.data.title is string
               && request.resource.data.title.size() > 0
               && request.resource.data.description is string
               && request.resource.data.termLanguage is string
               && request.resource.data.definitionLanguage is string
               && request.resource.data.cards is list
               && request.resource.data.cards.size() > 0
               && request.resource.data.cards.size() <= 500
               && request.resource.data.updatedAt is int;
      }

      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && !isStudentRoleUser()
                    && notDeactivated()
                    && validPublicFlashcardSnapshot();
      allow update: if request.auth != null
                    && !isStudentRoleUser()
                    && notDeactivated()
                    && resource.data.teacherUid == request.auth.uid
                    && validPublicFlashcardSnapshot();
      allow delete: if request.auth != null
                    && !isStudentRoleUser()
                    && notDeactivated()
                    && resource.data.teacherUid == request.auth.uid;
    }

    // Flashcards assignments (PR 3). Students read their class's sessions (or one
    // they hold a pointer for) and write only their own progress; score fields
    // are written by submitFlashcardCheckV1.
    match /flashcard_sessions/{sessionId} {
      function fcTeacherSignedIn() {
        return request.auth != null
               && request.auth.token.firebase.sign_in_provider != 'anonymous'
               && !isStudentRoleUser()
               && notDeactivated();
      }
      function fcHasPointer() {
        return exists(/databases/$(database)/documents/student_assignments/$(request.auth.uid)/items/$(sessionId));
      }
      // Positive class match. Deliberately NOT passesStudentClassGateList(),
      // which passes on an empty/absent classIds - a roster- or group-targeted
      // session carries no classIds and reaches its students through the
      // student_assignments pointer, so the permissive gate would open every
      // such session to every studentRole user in the district.
      // No `is list` / `size()` guard on sessionClassIds: hasAny() alone is what
      // the query planner can prove from the client's array-contains-any filter,
      // and either guard makes every student list query unprovable and denied.
      function fcInSessionClass(sessionClassIds) {
        return isStudentRoleUser()
               && request.auth.token.classIds is list
               && sessionClassIds.hasAny(request.auth.token.classIds);
      }

      allow get: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        fcInSessionClass(resource.data.get('classIds', [])) ||
        (isStudentRoleUser() && fcHasPointer())
      );
      // No pointer branch here: exists() per returned doc would blow the
      // per-query document-access cap. Pointer-targeted sessions are hydrated
      // by id through allow get (useStudentAssignments direct getDoc), never
      // by listing this collection.
      allow list: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (resource.data.teacherUid == request.auth.uid
                      || fcInSessionClass(resource.data.get('classIds', [])));
      allow create: if fcTeacherSignedIn()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.kind in ['check', 'study']
                    && request.resource.data.status == 'active'
                    && request.resource.data.classIds is list
                    && request.resource.data.cards is list
                    && request.resource.data.cards.size() > 0
                    && request.resource.data.cards.size() <= 500;
      allow update: if fcTeacherSignedIn()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.status in ['active', 'ended'];
      allow delete: if fcTeacherSignedIn() && resource.data.teacherUid == request.auth.uid;

      match /progress/{studentUid} {
        function fcSession() {
          return get(/databases/$(database)/documents/flashcard_sessions/$(sessionId)).data;
        }
        function fcIsSessionTeacher() {
          return request.auth != null && fcSession().teacherUid == request.auth.uid;
        }
        function fcWithinWindow() {
          return beforeClose(fcSession()) && afterOpen(fcSession());
        }
        function fcValidProgress() {
          let data = request.resource.data;
          return data.keys().hasOnly([
                   'classId', 'cards', 'starred', 'round', 'studyMs', 'modesUsed',
                   'tests', 'lastActiveAt', 'checkLog'
                 ])
                 && data.classId is string
                 && data.cards is map
                 && data.starred is list
                 && data.round is int
                 && data.studyMs is int
                 && data.modesUsed is list
                 && data.tests is list
                 && data.tests.size() <= 50
                 && data.lastActiveAt is int
                 && optMap(data, 'checkLog');
        }

        allow get: if request.auth != null && (
          fcIsSessionTeacher() ||
          (studentUid == request.auth.uid && isStudentRoleUser())
        );
        allow list: if fcIsSessionTeacher();
        allow create, update: if request.auth != null
                              && studentUid == request.auth.uid
                              && isStudentRoleUser()
                              && fcSession().status == 'active'
                              && (fcInSessionClass(fcSession().get('classIds', [])) ||
                                  exists(/databases/$(database)/documents/student_assignments/$(request.auth.uid)/items/$(sessionId)))
                              && fcWithinWindow()
                              && (resource == null || !('submittedAt' in resource.data))
                              && fcValidProgress();
        allow delete: if fcIsSessionTeacher() && notDeactivated();
      }
    }

    // Projects library — teacher-owned reusable project definitions (D12).
    // studentRole tokens denied; students only ever see a run, never the library.
    match /users/{userId}/projects/{projectId} {
      allow read, delete: if ownsUserTeacher(userId);
      allow create: if ownsUserTeacher(userId)
                    && request.resource.data.id == projectId
                    && request.resource.data.title is string
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 32
                    && request.resource.data.createdAt is int
                    && request.resource.data.updatedAt is int;
      allow update: if ownsUserTeacher(userId)
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 32
                    && request.resource.data.updatedAt is int;
    }

    // Projects runs (docs/plans/PROJECTS_WIDGET.md §5.2). One doc per group is
    // required, not preferred: rules cannot gate a partial write to an array
    // inside a single run doc, so "edit only my group" is unenforceable in a
    // one-doc design.
    match /project_runs/{runId} {
      function pjTeacher() {
        return request.auth != null
               && request.auth.token.firebase.sign_in_provider != 'anonymous'
               && !isStudentRoleUser()
               && notDeactivated();
      }
      function pjRun() {
        return get(/databases/$(database)/documents/project_runs/$(runId)).data;
      }
      // Positive student check. passesStudentClassGate*() passes every
      // non-student, so it can never stand as the || alternative to ownership.
      function pjStudentInAnyClass(classIds) {
        return isStudentRoleUser()
               && request.auth.token.classIds is list
               && classIds is list
               && classIds.hasAny(request.auth.token.classIds);
      }
      // notDeactivated() last: it is a get(), and a student never reaches it.
      function pjIsRunTeacher() {
        return request.auth != null
               && pjRun().teacherUid == request.auth.uid
               && notDeactivated();
      }

      // `.get()`, never bare `resource.data.teacherUid`: a bare property read
      // on a list evaluation throws instead of returning false, which fails
      // the whole rule rather than falling through to the student branch.
      allow get: if request.auth != null
                 && ((resource.data.get('teacherUid', '') == request.auth.uid
                      && notDeactivated())
                     || pjStudentInAnyClass(resource.data.get('classIds', [])));
      // A list rule is evaluated ONCE against the query with an EMPTY resource,
      // so every clause must be provable from the client's own filters. These
      // are the only two query shapes the app sends: the teacher's own
      // where('teacherUid','==',uid), and the student page's
      // where('classIds','array-contains-any',ids) whose ids come straight
      // from the caller's own claim. This is `sessionListScoped()` plus the
      // deactivation check, which is why it stays local rather than calling
      // that helper: notDeactivated() must gate the teacher branch only, so a
      // student never pays for its get(). The same two traps apply, both
      // measured on the emulator — the same two traps `sessionListScoped()`
      // carries, hardened against there in #3150.
      function pjRunListScoped() {
        return (resource.data.get('teacherUid', '') == request.auth.uid
                && notDeactivated()) ||
               (request.auth.token.get('classIds', []) is list &&
                resource.data.get('classIds', [])
                  .hasAny(request.auth.token.get('classIds', [])));
      }
      allow list: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && pjRunListScoped();
      allow create: if pjTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.id == runId
                    && request.resource.data.classIds is list
                    && request.resource.data.approvalStepIds is list
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 32
                    && request.resource.data.acceptingUpdates is bool
                    && request.resource.data.showStatusToStudents is bool;
      allow update: if pjTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.classIds is list
                    && request.resource.data.approvalStepIds is list
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 32;
      allow delete: if pjTeacher() && resource.data.teacherUid == request.auth.uid;

      match /groups/{groupId} {
        // A3: student reads gate on the group's own classId, never a get() of
        // the parent run — that would cost a document read per group per render.
        // Which keys a member may touch, and what may go in them. CEL cannot walk
        // `workLinks` to validate each entry, so the list is capped and typed here
        // and its contents stay the client's business.
        function pjStudentEditableFields() {
          let after = request.resource.data;
          return after.diff(resource.data).affectedKeys().hasOnly([
                   'stepStates', 'needsSupport', 'workLinks', 'lastStepChange', 'updatedAt'
                 ])
                 && after.get('needsSupport', false) is bool
                 && after.get('workLinks', []) is list
                 && after.get('workLinks', []).size() <= 20
                 && after.get('updatedAt', 0) is int
                 && after.get('lastStepChange', {}).get('at', 0) is int;
        }
        // Enforces the per-step approval ceiling (D2/D3). CEL cannot walk a map
        // applying a per-key rule, so a student write declares the one step it
        // moved and the rule checks that claim against the real diff.
        function pjStudentStepWrite() {
          let before = resource.data.get('stepStates', {});
          let after = request.resource.data.get('stepStates', {});
          let affected = after.diff(before).affectedKeys();
          let sid = request.resource.data.get('lastStepChange', {}).get('stepId', '');
          return affected.size() == 0
                 || (sid is string
                     && sid.size() > 0
                     && affected == [sid].toSet()
                     && after.get(sid, '') in
                        ['notStarted', 'inProgress', 'readyForReview', 'done']
                     && (!(sid in pjRun().get('approvalStepIds', []))
                         || after.get(sid, '') != 'done'));
        }

        allow get: if request.auth != null
                   && (pjIsRunTeacher()
                       || studentRoleCanAccessClass(resource.data.get('classId', '')));
        allow list: if request.auth != null
                    && (pjIsRunTeacher()
                        || studentRoleCanAccessClass(resource.data.get('classId', '')));
        allow update: if request.auth != null
                      && (pjIsRunTeacher()
                          || (request.auth.uid in resource.data.get('memberUids', [])
                              && pjStudentEditableFields()
                              && pjStudentStepWrite()
                              && pjRun().acceptingUpdates == true));
        allow create, delete: if pjIsRunTeacher();

        // D24: the event log is the teacher's audit trail, never student-visible.
        // Append-only; `actorUid` is pinned to the caller and `actorRole` to what
        // the caller actually is, so an entry can never be forged onto someone
        // else, mislabelled, edited, or deleted.
        match /events/{eventId} {
          allow read: if pjIsRunTeacher();
          allow create: if request.auth != null
                        && request.resource.data.actorUid == request.auth.uid
                        && request.resource.data.at is int
                        && request.resource.data.actorRole
                           == (pjIsRunTeacher() ? 'teacher' : 'student')
                        && request.resource.data.kind in [
                             'stepState', 'needsSupport', 'workLink', 'upload', 'membership'
                           ]
                        && (pjIsRunTeacher()
                            || request.auth.uid in get(
                                 /databases/$(database)/documents/project_runs/$(runId)/groups/$(groupId)
                               ).data.get('memberUids', []));
          allow update, delete: if false;
        }

        // D20 — uploads are a transit record: the client creates one, the
        // archive trigger (admin, rules-exempt) moves it to Drive and clears
        // `storagePath`. Reads are the run teacher and the group's own members
        // only. Unlike `workLinks`, which sit on the class-readable group doc,
        // a file is the group's work product, not a pointer it published.
        match /uploads/{uploadId} {
          // Positive membership, never a helper that passes every non-student.
          function pjUploadMember() {
            return request.auth != null
                   && request.auth.uid in get(
                        /databases/$(database)/documents/project_runs/$(runId)/groups/$(groupId)
                      ).data.get('memberUids', []);
          }
          allow read: if pjIsRunTeacher() || pjUploadMember();
          allow create: if request.auth != null
                        && request.resource.data.uploadedByUid == request.auth.uid
                        && request.resource.data.id == uploadId
                        && request.resource.data.archiveStatus == 'firebase'
                        && request.resource.data.storagePath ==
                             'project_uploads/' + runId + '/' + groupId + '/' + uploadId + '/'
                             + request.resource.data.get('fileName', '')
                        && request.resource.data.fileName is string
                        && request.resource.data.fileName.size() > 0
                        && request.resource.data.contentType is string
                        && request.resource.data.sizeBytes is int
                        && request.resource.data.uploadedAt is int
                        && (pjIsRunTeacher()
                            || (pjUploadMember() && pjRun().acceptingUpdates == true));
          // The archive trigger writes as admin and bypasses rules, so no
          // client ever needs to move an upload's archive state along.
          allow update: if pjIsRunTeacher();
          allow delete: if pjIsRunTeacher() || pjUploadMember();
        }
      }

      // A2: grades live beside the groups, not on them, so a member reading
      // their own group doc can never read an unreleased score.
      match /grades/{groupId} {
        function pjGroupMembers() {
          return get(/databases/$(database)/documents/project_runs/$(runId)/groups/$(groupId))
                 .data.get('memberUids', []);
        }
        allow read: if pjIsRunTeacher()
                    || (request.auth != null
                        && resource.data.get('released', false) == true
                        && request.auth.uid in pjGroupMembers());
        allow write: if pjIsRunTeacher();
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
