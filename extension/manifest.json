{
  "manifest_version": 3,
  "name": "SpartBoard",
  "version": "0.1.2",
  "description": "Live tours of websites, started from SpartBoard.",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "sidePanel",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Record a SpartBoard web tour"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "externally_connectable": {
    "matches": [
      "https://spartboard.web.app/*",
      "https://spartboard.firebaseapp.com/*"
    ]
  }
}
