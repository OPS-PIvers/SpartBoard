{
  "name": "functions",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node ../node_modules/eslint/bin/eslint.js . --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "pnpm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run --reporter=default --reporter=json --outputFile=../.vitest-reports/functions.json"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.9.1",
    "jose": "^4.15.9",
    "oauth-1.0a": "^2.2.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.2.1",
      "lodash": "^4.17.23",
      "protobufjs": "^7.5.6",
      "qs": "^6.15.2",
      "ts-deepmerge": "^8.0.0",
      "browserslist": "^4.28.7",
      "uuid@<11.1.1": "^11.1.1",
      "@opentelemetry/core@<2.8.0": "^2.8.0"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  },
  "private": true
}
