exports[`legacy settings render snapshots > 'settings' slot for 'activity-wall' 1`] = `"<div class="p-4 text-sm text-slate-600 space-y-2"><p class="font-semibold text-slate-700">Walls are managed from the widget face.</p><p>Use the Library button to pick, create, edit, duplicate, or delete a wall. Each wall carries its own layout, appearance, and posting rules.</p></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'blending-board' 1`] = `"<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl text-center flex flex-col items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-speech w-6 h-6 text-slate-400" aria-hidden="true"><path d="M8.8 20v-4.1l1.9.2a2.3 2.3 0 0 0 2.164-2.1V8.3A5.37 5.37 0 0 0 2 8.25c0 2.8.656 3.054 1 4.55a5.77 5.77 0 0 1 .029 2.758L2 20"></path><path d="M19.8 17.8a7.5 7.5 0 0 0 .003-10.603"></path><path d="M17 15a3.5 3.5 0 0 0-.025-4.975"></path></svg><p class="text-sm text-slate-600 leading-relaxed">This widget is centrally managed. Your district administrator configures the embedded URL for all classrooms.</p></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'breathing' 1`] = `"<div class="space-y-6 p-1"><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity w-3 h-3" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Pattern</span><div class="grid grid-cols-1 gap-2" role="group" aria-labelledby="_r_ID_"><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-blue-600 border-blue-600 text-white shadow-sm"><div class="flex justify-between"><span>Box Breathing</span><span class="opacity-70 font-mono text-xxs tracking-widest">4-4-4-4</span></div></button><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-white border-slate-200 text-slate-600 hover:border-slate-300"><div class="flex justify-between"><span>Relaxing Breath</span><span class="opacity-70 font-mono text-xxs tracking-widest">4-7-8</span></div></button><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-white border-slate-200 text-slate-600 hover:border-slate-300"><div class="flex justify-between"><span>Coherent Breath</span><span class="opacity-70 font-mono text-xxs tracking-widest">5-5</span></div></button></div></div></div>"`;

