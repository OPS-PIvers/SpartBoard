exports[`legacy settings render snapshots > 'settings' slot for 'activity-wall' 1`] = `"<div class="p-4 text-sm text-slate-600 space-y-2"><p class="font-semibold text-slate-700">Walls are managed from the widget face.</p><p>Use the Library button to pick, create, edit, duplicate, or delete a wall. Each wall carries its own layout, appearance, and posting rules.</p></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'blending-board' 1`] = `"<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl text-center flex flex-col items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-speech w-6 h-6 text-slate-400" aria-hidden="true"><path d="M8.8 20v-4.1l1.9.2a2.3 2.3 0 0 0 2.164-2.1V8.3A5.37 5.37 0 0 0 2 8.25c0 2.8.656 3.054 1 4.55a5.77 5.77 0 0 1 .029 2.758L2 20"></path><path d="M19.8 17.8a7.5 7.5 0 0 0 .003-10.603"></path><path d="M17 15a3.5 3.5 0 0 0-.025-4.975"></path></svg><p class="text-sm text-slate-600 leading-relaxed">This widget is centrally managed. Your district administrator configures the embedded URL for all classrooms.</p></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'blooms-taxonomy' 1`] = `"<div class="space-y-4 p-4"><div><h3 class="text-sm font-semibold text-white mb-2">Content Categories</h3><p class="text-xs text-slate-400 mb-3">Choose which categories appear when you click a level.</p><div class="space-y-2"><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">Question Stems</label><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">Action Verbs</label><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">Activity Types</label><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">Assessment Ideas</label><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">"I Can…" Statements</label><label class="flex items-center gap-2 cursor-pointer text-sm text-white"><input class="rounded border-slate-500 bg-slate-700 text-indigo-500 focus:ring-indigo-500" type="checkbox" checked="">DOK Alignment</label></div></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'breathing' 1`] = `"<div class="space-y-6 p-1"><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity w-3 h-3" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Pattern</span><div class="grid grid-cols-1 gap-2" role="group" aria-labelledby="_r_ID_"><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-blue-600 border-blue-600 text-white shadow-sm"><div class="flex justify-between"><span>Box Breathing</span><span class="opacity-70 font-mono text-xxs tracking-widest">4-4-4-4</span></div></button><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-white border-slate-200 text-slate-600 hover:border-slate-300"><div class="flex justify-between"><span>Relaxing Breath</span><span class="opacity-70 font-mono text-xxs tracking-widest">4-7-8</span></div></button><button class="p-2 rounded-lg text-xs font-bold transition-all border-2 text-left bg-white border-slate-200 text-slate-600 hover:border-slate-300"><div class="flex justify-between"><span>Coherent Breath</span><span class="opacity-70 font-mono text-xxs tracking-widest">5-5</span></div></button></div></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'calendar' 1`] = `
"<div class="space-y-6"><section><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings2 lucide-settings-2 w-3 h-3" aria-hidden="true"><path d="M14 17H5"></path><path d="M19 7h-9"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg>Display Options</label><div class="bg-slate-50 p-3 rounded-xl border border-slate-100 space-y-4"><div class="flex items-center justify-between"><div class="flex flex-col"><span class="text-sm font-medium text-slate-700">Sync Building Schedule</span></div><button type="button" role="switch" aria-checked="true" class="
        w-11 h-6
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-brand-blue-primary
        cursor-pointer
        
        flex-shrink-0
      "><span class="absolute inset-0 flex items-center justify-between px-1.5 pointer-events-none select-none"><span class="text-xxxs font-black leading-none text-white transition-opacity duration-200 opacity-100">ON</span><span class="text-xxxs font-black leading-none transition-opacity duration-200 text-slate-900 opacity-0">OFF</span></span><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-4 h-4
          translate-x-5
        "></span></button></div><div class="flex items-center justify-between"><div class="flex flex-col"><span class="text-sm font-medium text-slate-700">Days to Display</span><span class="text-xxs text-slate-500">Show events for the next X days</span></div><input min="1" max="30" class="w-16 px-2 py-1 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500" type="number" value="5"></div></div></section><hr class="border-slate-100"><section class="space-y-3"><div class="flex items-center justify-between"><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2 mb-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-3 h-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Personal Google Calendars</label><button class="text-xxs font-black text-blue-500 uppercase tracking-tight flex items-center gap-1 hover:text-blue-600 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark w-3 h-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg> Instructions</button></div><button class="w-full py-2.5 bg-white border-2 border-dashed border-slate-200 rounded-xl text-xs font-black text-slate-500 flex items-center justify-center gap-2 hover:border-blue-400 hover:text-blue-500 transition-all"><div class="w-4 h-4 bg-white shadow-sm border border-slate-100 rounded-full flex items-center justify-center overflow-hidden"><img class="w-3 h-3" alt="" src="https://www.google.com/favicon.ico"></div>Sign in with Google to Sync</button></section><hr class="border-slate-100"><section class="space-y-3"><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 mb-0">Local Manual Events</label><button class="w-full py-2.5 bg-rose-50 text-rose-600 border border-rose-100 rounded-xl text-xs font-black uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-rose-100 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add Local Event</button><div class="space-y-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar"><div class="text-center py-6 text-slate-400 border-2 border-dashed rounded-2xl bg-slate-50/50"><p class="text-xxs italic">No local events added.</p></div></div></section></div>"
`;

exports[`legacy settings render snapshots > 'settings' slot for 'car-rider-pro' 1`] = `"<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl text-center flex flex-col items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-car-front w-6 h-6 text-slate-400" aria-hidden="true"><path d="m21 8-2 2-1.5-3.7A2 2 0 0 0 15.646 5H8.4a2 2 0 0 0-1.903 1.257L5 10 3 8"></path><path d="M7 14h.01"></path><path d="M17 14h.01"></path><rect width="18" height="8" x="3" y="10" rx="2"></rect><path d="M5 18v2"></path><path d="M19 18v2"></path></svg><p class="text-sm text-slate-600 leading-relaxed">This widget is centrally managed. Your district administrator configures the login URL for all classrooms.</p></div>"`;

