talic">Selected materials will appear on the widget face when focused. Tap them to toggle their visibility for students. Your selection and hidden materials carry over to new Materials widgets.</p></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'mathTool' 1`] = `"<div class="space-y-5 p-1"><div class="space-y-2"><span id="mathtoolinstance-tooltype-label-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Tool Type</span><div class="grid grid-cols-2 gap-1" role="radiogroup" aria-labelledby="mathtoolinstance-tooltype-label-legacy-settings-widget"><button type="button" role="radio" aria-checked="true" tabindex="0" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-brand-blue-primary text-white border-brand-blue-primary"><span>📏</span><span class="truncate">Inch Ruler</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>📏</span><span class="truncate">Metric Ruler</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>📐</span><span class="truncate">Protractor</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>〰️</span><span class="truncate">Number Line</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🟦</span><span class="truncate">Base-10 Blocks</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🟩</span><span class="truncate">Fraction Tiles</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🔵</span><span class="truncate">Geoboard</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🔷</span><span class="truncate">Pattern Blocks</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🟪</span><span class="truncate">Algebra Tiles</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>📊</span><span class="truncate">Coordinate Plane</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xxs font-bold border transition-all text-left bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100"><span>🔢</span><span class="truncate">Calculator</span></button></div></div><div class="space-y-2 p-3 bg-brand-blue-lighter/50 rounded-xl border border-brand-blue-lighter"><div class="flex justify-between items-center"><label class="text-xxs font-black text-brand-blue-light uppercase tracking-widest block">Rotation (0°)</label><button class="text-xxs font-black text-brand-blue-primary hover:underline">Reset</button></div><input min="0" max="359" step="1" class="w-full h-1.5 bg-brand-blue-lighter rounded-lg appearance-none cursor-pointer accent-brand-blue-primary" type="range" value="0"><div class="flex gap-1 justify-center mt-1"><button class="px-1.5 py-0.5 text-xxxs font-bold bg-white border border-brand-blue-lighter rounded text-brand-blue-primary hover:bg-brand-blue-lighter">0°</button><button class="px-1.5 py-0.5 text-xxxs font-bold bg-white border border-brand-blue-lighter rounded text-brand-blue-primary hover:bg-brand-blue-lighter">45°</button><button class="px-1.5 py-0.5 text-xxxs font-bold bg-white border border-brand-blue-lighter rounded text-brand-blue-primary hover:bg-brand-blue-lighter">90°</button><button class="px-1.5 py-0.5 text-xxxs font-bold bg-white border border-brand-blue-lighter rounded text-brand-blue-primary hover:bg-brand-blue-lighter">180°</button><button class="px-1.5 py-0.5 text-xxxs font-bold bg-white border border-brand-blue-lighter rounded text-brand-blue-primary hover:bg-brand-blue-lighter">270°</button></div></div><div class="space-y-1"><span id="mathtoolinstance-units-label-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Units Displayed</span><div class="flex gap-1" role="radiogroup" aria-labelledby="mathtoolinstance-units-label-legacy-settings-widget"><button type="button" role="radio" aria-checked="false" tabindex="-1" class="px-2 py-1 rounded-lg text-xxs font-black border transition-all bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100">in</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="px-2 py-1 rounded-lg text-xxs font-black border transition-all bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100">cm</button><button type="button" role="radio" aria-checked="true" tabindex="0" class="px-2 py-1 rounded-lg text-xxs font-black border transition-all bg-yellow-500 text-white border-yellow-500">both</button></div></div><div class="space-y-2 p-3 bg-slate-50 rounded-xl border border-slate-100"><div class="space-y-1"><label for="mathtoolinstance-dpi-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">True-Scale Calibration (px / inch)</label><p class="text-xxs text-slate-400 leading-relaxed">CSS defines 1 in = 96 px. Adjust this if your IFP renders at a different physical DPI. Measure a known object on screen to calibrate.</p></div><div class="flex gap-2 items-center"><input id="mathtoolinstance-dpi-legacy-settings-widget" min="60" max="300" class="w-20 px-2 py-1.5 text-xs bg-white border border-slate-200 rounded-lg" type="number" value="96"><button class="px-3 py-1.5 text-xxs font-black bg-brand-blue-primary text-white rounded-lg hover:bg-brand-blue-dark transition-colors">Apply</button><button class="px-3 py-1.5 text-xxs font-black bg-slate-200 text-slate-600 rounded-lg hover:bg-slate-300 transition-colors">Reset</button></div></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'mathTools' 1`] = `"<div class="space-y-5 p-1"><div class="space-y-2 p-3 bg-brand-blue-lighter rounded-xl border border-brand-blue-lighter"><h3 class="text-xxs font-black text-brand-blue-dark uppercase tracking-widest">Math Tools Palette</h3><p class="text-xxs text-brand-blue-primary leading-relaxed"><strong>Measurement</strong> tools (rulers, protractor) place a true-scale sticker on your board. <strong>Manipulatives</strong> spawn individual tile pieces. <strong>Interactive</strong> tools open full-featured windows.</p></div><div class="space-y-2 p-3 bg-slate-50 rounded-xl border border-slate-100"><label for="mathtools-dpi-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Palette DPI Calibration (px / inch)</label><p class="text-xxs text-slate-400 leading-relaxed">Spawned true-scale tools inherit this PPI. CSS defines 1 in = 96 px — override only if your IFP screen renders differently.</p><div class="flex gap-2 items-center"><input id="mathtools-dpi-legacy-settings-widget" min="60" max="300" class="w-20 px-2 py-1.5 text-xs bg-white border border-slate-200 rounded-lg" type="number" value="96"><button class="px-3 py-1.5 text-xxs font-black bg-brand-blue-primary text-white rounded-lg hover:bg-brand-blue-dark transition-colors">Apply</button><button class="px-2 py-1.5 text-xxs font-black bg-slate-200 text-slate-600 rounded-lg hover:bg-slate-300 transition-colors">Reset</button></div></div><div class="p-3 bg-slate-50 rounded-xl border border-slate-100"><p class="text-xxs text-slate-400 leading-relaxed"><span class="font-black text-slate-600">Grade level filters</span> are configured per tool in Admin Settings → Feature Permissions → Math Tools.</p></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'miniApp' 1`] = `"<div class="text-slate-500 italic text-sm">Manage apps in the main view.</div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'music' 1`] = `
"<div class="space-y-5"><div class="space-y-2"><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music2 lucide-music-2 w-3 h-3" aria-hidden="true"><circle cx="8" cy="18" r="4"></circle><path d="M12 18V2l7 4"></path></svg>Source</span><div class="grid grid-cols-2 gap-2" role="radiogroup" aria-labelledby="_r_ID_"><button type="button" role="radio" aria-checked="true" tabindex="0" title="Pick from stations your admin has added." class="flex items-center gap-2 p-3 rounded-xl border-2 transition-all text-left border-green-500 bg-green-50 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radio w-4 h-4 shrink-0 text-green-700" aria-hidden="true"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg><span class="text-xs font-bold truncate text-green-800">Curated stations</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Connect your own Spotify account (Premium recommended)." class="flex items-center gap-2 p-3 rounded-xl border-2 transition-all text-left border-slate-100 hover:border-slate-300 bg-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music2 lucide-music-2 w-4 h-4 shrink-0 text-slate-500" aria-hidden="true"><circle cx="8" cy="18" r="4"></circle><path d="M12 18V2l7 4"></path></svg><span class="text-xs font-bold truncate text-slate-700">My Spotify</span></button></div></div><div class="space-y-2 pt-1 border-t border-slate-100"><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid w-3 h-3" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>Layout</span><div class="grid grid-cols-3 gap-2" role="radiogroup" aria-labelledby="_r_ID_"><button type="button" role="radio" aria-checked="true" tabindex="0" title="Thumbnail + info, adapts to widget size" class="flex flex-col items-center gap-1.5 p-2 rounded-xl border-2 transition-all text-center border-indigo-500 bg-indigo-50 shadow-sm"><svg viewBox="0 0 36 24" class="w-9 h-6" fill="none"><rect width="36" height="24" rx="3" fill="#f1f5f9"></rect><rect x="3" y="3" width="12" height="18" rx="2" fill="#cbd5e1"></rect><rect x="18" y="5" width="15" height="4" rx="1.5" fill="#94a3b8"></rect><rect x="18" y="12" width="11" height="3" rx="1.5" fill="#cbd5e1"></rect></svg><span class="text-xxs font-bold block w-full truncate text-indigo-700">Default</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Full-bleed thumbnail with centered play button" class="flex flex-col items-center gap-1.5 p-2 rounded-xl border-2 transition-all text-center border-slate-100 hover:border-slate-300 bg-white"><svg viewBox="0 0 36 24" class="w-9 h-6" fill="none"><rect width="36" height="24" rx="3" fill="#cbd5e1"></rect><circle cx="18" cy="10" r="5" fill="white" fill-opacity="0.9"></circle><polygon points="16,8 16,12 21,10" fill="#1e293b"></polygon><rect x="0" y="17" width="36" height="7" rx="3" fill="black" fill-opacity="0.55"></rect><rect x="3" y="19" width="14" height="2" rx="1" fill="white" fill-opacity="0.8"></rect></svg><span class="text-xxs font-bold block w-full truncate text-slate-600">Minimal</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Compact horizontal bar — thumbnail left, scrolling title right" class="flex flex-col items-center gap-1.5 p-2 rounded-xl border-2 transition-all text-center border-slate-100 hover:border-slate-300 bg-white"><svg viewBox="0 0 36 24" class="w-9 h-6" fill="none"><rect width="36" height="24" rx="3" fill="#f1f5f9"></rect><rect x="3" y="4" width="10" height="16" rx="2" fill="#cbd5e1"></rect><rect x="16" y="8" width="17" height="3" rx="1.5" fill="#94a3b8"></rect><rect x="16" y="14" width="12" height="2" rx="1" fill="#cbd5e1"></rect></svg><span class="text-xxs font-bold block w-full truncate text-slate-600">Small</span></button></div></div><div class="space-y-2 pt-1 border-t border-slate-100"><p class="text-xs font-semibold text-slate-500 uppercase tracking-wider pt-4">Select a Station</p><p class="text-xs text-slate-400 animate-pulse">Loading stations...</p></div><div class="pt-4 border-t border-slate-100"><div class="flex items-center justify-between"><span class="text-sm font-medium text-slate-700">Sync with Time Tool</span><button type="button" role="switch" aria-checked="false" class="
        w-10 h-5
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-slate-300
        cursor-pointer
        
        flex-shrink-0
      "><span class="absolute inset-0 flex items-center justify-between px-1.5 pointer-events-none select-none"><span class="text-xxxs font-black leading-none text-white transition-opacity duration-200 opacity-0">ON</span><span class="text-xxxs font-black leading-none transition-opacity duration-200 text-slate-900 opacity-100">OFF</span></span><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-0
        "></span></button></div><p class="text-xs text-slate-400 mt-1.5">Music will automatically play and pause with your active Time Tool.</p></div></div>"
`;

