exports[`legacy settings render snapshots > 'settings' slot for 'concept-web' 1`] = `"<div class="space-y-4 p-4 text-slate-800"><div class="space-y-2"><label for="defaultNodeWidth" class="block text-sm font-medium mb-1">Default Node Width (15%)</label><input id="defaultNodeWidth" min="5" max="50" class="w-full" type="range" value="15"><label for="defaultNodeHeight" class="block text-sm font-medium mb-1">Default Node Height (15%)</label><input id="defaultNodeHeight" min="5" max="50" class="w-full" type="range" value="15"><div class="mt-4 border border-slate-200 rounded-xl p-4 bg-slate-50 flex items-center justify-center min-h-[150px] relative overflow-hidden"><div class="absolute shadow-sm border border-slate-300 flex flex-col items-center justify-center p-2 rounded-lg" style="width: 15%; height: 15%; background-color: rgb(253, 240, 213); container-type: size;"><textarea class="w-full h-full text-center bg-transparent border-none resize-none focus:outline-none focus:ring-1 focus:ring-slate-400 rounded-sm font-medium text-slate-800 leading-tight" style="font-size: 15cqmin;" readonly="">Idea...</textarea></div></div><p class="text-xs text-slate-500 mt-1">These dimensions apply to new nodes. You can still resize nodes individually!</p></div><div class="border-t border-slate-200 pt-4"><button class="w-full py-2 px-4 bg-rose-100 text-rose-700 rounded-lg hover:bg-rose-200 transition-colors font-medium">Clear All Nodes &amp; Edges</button></div></div>"`;

