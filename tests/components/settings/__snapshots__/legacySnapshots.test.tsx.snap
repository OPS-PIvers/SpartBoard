color hex value" type="text" value="#1e293b"></div></div><div><div class="mb-1 flex items-center justify-between text-xs font-bold text-slate-500"><span>Opacity</span><span>100%</span></div><input min="0" max="1" step="0.05" class="w-full accent-indigo-600" aria-label="Pip Color opacity" type="range" value="1"></div></div></div></div><div class="p-4 bg-purple-50 rounded-2xl border border-purple-100"><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2 text-purple-700 mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dices w-3 h-3" aria-hidden="true"><rect width="12" height="12" x="2" y="10" rx="2" ry="2"></rect><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6"></path><path d="M6 18h.01"></path><path d="M10 14h.01"></path><path d="M15 6h.01"></path><path d="M18 9h.01"></path></svg>Instructions</label><p class="text-xxs text-purple-600 leading-relaxed font-medium">Select between 1 and 6 dice and customize their appearance to match your classroom theme. The dice scale automatically to fit your screen.</p></div></div>"
`;

exports[`legacy settings render snapshots > 'settings' slot for 'drawing' 1`] = `"<div class="space-y-6"><div><span id="drawing-color-presets-label-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette w-3 h-3" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Color Presets</span><div role="group" aria-labelledby="drawing-color-presets-label-legacy-settings-widget" class="flex gap-2 px-2"><div class="w-8 h-8 rounded-lg border-2 border-white shadow-sm ring-1 ring-slate-200 relative overflow-hidden transition-transform hover:scale-110" style="background-color: rgb(30, 41, 59);"><input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" title="Change preset color" type="color" value="#1e293b"></div><div class="w-8 h-8 rounded-lg border-2 border-white shadow-sm ring-1 ring-slate-200 relative overflow-hidden transition-transform hover:scale-110" style="background-color: rgb(239, 68, 68);"><input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" title="Change preset color" type="color" value="#ef4444"></div><div class="w-8 h-8 rounded-lg border-2 border-white shadow-sm ring-1 ring-slate-200 relative overflow-hidden transition-transform hover:scale-110" style="background-color: rgb(245, 158, 11);"><input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" title="Change preset color" type="color" value="#f59e0b"></div><div class="w-8 h-8 rounded-lg border-2 border-white shadow-sm ring-1 ring-slate-200 relative overflow-hidden transition-transform hover:scale-110" style="background-color: rgb(16, 185, 129);"><input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" title="Change preset color" type="color" value="#10b981"></div><div class="w-8 h-8 rounded-lg border-2 border-white shadow-sm ring-1 ring-slate-200 relative overflow-hidden transition-transform hover:scale-110" style="background-color: rgb(59, 130, 246);"><input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" title="Change preset color" type="color" value="#3b82f6"></div></div></div><div><label for="drawing-brush-thickness-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil w-3 h-3" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg>Brush Thickness</label><div class="flex items-center gap-4 px-2"><input id="drawing-brush-thickness-legacy-settings-widget" min="1" max="80" step="1" class="flex-1 accent-indigo-600 h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer" type="range" value="4"><span class="w-10 text-center font-mono  text-slate-700 text-sm">4px</span></div></div><div><span id="drawing-background-label-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid w-3 h-3" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>Background</span><div role="group" aria-labelledby="drawing-background-label-legacy-settings-widget" class="flex gap-2 px-2"><button type="button" aria-pressed="true" aria-label="Blank" class="flex-1 flex flex-col items-center gap-1.5 p-1.5 rounded-lg border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white border-indigo-500 bg-indigo-50" title="Blank"><div class="w-10 h-7 rounded border border-slate-200 bg-slate-50" aria-hidden="true"></div><span class="text-xxs text-slate-700">Blank</span></button><button type="button" aria-pressed="false" aria-label="Grid" class="flex-1 flex flex-col items-center gap-1.5 p-1.5 rounded-lg border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white border-slate-200 hover:border-slate-300 bg-white" title="Grid"><div class="w-10 h-7 rounded border border-slate-200 bg-slate-50" style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.25) 0 1px, transparent 1px 100%), linear-gradient(rgba(148, 163, 184, 0.25) 0 1px, transparent 1px 100%); background-size: 24px 24px;" aria-hidden="true"></div><span class="text-xxs text-slate-700">Grid</span></button><button type="button" aria-pressed="false" aria-label="Lines" class="flex-1 flex flex-col items-center gap-1.5 p-1.5 rounded-lg border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white border-slate-200 hover:border-slate-300 bg-white" title="Lines"><div class="w-10 h-7 rounded border border-slate-200 bg-slate-50" style="background-image: linear-gradient(rgba(148, 163, 184, 0.25) 0 1px, transparent 1px 100%); background-size: 100% 32px;" aria-hidden="true"></div><span class="text-xxs text-slate-700">Lines</span></button><button type="button" aria-pressed="false" aria-label="Dots" class="flex-1 flex flex-col items-center gap-1.5 p-1.5 rounded-lg border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white border-slate-200 hover:border-slate-300 bg-white" title="Dots"><div class="w-10 h-7 rounded border border-slate-200 bg-slate-50" style="background-image: radial-gradient(rgba(148, 163, 184, 0.45) 1px, transparent 1.5px); background-size: 24px 24px;" aria-hidden="true"></div><span class="text-xxs text-slate-700">Dots</span></button></div></div><div><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square w-3 h-3" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg>Shape Fill</label><label class="flex items-center gap-2 cursor-pointer text-sm text-slate-700 px-2"><input class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox">Fill rectangles and ellipses with the current color</label></div><div class="p-4 bg-indigo-50 rounded-2xl border border-indigo-100"><p class="text-xxs text-indigo-600 leading-relaxed"><b>Tip:</b> To annotate over your whole dashboard, click the <b>pencil</b> in the floating toolbar at the top-left of your board. The whiteboard widget here is best for persistent sketches and notes.</p></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'expectations' 1`] = `
"<div class="space-y-6"><div><label class="text-xxs text-slate-400 uppercase tracking-widest mb-3 block flex items-center gap-2">Nexus Connections</label><div class="w-full p-4 rounded-xl border-2 flex items-center justify-between transition-all border-slate-100 bg-white text-slate-500"><div class="flex flex-col items-start gap-1"><span class="text-sm font-bold tracking-tight">Auto-Adjust Sound Meter</span><span class="text-xxs text-slate-500 text-left leading-tight">Automatically adjust Sound widget sensitivity based on the current Voice Level expectation.</span></div><button type="button" role="switch" aria-checked="false" aria-label="Auto-Adjust Sound Meter" class="
        w-10 h-5
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-slate-300
        cursor-pointer
        
        flex-shrink-0
      "><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-0
        "></span></button></div></div></div>"
`;

exports[`legacy settings render snapshots > 'settings' slot for 'first-5' 1`] = `"<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl text-center flex flex-col items-center gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-slate-400"><text x="12" y="18" text-anchor="middle" fill="currentColor" stroke="none" font-size="18" font-weight="bold" font-family="sans-serif">5</text></svg><p class="text-sm text-slate-600 leading-relaxed">This widget automatically shows today's First 5 content based on your selected building. The content updates each weekday at 6:00 AM.</p></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'graphic-organizer' 1`] = `"<div class="p-4 space-y-4 text-slate-800"><div class="space-y-2"><label class="block text-sm font-medium">Template Type</label><select class="w-full p-2 bg-white border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"><option value="frayer">Frayer Model</option><option value="t-chart">T-Chart</option><option value="venn">Venn Diagram</option><option value="kwl">KWL Chart</option><option value="cause-effect">Cause &amp; Effect</option></select></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'guided-learning' 1`] = `"<div class="p-4 space-y-4"><h3 class="text-white font-semibold text-sm">Guided Learning Settings</h3><div class="text-slate-400 text-xs">Use the main widget panel to create, edit, and assign guided learning sets. Settings are configured per-set inside the editor.</div><button class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm rounded-lg transition-colors">Go to Library</button></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'hotspot-image' 1`] = `"<div class="space-y-6"><div><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Base Image</label><div class="flex flex-col gap-2"><button class="transition flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-2 focus-visible:ring-offset-white disabled:opacity-50 disabled:cursor-not-allowed bg-brand-blue-primary text-white shadow-sm hover:bg-brand-blue-light px-4 py-2 text-xxs font-black uppercase tracking-widest rounded-lg w-full flex justify-center items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload w-4 h-4" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg>Upload Image</button><input accept="image/*" class="hidden" type="file"></div></div><div><label class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Saved Library</label><div class="space-y-2"><p class="text-xs text-slate-500 italic">No saved hotspots yet.</p></div></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'instructionalRoutines' 1`] = `"<div class="space-y-6"><button class="w-full py-2.5 bg-brand-blue-lighter text-brand-blue-primary rounded-xl text-xxs uppercase tracking-widest hover:bg-brand-blue-light/20 transition-colors">Switch Routine Template</button><div class="space-y-3" role="group" aria-labelledby="instructional-routines-step-editor-label-legacy-settings-widget"><span id="instructional-routines-step-editor-label-legacy-settings-widget" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2">Step Editor</span><button class="w-full py-4 border-2 border-dashed border-slate-200 rounded-2xl text-slate-400 hover:border-brand-blue-primary hover:text-brand-blue-primary transition-all flex items-center justify-center gap-2 text-xxs uppercase"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add Next Step</button></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'materials' 1`] = `"<div class="flex flex-col gap-6 p-1"><div class="space-y-4"><div><label for="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-line w-3 h-3" aria-hidden="true"><path d="M13 21h8"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>Title Text</label><input id="_r_ID_" placeholder="What you need" class="w-full p-2 text-sm border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" type="text" value="What you need"></div><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type w-3 h-3" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg>Typography</span><div class="grid grid-cols-4 gap-2" role="group" aria-labelledby="_r_ID_"><button class="p-2 rounded-lg border-2 flex flex-col items-center gap-1 transition-all border-blue-500 bg-blue-50 shadow-sm"><span class="text-sm global text-slate-900">G</span><span class="text-xxxs font-black uppercase text-slate-500 tracking-tighter text-center leading-none">Inherit</span></button><button class="p-2 rounded-lg border-2 flex flex-col items-center gap-1 transition-all border-slate-100 hover:border-slate-200"><span class="text-sm font-mono text-slate-900">01</span><span class="text-xxxs font-black uppercase text-slate-500 tracking-tighter text-center leading-none">Digital</span></button><button class="p-2 rounded-lg border-2 flex flex-col items-center gap-1 transition-all border-slate-100 hover:border-slate-200"><span class="text-sm font-sans text-slate-900">Aa</span><span class="text-xxxs font-black uppercase text-slate-500 tracking-tighter text-center leading-none">Modern</span></button><button class="p-2 rounded-lg border-2 flex flex-col items-center gap-1 transition-all border-slate-100 hover:border-slate-200"><span class="text-sm font-handwritten text-slate-900">✏️</span><span class="text-xxxs font-black uppercase text-slate-500 tracking-tighter text-center leading-none">School</span></button></div></div><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette w-3 h-3" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Title Color</span><div class="flex flex-wrap gap-2" role="group" aria-labelledby="_r_ID_"><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(30, 41, 59);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(239, 68, 68);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(245, 158, 11);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(16, 185, 129);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(59, 130, 246);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(139, 92, 246);"></button><button class="w-6 h-6 rounded-full border-2 transition-all border-transparent hover:scale-110" style="background-color: rgb(236, 72, 153);"></button></div></div></div><hr class="border-slate-100"><div class="space-y-4"><div class="flex items-center justify-between gap-2"><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 mb-0">Available Materials</span><div class="flex items-center gap-3"><button class="flex items-center gap-1 text-xs text-blue-600 font-bold hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Add</button><button class="text-xs text-blue-600 font-bold hover:underline">Select All</button></div></div><div class="flex flex-col gap-2 max-h-[280px] overflow-y-auto pr-1" role="group" aria-labelledby="_r_ID_"><div class="flex items-center rounded-lg border transition-all bg-white border-slate-200 hover:bg-slate-50"><button class="flex flex-1 min-w-0 items-center gap-3 p-2 text-left"><div class="w-4 h-4 rounded border flex items-center justify-center flex-shrink-0 transition-colors bg-white border-slate-300"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucid