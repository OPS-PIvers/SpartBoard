 type="button" class="w-8 h-8 rounded-full border-2 transition-all border-transparent hover:scale-105" style="background-color: rgb(244, 63, 94);" aria-label="Pick #f43f5e" aria-pressed="false"></button></div></div></div><button type="button" disabled="" class="w-full mt-2 flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white px-4 py-2 rounded-xl font-bold transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Add Link</button></div></div>"`;

exports[`legacy settings render snapshots > 'settings' slot for 'video-activity' 1`] = `
"<div class="p-5 h-full flex flex-col font-sans relative"><div class="flex items-center gap-2 text-brand-blue-dark mb-4 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-play w-5 h-5 text-brand-red-primary" aria-hidden="true"><path d="M9 9.003a1 1 0 0 1 1.517-.859l4.997 2.997a1 1 0 0 1 0 1.718l-4.997 2.997A1 1 0 0 1 9 14.996z"></path><circle cx="12" cy="12" r="10"></circle></svg><span class="font-bold text-base">Video Activity Settings</span></div><div class="flex-1 overflow-y-auto min-h-0 pr-2 pb-4 -mr-2 space-y-4"><div class="bg-white rounded-xl border border-slate-200 p-4 space-y-4"><div class="flex items-center gap-2 text-slate-700 mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings2 lucide-settings-2 w-4 h-4 text-brand-blue-primary" aria-hidden="true"><path d="M14 17H5"></path><path d="M19 7h-9"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg><h3 class="font-bold text-sm">Session Defaults</h3></div><div class="space-y-4"><div class="flex items-center justify-between"><div><span class="text-sm font-bold text-slate-700 block">Auto-Play Video</span><span class="text-xs text-slate-500">Video starts playing automatically when a student joins</span></div><button type="button" role="switch" aria-checked="false" class="
        w-10 h-5
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-slate-300
        cursor-pointer
        
        flex-shrink-0
      "><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-0
        "></span></button></div><div class="w-full h-px bg-slate-100"></div><div class="flex items-center justify-between"><div><span class="text-sm font-bold text-slate-700 block">Require Correct Answers</span><span class="text-xs text-slate-500">Students must answer correctly to resume the video</span></div><button type="button" role="switch" aria-checked="true" class="
        w-10 h-5
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-brand-blue-primary
        cursor-pointer
        
        flex-shrink-0
      "><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-5
        "></span></button></div><div class="w-full h-px bg-slate-100"></div><div class="flex items-center justify-between"><div><span class="text-sm font-bold text-slate-700 block">Allow Skipping</span><span class="text-xs text-slate-500">Students can skip questions without answering</span></div><button type="button" role="switch" aria-checked="false" class="
        w-10 h-5
        rounded-full relative transition-colors duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue-primary
        bg-slate-300
        cursor-pointer
        
        flex-shrink-0
      "><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-0
        "></span></button></div></div></div><div class="text-sm text-slate-500 leading-relaxed px-1"><p>Flip the widget back to manage your activities, create new ones, and share session links with students.</p></div></div><div class="mt-2 shrink-0 bg-brand-blue-lighter/30 rounded-xl p-3 text-xs text-brand-blue-primary/70 font-medium">Student experience: share the session link at <code class="bg-brand-blue-lighter/50 px-1 rounded font-mono">/activity/:sessionId</code></div></div>"
`;

exports[`legacy settings render snapshots > 'settings' slot for 'weather' 1`] = `
"<div class="space-y-6"><div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200"><div class="flex flex-col gap-0.5"><span class="text-xxs font-bold text-slate-700 uppercase tracking-tight">Prioritize Feels Like</span><span class="text-xxs text-slate-400 leading-tight">Swap prominence between actual and feels-like temperature.</span></div><button type="button" role="switch" aria-checked="false" class="
