                flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all
                border-slate-100 text-slate-400 hover:border-slate-200
              "><span class="text-lg font-bold ">6</span><span class="text-[10px] uppercase font-black">Dice</span></button></div></div><div class="space-y-4"><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette w-3 h-3" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Die Color</span><div class="space-y-3 rounded-xl border border-slate-100 bg-slate-50 p-3" role="group" aria-labelledby="_r_ID_"><div><div class="flex flex-wrap items-center gap-2" role="radiogroup" aria-label="Die color"><button type="button" role="radio" aria-checked="true" tabindex="0" title="White" aria-label="Select die color White" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 ring-2 ring-brand-blue-primary ring-offset-2 ring-offset-slate-50 border border-slate-300" style="background-color: rgb(255, 255, 255);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Slate" aria-label="Select die color Slate" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-slate-300" style="background-color: rgb(248, 250, 252);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Indigo" aria-label="Select die color Indigo" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-slate-300" style="background-color: rgb(238, 242, 255);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Amber" aria-label="Select die color Amber" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-slate-300" style="background-color: rgb(254, 243, 199);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Charcoal" aria-label="Select die color Charcoal" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-transparent" style="background-color: rgb(30, 41, 59);"></button><span class="mx-0.5 h-5 w-px bg-slate-200" aria-hidden="true"></span><label title="Custom color" class="relative h-7 w-7 shrink-0 cursor-pointer overflow-hidden rounded-full border border-slate-300 focus-within:ring-2 focus-within:ring-brand-blue-primary focus-within:ring-offset-1"><span aria-hidden="true" class="absolute inset-0 rounded-full" style="background: conic-gradient(from 90deg, rgb(248, 113, 113), rgb(251, 191, 36), rgb(74, 222, 128), rgb(56, 189, 248), rgb(167, 139, 250), rgb(248, 113, 113));"></span><span aria-hidden="true" class="absolute inset-[5px] rounded-full border border-white/70" style="background-color: rgb(255, 255, 255);"></span><input class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Custom die color" type="color" value="#ffffff"></label><input spellcheck="false" maxlength="7" class="h-7 w-[4.75rem] rounded-md border border-slate-200 bg-white px-2 font-mono text-xs text-slate-700 focus:border-brand-blue-primary focus:outline-none focus:ring-1 focus:ring-brand-blue-primary" aria-label="Die color hex value" type="text" value="#ffffff"></div></div><div><div class="mb-1 flex items-center justify-between text-xs font-bold text-slate-500"><span>Opacity</span><span>100%</span></div><input min="0" max="1" step="0.05" class="w-full accent-indigo-600" aria-label="Die Color opacity" type="range" value="1"></div></div></div><div><span id="_r_ID_" class="text-xxs font-black text-slate-400 uppercase tracking-widest block mb-2 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle w-3 h-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg>Pip Color</span><div class="space-y-3 rounded-xl border border-slate-100 bg-slate-50 p-3" role="group" aria-labelledby="_r_ID_"><div><div class="flex flex-wrap items-center gap-2" role="radiogroup" aria-label="Pip color"><button type="button" role="radio" aria-checked="false" tabindex="-1" title="White" aria-label="Select pip color White" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-slate-300" style="background-color: rgb(255, 255, 255);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Slate" aria-label="Select pip color Slate" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-primary focus-visible:ring-offset-1 hover:scale-110 border border-slate-300" style="background-color: rgb(248, 250, 252);"></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Indigo" aria-label="Select pip color Indigo" class="h-7 w-7 rounded-full transition focus-visible:outline-none focus-visible:ring-2 focus