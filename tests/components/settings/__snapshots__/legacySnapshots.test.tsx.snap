exports[`legacy settings render snapshots > 'settings' slot for 'activity-wall' 1`] = `"<div class="p-4 text-sm text-slate-600 space-y-2"><p class="font-semibold text-slate-700">Walls are managed from the widget face.</p><p>Use the Library button to pick, create, edit, duplicate, or delete a wall. Each wall carries its own layout, appearance, and posting rules.</p></div>"`;

