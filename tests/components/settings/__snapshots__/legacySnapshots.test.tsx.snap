        bg-slate-300
        cursor-pointer
        
        flex-shrink-0
      "><span class="absolute inset-0 flex items-center justify-between px-1.5 pointer-events-none select-none"><span class="text-xxxs font-black leading-none text-white transition-opacity duration-200 opacity-0">ON</span><span class="text-xxxs font-black leading-none transition-opacity duration-200 text-slate-900 opacity-100">OFF</span></span><span class="
          absolute top-1 left-1
          bg-white rounded-full shadow transition-transform duration-200 ease-in-out
          w-3 h-3
          translate-x-0
        "></span></button></div><div class="flex bg-slate-100 p-1 rounded-xl"><button class="flex-1 py-1.5 text-xxs font-black uppercase rounded-lg transition-all text-slate-500">Manual</button><button class="flex-1 py-1.5 text-xxs font-black uppercase rounded-lg transition-all bg-white shadow-sm text-indigo-600">Automatic</button></div><div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300"><div class="flex bg-slate-100 p-1 rounded-xl mb-4"><button class="flex-1 py-1.5 text-xxs  uppercase font-black rounded-lg transition-all bg-white shadow-sm text-indigo-600">OpenWeather</button><button class="flex-1 py-1.5 text-xxs  uppercase font-black rounded-lg transition-all text-slate-500">School Station</button></div><div><label for="weather-city-legacy-settings-widget" class="text-xxs  text-slate-400 uppercase tracking-widest mb-2 block flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-3 h-3" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg> City / Zip</label><div class="flex gap-2"><input id="weather-city-legacy-settings-widget" placeholder="e.g. London, US" class="flex-1 p-2.5 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-slate-900 disabled:opacity-50 disabled:bg-slate-50" type="text" value=""><button class="p-2.5 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 disabled:opacity-50 transition-colors shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw w-4 h-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></button></div></div><div class="relative"><div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div><div class="relative flex justify-center text-xxxs font-black  text-slate-300 uppercase tracking-widest"><span class="bg-white px-2">OR</span></div></div><button class="w-full py-3 border-2 border-indigo-100 text-indigo-600 rounded-xl  text-xxs font-black uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-indigo-50 transition-all disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-4 h-4" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg> Use Current Location</button></div></div>"
`;

