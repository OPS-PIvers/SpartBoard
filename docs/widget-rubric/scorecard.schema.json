{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spartboard.web.app/docs/widget-rubric/scorecard.schema.json",
  "title": "Widget scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "widgetType",
    "rubricVersion",
    "gradedAt",
    "stale",
    "criteria",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "widgetType": { "type": "string", "minLength": 1 },
    "rubricVersion": { "$ref": "#/definitions/semver" },
    "gradedAt": {
      "oneOf": [{ "$ref": "#/definitions/timestamp" }, { "type": "null" }]
    },
    "stale": { "type": "boolean" },
    "criteria": {
      "type": "object",
      "propertyNames": { "pattern": "^[SIVCRE][0-9]+$" },
      "additionalProperties": { "$ref": "#/definitions/criterionScore" }
    },
    "gates": {
      "type": "object",
      "propertyNames": { "enum": ["G1", "G2", "G3", "G4"] },
      "additionalProperties": { "$ref": "#/definitions/gateResult" }
    }
  },
  "definitions": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "level": { "type": "integer", "minimum": 0, "maximum": 4 },
    "source": { "enum": ["script", "judge", "paul"] },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetType", "criterionId", "size", "fixture", "values"],
      "properties": {
        "widgetType": { "type": "string" },
        "criterionId": {
          "oneOf": [
            { "type": "string", "pattern": "^[SIVCRE][0-9]+$" },
            { "type": "null" }
          ]
        },
        "size": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "width", "height"],
              "properties": {
                "name": {
                  "enum": [
                    "envelope-min",
                    "default",
                    "large-1400x900",
                    "maximized-1920x1080",
                    "widest-aspect",
                    "tallest-aspect"
                  ]
                },
                "width": { "type": "number", "minimum": 0 },
                "height": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "fixture": {
          "oneOf": [
            { "enum": ["empty", "typical", "stress"] },
            { "type": "null" }
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        },
        "impliedLevel": {
          "oneOf": [{ "$ref": "#/definitions/level" }, { "type": "null" }]
        },
        "gate": { "enum": ["G1", "G2", "G3", "G4"] },
        "pass": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurements": {
          "type": "array",
          "items": { "$ref": "#/definitions/measurement" }
        },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "runId": { "type": "string" }
      }
    },
    "criterionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "source", "rubricVersion", "gradedAt", "stale"],
      "properties": {
        "score": {
          "oneOf": [{ "$ref": "#/definitions/level" }, { "type": "null" }]
        },
        "source": { "$ref": "#/definitions/source" },
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script": {
              "oneOf": [{ "$ref": "#/definitions/level" }, { "type": "null" }]
            },
            "judge": {
              "oneOf": [{ "$ref": "#/definitions/level" }, { "type": "null" }]
            },
            "paul": {
              "oneOf": [{ "$ref": "#/definitions/level" }, { "type": "null" }]
            }
          }
        },
        "evidence": { "$ref": "#/definitions/evidence" },
        "note": { "type": "string" },
        "rubricVersion": { "$ref": "#/definitions/semver" },
        "gradedAt": { "$ref": "#/definitions/timestamp" },
        "stale": { "type": "boolean" }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "gradedAt"],
      "properties": {
        "pass": { "type": "boolean" },
        "evidence": { "$ref": "#/definitions/evidence" },
        "gradedAt": { "$ref": "#/definitions/timestamp" }
      }
    }
  }
}
