+/** Drop a deleted roster's retired PINs so they can't block a later roster's holders. */
+export async function deleteRetiredPinsForRoster(
+  db: admin.firestore.Firestore,
+  teacherUid: string,
+  rosterId: string
+): Promise<void> {
+  const snap = await db
+    .collection('users')
+    .doc(teacherUid)
+    .collection(RETIRED_PINS_SUBCOLLECTION)
+    .where('rosterId', '==', rosterId)
+    .get();
+  for (const docs of chunk(snap.docs, 400)) {
+    const batch = db.batch();
+    docs.forEach((d) => batch.delete(d.ref));
+    await batch.commit();
+  }
+}
+
+export const cleanupRetiredPinsOnRosterDelete = onDocumentDeleted(
+  {
+    document: 'users/{uid}/rosters/{rosterId}',
+    memory: '256MiB',
+    maxInstances: 5,
+  },
+  async (event) => {
+    await deleteRetiredPinsForRoster(
+      admin.firestore(),
+      event.params.uid,
+      event.params.rosterId
+    );
+  }
+);
+
 // Per (session, caller uid) limits. Seat PINs are short, so a caller that keeps
