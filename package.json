{
  "name": "spart-board",
  "description": "SpartBoard Application",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/generate-version.js && vite",
    "dev:prod": "node scripts/generate-version.js && vite --mode prod-local",
    "build": "node scripts/generate-version.js && vite build && vite build --config vite.prerender.config.ts && node dist-ssr/prerender-legal.js",
    "changelog:draft": "node scripts/draft-changelog-entry.js",
    "preview": "vite preview",
    "lint": "pnpm run lint:app && pnpm run lint:functions",
    "lint:app": "node scripts/lintApp.mjs",
    "lint:functions": "pnpm -C functions run lint",
    "lint:fix": "eslint . --fix && pnpm -C functions run lint:fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "install:ci": "pnpm install --frozen-lockfile && pnpm -C functions install --frozen-lockfile",
    "install:all": "pnpm install && pnpm -C functions install",
    "build:all": "pnpm run build && pnpm -C functions run build",
    "type-check:all": "pnpm run type-check && pnpm -C functions run type-check",
    "lint:all": "pnpm run lint",
    "validate": "pnpm run type-check:all && pnpm lint && pnpm format:check && pnpm run check:rules-size && pnpm test && pnpm -C functions test && pnpm run test:counts",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.vitest-reports/root.json",
    "test:shard": "vitest run --reporter=default --reporter=json",
    "test:merge-reports": "node scripts/mergeVitestReports.mjs",
    "test:all": "pnpm test && pnpm -C functions test && pnpm run test:counts",
    "check:rules-size": "node scripts/checkRulesSize.mjs",
    "test:counts": "node scripts/checkTestCounts.mjs",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node scripts/runRulesTests.mjs\"",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:import-corpus": "vitest run --config vitest.corpus.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "new-widget-settings": "node scripts/new-widget-settings.ts",
    "grader:affected": "node scripts/widget-grader/affected.ts",
    "grader:gates": "node scripts/widget-grader/run.ts --gates-only --check-baseline",
    "grader:measure": "node scripts/widget-grader/run.ts",
    "grader:static": "node scripts/widget-grader/static/run.ts",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.13.0",
      "basic-ftp": "^6.2.1",
      "@grpc/grpc-js": "^1.14.5",
      "postcss-selector-parser": "^7.1.6",
      "dompurify": "^3.4.11",
      "diff": "^8.0.3",
      "flatted": "^3.4.2",
      "tar": "^7.5.19",
      "lodash": "^4.17.23",
      "lodash-es": "^4.18.1",
      "ws@8": "^8.20.1",
      "yaml": "^2.8.3",
      "rollup": "^4.59.0",
      "protobufjs": "^7.5.6",
      "path-to-regexp@0.1": "^0.1.13",
      "path-to-regexp@8": "^8.4.0",
      "@hono/node-server": "^1.19.13",
      "browserslist": "^4.28.7",
      "uuid@<11.1.1": "^11.1.1",
      "ts-deepmerge": "^8.0.0",
      "@opentelemetry/core@<2.8.0": "^2.8.0"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@imgly/background-removal": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.16",
    "firebase": "^13.0.0",
    "fuse.js": "^7.5.0",
    "heic-to": "1.6.5",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lib0": "^0.2.119",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@google/genai": "^2.28.0",
    "@playwright/test": "~1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/gapi": "^0.0.47",
    "@types/google.accounts": "^0.0.18",
    "@types/google.picker": "^0.0.52",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tesseract.js": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "~8.71.1",
    "@typescript-eslint/parser": "~8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oauth-1.0a": "^2.2.6",
    "postcss": "^8.5.29",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "functions/**/*.{ts,tsx}": [
      "pnpm -C functions exec eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
