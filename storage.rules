rules_version = '2';

// auth.token.email is the email of the authenticated user
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is an admin in Firestore
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Helper function to check if a user can read a specific admin background
    function canReadAdminBackground(backgroundId) {
      let background = firestore.get(/databases/(default)/documents/admin_backgrounds/$(backgroundId));
      return request.auth != null && (
               isAdmin() ||
               background.data.accessLevel == "public" ||
               (
                 background.data.accessLevel == "beta" && 
                 request.auth.token.email.lower() in background.data.betaUsers
               )
             );
    }

    match /users/{userId}/backgrounds/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/screenshots/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/stickers/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/display_images/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/hotspot_images/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/instructional/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/notebooks/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/pdfs/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /admin_backgrounds/{backgroundId}/{fileName} {
      allow read: if canReadAdminBackground(backgroundId);
      allow write: if isAdmin();
    }

    match /admin_weather/{allPaths=**} {
      allow get: if request.auth != null; // Authenticated users can fetch images
      allow list: if isAdmin();           // Only admins can enumerate all images
      allow write: if isAdmin();
    }

    match /admin_stickers/{fileName} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_work_symbols/{fileName} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_catalyst_icons/{allPaths=**} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /catalyst/images/{allPaths=**} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_music_thumbnails/{allPaths=**} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_logos/{fileName} {
      allow get: if true;        // Logo remains public for fetching (e.g. login screen)
      allow list: if isAdmin();   // Only admins can enumerate the logos directory
      allow write: if isAdmin();
    }

    // Global PDFs — all authenticated users can read, only admins can write
    match /global_pdfs/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Activity Wall Photos — students upload once (create only); teachers view via
    // download URLs that include an unguessable download token managed by Firebase
    // Storage (not a Firebase Auth token). These token-based URLs are not subject to
    // these rules, so <img> display works without SDK read permission.
    // SDK-level read/list is limited to the owning teacher and admins.
    match /activity_wall_photos/{sessionId}/{fileName} {
      // Owning teacher / admin can list/download via the SDK. Additionally,
      // when the session has been published as a view-only gallery
      // (`publiclyShared == true` on the parent session doc), any
      // authenticated caller — including anonymous gallery viewers — can
      // download a photo so the gallery page can render it.
      allow read: if request.auth != null &&
        (
          isAdmin() ||
          sessionId.matches(request.auth.uid + '_.*') ||
          firestore.get(
            /databases/(default)/documents/activity_wall_sessions/$(sessionId)
          ).data.get('publiclyShared', false) == true
        );
      // Any authenticated user (including anonymous students) may upload a new image,
      // but only if the target session exists in Firestore (guards against DoS uploads
      // to guessed sessionIds).
      allow create: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') &&
        firestore.exists(
          /databases/(default)/documents/activity_wall_sessions/$(sessionId)
        );
      // The owning teacher/admin may delete the temporary Firebase copy after Drive archival.
      allow delete: if request.auth != null &&
        (isAdmin() || sessionId.matches(request.auth.uid + '_.*'));
    }

    // Activity Wall media (Padlet-lite) — transit buffer only. A server-side
    // job archives each object to the teacher's Drive and deletes it here, so
    // nothing student-uploaded persists in Storage long term.
    match /activity_wall_media/{sessionId}/{submissionId}/{fileName} {
      // Single bound read of the parent session, reused by every gate below.
      function awSession() {
        return firestore.get(
          /databases/(default)/documents/activity_wall_sessions/$(sessionId)
        ).data;
      }
      // Padlet-lite marker; legacy sessions keep the pre-redesign public read.
      function awIsPadletSession() {
        return 'layout' in awSession();
      }
      // The object carries no status, so gallery reads defer to the submission
      // doc (the {submissionId} path segment is that doc's id).
      function awSubmissionApproved() {
        return firestore.exists(
            /databases/(default)/documents/activity_wall_sessions/$(sessionId)/submissions/$(submissionId)
          ) &&
          firestore.get(
            /databases/(default)/documents/activity_wall_sessions/$(sessionId)/submissions/$(submissionId)
          ).data.get('status', '') == 'approved';
      }
      // The owning teacher (uid prefix in sessionId) and admins post from the
      // widget face and are never subject to the student/guest audience gates.
      function awIsOwner() {
        return isAdmin() || sessionId.matches(request.auth.uid + '_.*');
      }
      // studentRole users always; anyone else only once the teacher opted into
      // guest posting (anonymous callers never carry the studentRole claim).
      function awCallerAllowed() {
        return awIsOwner() ||
               request.auth.token.get('studentRole', false) == true ||
               awSession().get('allowGuests', false) == true;
      }
      // Storage mirror of firestore.rules passesStudentClassGateCompat: a
      // studentRole caller must be enrolled in one of the session's classes.
      // Non-student callers (teachers, admins, anonymous guests) pass, exactly
      // as they do on the Firestore submission-create gate.
      function awStudentClassOk() {
        let sessionClassIds = awSession().get('classIds', []);
        let sessionClassId = awSession().get('classId', '');
        let claimed = request.auth.token.get('classIds', []);
        return request.auth.token.get('studentRole', false) != true ||
               (sessionClassIds is list && sessionClassIds.size() > 0
                 ? (claimed is list && sessionClassIds.hasAny(claimed))
                 : (!(sessionClassId is string) ||
                    sessionClassId.size() == 0 ||
                    (claimed is list && sessionClassId in claimed)));
      }
      function awTypeEnabled(kind) {
        return awSession().get('allowedTypes', {}).get(kind, false) == true;
      }
      // Owning teacher/admin always; a published gallery exposes only APPROVED
      // posts' media, so pending media never leaks; the uploader can also read
      // their own object (submissionId path segment matches the create rule's
      // ownership proof) before archival/publish.
      allow read: if request.auth != null &&
        (
          isAdmin() ||
          sessionId.matches(request.auth.uid + '_.*') ||
          submissionId == request.auth.uid ||
          submissionId.matches('^' + request.auth.uid + '__.*') ||
          (awSession().get('publiclyShared', false) == true &&
           (!awIsPadletSession() || awSubmissionApproved()))
        );
      // Create only (no update/overwrite). Ownership is proven by the path:
      // the submissionId segment must start with the caller's uid, which is
      // exactly what P1-5 writes (`{uid}__{n}` when capped, `{uid}__{random}`
      // otherwise) — the upload happens before the submission doc exists, so
      // a Firestore ownership lookup is not available at this point.
      // No per-student object cap here (same limitation as activity_wall_photos):
      // the Firestore submission cap is the enforcement point and the 7-day
      // sweeper reclaims orphaned objects.
      allow create: if request.auth != null &&
        (submissionId == request.auth.uid ||
         submissionId.matches('^' + request.auth.uid + '__.*')) &&
        firestore.exists(
          /databases/(default)/documents/activity_wall_sessions/$(sessionId)
        ) &&
        // The owner is exempt from the closed-wall gate so this layer agrees
        // with the Firestore teacher-create branch, which never checks it.
        (awIsOwner() || awSession().get('acceptingResponses', true) != false) &&
        awCallerAllowed() &&
        awStudentClassOk() &&
        (
          (request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic)') &&
           awTypeEnabled('photo') &&
           request.resource.size < 15 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/(mp4|webm|quicktime)') &&
           awTypeEnabled('video') &&
           request.resource.size < 200 * 1024 * 1024) ||
          (request.resource.contentType in [
             'application/pdf',
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
             'application/vnd.openxmlformats-officedocument.presentationml.presentation',
             'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
           ] &&
           awTypeEnabled('file') &&
           request.resource.size < 25 * 1024 * 1024)
        );
      // The owning teacher/admin (and the Admin SDK archive job) clean up;
      // the uploader can also delete their own object to roll back a failed
      // submission write (same ownership test as the create/read clauses).
      allow delete: if request.auth != null &&
        (isAdmin() ||
         sessionId.matches(request.auth.uid + '_.*') ||
         submissionId == request.auth.uid ||
         submissionId.matches('^' + request.auth.uid + '__.*'));
    }

    // Quiz recorded media — transit buffer only. The path segment is the
    // response key, so ownership is proven by the response doc's studentUid.
    match /quiz_response_media/{sessionId}/{responseKey}/{fileName} {
      allow read: if request.auth != null &&
        (
          isAdmin() ||
          firestore.get(
            /databases/(default)/documents/quiz_sessions/$(sessionId)/responses/$(responseKey)
          ).data.get('studentUid', '') == request.auth.uid ||
          firestore.get(
            /databases/(default)/documents/quiz_sessions/$(sessionId)
          ).data.get('teacherUid', '') == request.auth.uid
        );
      // Create only (no update): the caller must own the response doc at this key.
      allow create: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*') &&
        firestore.get(
          /databases/(default)/documents/quiz_sessions/$(sessionId)/responses/$(responseKey)
        ).data.get('studentUid', '') == request.auth.uid;
      allow delete: if request.auth != null &&
        (
          isAdmin() ||
          firestore.get(
            /databases/(default)/documents/quiz_sessions/$(sessionId)
          ).data.get('teacherUid', '') == request.auth.uid
        );
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
